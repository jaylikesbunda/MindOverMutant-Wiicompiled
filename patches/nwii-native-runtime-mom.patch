+static void NativeDrawArchive(const char *prefix, unsigned sample, GLuint program) {
+  static const bool enabled = std::getenv("NWII_DRAW_ARCHIVE") != nullptr;
+  // NATIVE_DRAW_ARCHIVE_LIMIT_V1: retain enough draws for a whole scene.
+  static const unsigned archive_max=[](){const char *e=std::getenv("NWII_EFB_PROBE_MAX");return e?std::min(300u,unsigned(std::strtoul(e,nullptr,10))):50u;}();
