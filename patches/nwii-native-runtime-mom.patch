+    if(w<=0||h<=0||w>1024||h>1024)w=h=0;
+    word(w);word(h);
+    for(GLenum param:{GL_TEXTURE_WRAP_S,GL_TEXTURE_WRAP_T,GL_TEXTURE_MIN_FILTER,GL_TEXTURE_MAG_FILTER}) {
+      GLint value=0,sampler=0;glGetIntegeri_v(GL_SAMPLER_BINDING,unit,&sampler);if(sampler)glGetSamplerParameteriv(sampler,param,&value);else if(texture)glGetTexParameteriv(GL_TEXTURE_2D,param,&value);word(value);
