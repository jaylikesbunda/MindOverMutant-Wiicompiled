+{
+AXWiiUCode::AXWiiUCode(DSPHLE* dsphle, u32 crc)
+    : AXUCode(dsphle, crc, false), m_last_main_volume(0x8000)
+{
+  
+
+  for (u16& volume : m_last_aux_volumes)
+    volume = 0x8000;
+
+  m_old_axwii = crc == 0xfa450138 || crc == 0x7699af32;
+  m_new_filter = crc == 0x347112ba || crc == 0x4cc52064;
+
+  m_accelerator = std::make_unique<HLEAccelerator>(dsphle->GetSystem().GetDSP());
+}
+
+void AXWiiUCode::HandleCommandList()
+{
+  // Temp variables for addresses computation
+  u16 addr_hi, addr_lo;
+  u16 addr2_hi, addr2_lo;
+  u16 volume;
+
+  u32 pb_addr = 0;
+
+  ValidateCommands();
+  u32 curr_idx = 0;
+  bool end = false;
+  while (!end)
+  {
+    u16 cmd = m_cmdlist[curr_idx++];
+
+    if (m_old_axwii)
+    {
+      switch (cmd)
+      {
+        // Some of these commands are unknown, or unused in this AX HLE.
+        // We still need to skip their arguments using "curr_idx += N".
+
+      case CMD_SETUP_OLD:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        SetupProcessing(HILO_TO_32(addr));
+        break;
+
+      case CMD_ADD_TO_LR_OLD:
+      case CMD_SUB_TO_LR_OLD:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        AddToLR(HILO_TO_32(addr), cmd == CMD_SUB_TO_LR_OLD);
+        break;
+
+      case CMD_ADD_SUB_TO_LR_OLD:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        AddSubToLR(HILO_TO_32(addr));
+        break;
+
+      case CMD_PB_ADDR_OLD:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        pb_addr = HILO_TO_32(addr);
+        break;
+
+      case CMD_PROCESS_OLD:
+        ProcessPBList(pb_addr);
+        break;
+
+      case CMD_MIX_AUXA_OLD:
+      case CMD_MIX_AUXB_OLD:
+      case CMD_MIX_AUXC_OLD:
+        volume = m_cmdlist[curr_idx++];
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        addr2_hi = m_cmdlist[curr_idx++];
+        addr2_lo = m_cmdlist[curr_idx++];
+        MixAUXSamples(cmd - CMD_MIX_AUXA_OLD, HILO_TO_32(addr), HILO_TO_32(addr2), volume);
+        break;
+
+      case CMD_UPL_AUXA_MIX_LRSC_OLD:
+      case CMD_UPL_AUXB_MIX_LRSC_OLD:
+      {
+        volume = m_cmdlist[curr_idx++];
+        u32 addresses[6] = {
+            (u32)(m_cmdlist[curr_idx + 0] << 16) | m_cmdlist[curr_idx + 1],
+            (u32)(m_cmdlist[curr_idx + 2] << 16) | m_cmdlist[curr_idx + 3],
+            (u32)(m_cmdlist[curr_idx + 4] << 16) | m_cmdlist[curr_idx + 5],
+            (u32)(m_cmdlist[curr_idx + 6] << 16) | m_cmdlist[curr_idx + 7],
+            (u32)(m_cmdlist[curr_idx + 8] << 16) | m_cmdlist[curr_idx + 9],
+            (u32)(m_cmdlist[curr_idx + 10] << 16) | m_cmdlist[curr_idx + 11],
+        };
+        curr_idx += 12;
+        UploadAUXMixLRSC(cmd == CMD_UPL_AUXB_MIX_LRSC_OLD, addresses, volume);
+        break;
+      }
+
+      case CMD_COMPRESSOR_OLD:
+      {
+        u16 threshold = m_cmdlist[curr_idx++];
+        u16 frames = m_cmdlist[curr_idx++];
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        RunCompressor(threshold, frames, HILO_TO_32(addr), 3);
+        break;
+      }
+
+      case CMD_OUTPUT_OLD:
+      case CMD_OUTPUT_DPL2_OLD:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        addr2_hi = m_cmdlist[curr_idx++];
+        addr2_lo = m_cmdlist[curr_idx++];
+        OutputSamples(HILO_TO_32(addr2), HILO_TO_32(addr), 0x8000, cmd == CMD_OUTPUT_DPL2_OLD);
+        break;
+
+      case CMD_WM_OUTPUT_OLD:
+      {
+        u32 addresses[4] = {
+            (u32)(m_cmdlist[curr_idx + 0] << 16) | m_cmdlist[curr_idx + 1],
+            (u32)(m_cmdlist[curr_idx + 2] << 16) | m_cmdlist[curr_idx + 3],
+            (u32)(m_cmdlist[curr_idx + 4] << 16) | m_cmdlist[curr_idx + 5],
+            (u32)(m_cmdlist[curr_idx + 6] << 16) | m_cmdlist[curr_idx + 7],
+        };
+        curr_idx += 8;
+        OutputWMSamples(addresses);
+        break;
+      }
+
+      case CMD_END_OLD:
+        end = true;
+        break;
+      }
+    }
+    else
+    {
+      switch (cmd)
+      {
+        // Some of these commands are unknown, or unused in this AX HLE.
+        // We still need to skip their arguments using "curr_idx += N".
+
+      case CMD_SETUP:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        SetupProcessing(HILO_TO_32(addr));
+        break;
+
+      case CMD_ADD_TO_LR:
+      case CMD_SUB_TO_LR:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        AddToLR(HILO_TO_32(addr), cmd == CMD_SUB_TO_LR);
+        break;
+
+      case CMD_ADD_SUB_TO_LR:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        AddSubToLR(HILO_TO_32(addr));
+        break;
+
+      case CMD_PROCESS:
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        ProcessPBList(HILO_TO_32(addr));
+        break;
+
+      case CMD_MIX_AUXA:
+      case CMD_MIX_AUXB:
+      case CMD_MIX_AUXC:
+        volume = m_cmdlist[curr_idx++];
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        addr2_hi = m_cmdlist[curr_idx++];
+        addr2_lo = m_cmdlist[curr_idx++];
+        MixAUXSamples(cmd - CMD_MIX_AUXA, HILO_TO_32(addr), HILO_TO_32(addr2), volume);
+        break;
+
+      case CMD_UPL_AUXA_MIX_LRSC:
+      case CMD_UPL_AUXB_MIX_LRSC:
+      {
+        volume = m_cmdlist[curr_idx++];
+        u32 addresses[6] = {
+            (u32)(m_cmdlist[curr_idx + 0] << 16) | m_cmdlist[curr_idx + 1],
+            (u32)(m_cmdlist[curr_idx + 2] << 16) | m_cmdlist[curr_idx + 3],
+            (u32)(m_cmdlist[curr_idx + 4] << 16) | m_cmdlist[curr_idx + 5],
+            (u32)(m_cmdlist[curr_idx + 6] << 16) | m_cmdlist[curr_idx + 7],
+            (u32)(m_cmdlist[curr_idx + 8] << 16) | m_cmdlist[curr_idx + 9],
+            (u32)(m_cmdlist[curr_idx + 10] << 16) | m_cmdlist[curr_idx + 11],
+        };
+        curr_idx += 12;
+        UploadAUXMixLRSC(cmd == CMD_UPL_AUXB_MIX_LRSC, addresses, volume);
+        break;
+      }
+
+      case CMD_COMPRESSOR:
+      {
+        u16 threshold = m_cmdlist[curr_idx++];
+        u16 frames = m_cmdlist[curr_idx++];
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        RunCompressor(threshold, frames, HILO_TO_32(addr), 3);
+        break;
+      }
+
+      case CMD_OUTPUT:
+      case CMD_OUTPUT_DPL2:
+        volume = m_crc == 0xd9c4bf34 ? 0x8000 : m_cmdlist[curr_idx++];
+        addr_hi = m_cmdlist[curr_idx++];
+        addr_lo = m_cmdlist[curr_idx++];
+        addr2_hi = m_cmdlist[curr_idx++];
+        addr2_lo = m_cmdlist[curr_idx++];
+        OutputSamples(HILO_TO_32(addr2), HILO_TO_32(addr), volume, cmd == CMD_OUTPUT_DPL2);
+        break;
+
+      case CMD_WM_OUTPUT:
+      {
+        u32 addresses[4] = {
+            (u32)(m_cmdlist[curr_idx + 0] << 16) | m_cmdlist[curr_idx + 1],
+            (u32)(m_cmdlist[curr_idx + 2] << 16) | m_cmdlist[curr_idx + 3],
+            (u32)(m_cmdlist[curr_idx + 4] << 16) | m_cmdlist[curr_idx + 5],
+            (u32)(m_cmdlist[curr_idx + 6] << 16) | m_cmdlist[curr_idx + 7],
+        };
+        curr_idx += 8;
+        OutputWMSamples(addresses);
+        break;
+      }
+
+      case CMD_END:
+        end = true;
+        break;
+      }
+    }
+  }
+}
+
+void AXWiiUCode::SetupProcessing(u32 init_addr)
+{
+  const std::array<BufferDesc, 20> buffers = {{
+      {m_samples_main_left, 32}, {m_samples_main_right, 32}, {m_samples_main_surround, 32},
+      {m_samples_auxA_left, 32}, {m_samples_auxA_right, 32}, {m_samples_auxA_surround, 32},
+      {m_samples_auxB_left, 32}, {m_samples_auxB_right, 32}, {m_samples_auxB_surround, 32},
+      {m_samples_auxC_left, 32}, {m_samples_auxC_right, 32}, {m_samples_auxC_surround, 32},
+
+      {m_samples_wm0, 6},        {m_samples_aux0, 6},        {m_samples_wm1, 6},
+      {m_samples_aux1, 6},       {m_samples_wm2, 6},         {m_samples_aux2, 6},
+      {m_samples_wm3, 6},        {m_samples_aux3, 6},
+  }};
+  InitMixingBuffers<3 /*ms*/>(init_addr, buffers);
+}
+
+void AXWiiUCode::AddToLR(u32 val_addr, bool neg)
+{
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  int* ptr = reinterpret_cast<int*>(memory.GetPointerForRange(val_addr, 32 * 3 * sizeof(int)));
+  for (int i = 0; i < 32 * 3; ++i)
+  {
+    int val = (int)Common::swap32(*ptr++);
+    if (neg)
+      val = -val;
+
+    m_samples_main_left[i] += val;
+    m_samples_main_right[i] += val;
+  }
+}
+
+void AXWiiUCode::AddSubToLR(u32 val_addr)
+{
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  int* ptr = reinterpret_cast<int*>(memory.GetPointerForRange(val_addr, 2 * 32 * 3 * sizeof(int)));
+  for (int i = 0; i < 32 * 3; ++i)
+  {
+    int val = (int)Common::swap32(*ptr++);
+    m_samples_main_left[i] += val;
+  }
+  for (int i = 0; i < 32 * 3; ++i)
+  {
+    int val = (int)Common::swap32(*ptr++);
+    m_samples_main_right[i] -= val;
+  }
+}
+
+AXMixControl AXWiiUCode::ConvertMixerControl(u32 mixer_control)
+{
+  u32 ret = 0;
+
+  if (mixer_control & 0x00000001)
+    ret |= MIX_MAIN_L;
+  if (mixer_control & 0x00000002)
+    ret |= MIX_MAIN_R;
+  if (mixer_control & 0x00000004)
+    ret |= MIX_MAIN_L | MIX_MAIN_R | MIX_MAIN_L_RAMP | MIX_MAIN_R_RAMP;
+  if (mixer_control & 0x00000008)
+    ret |= MIX_MAIN_S;
+  if (mixer_control & 0x00000010)
+    ret |= MIX_MAIN_S | MIX_MAIN_S_RAMP;
+  if (mixer_control & 0x00010000)
+    ret |= MIX_AUXA_L;
+  if (mixer_control & 0x00020000)
+    ret |= MIX_AUXA_R;
+  if (mixer_control & 0x00040000)
+    ret |= MIX_AUXA_L | MIX_AUXA_R | MIX_AUXA_L_RAMP | MIX_AUXA_R_RAMP;
+  if (mixer_control & 0x00080000)
+    ret |= MIX_AUXA_S;
+  if (mixer_control & 0x00100000)
+    ret |= MIX_AUXA_S | MIX_AUXA_S_RAMP;
+  if (mixer_control & 0x00200000)
+    ret |= MIX_AUXB_L;
+  if (mixer_control & 0x00400000)
+    ret |= MIX_AUXB_R;
+  if (mixer_control & 0x00800000)
+    ret |= MIX_AUXB_L | MIX_AUXB_R | MIX_AUXB_L_RAMP | MIX_AUXB_R_RAMP;
+  if (mixer_control & 0x01000000)
+    ret |= MIX_AUXB_S;
+  if (mixer_control & 0x02000000)
+    ret |= MIX_AUXB_S | MIX_AUXB_S_RAMP;
+  if (mixer_control & 0x04000000)
+    ret |= MIX_AUXC_L;
+  if (mixer_control & 0x08000000)
+    ret |= MIX_AUXC_R;
+  if (mixer_control & 0x10000000)
+    ret |= MIX_AUXC_L | MIX_AUXC_R | MIX_AUXC_L_RAMP | MIX_AUXC_R_RAMP;
+  if (mixer_control & 0x20000000)
+    ret |= MIX_AUXC_S;
+  if (mixer_control & 0x40000000)
+    ret |= MIX_AUXC_S | MIX_AUXC_S_RAMP;
+
+  return (AXMixControl)ret;
+}
+
+void AXWiiUCode::GenerateVolumeRamp(u16* output, u16 vol1, u16 vol2, size_t nvals)
+{
+  float curr = vol1;
+  for (size_t i = 0; i < nvals; ++i)
+  {
+    curr += (vol2 - vol1) / (float)nvals;
+    output[i] = (u16)curr;
+  }
+}
+
+void AXWiiUCode::ReadPB(Memory::MemoryManager& memory, u32 addr, AXPBWii& pb)
+{
+  // The Wii PB memory layout changed twice.
+  // For HLE, we use the largest struct version.
+  char* dst = (char*)&pb;
+  constexpr size_t updates_begin = offsetof(AXPBWii, updates);
+  constexpr size_t updates_end = offsetof(AXPBWii, updates) + sizeof(PBUpdatesWii);
+  constexpr size_t gap_begin = offsetof(AXPBWii, hpf) + sizeof(PBHighPassFilter);
+  constexpr size_t gap_end = offsetof(AXPBWii, biquad) + sizeof(PBBiquadFilter);
+  switch (m_crc)
+  {
+  case 0x7699af32:
+  case 0xfa450138:
+    // The hpf field is a bit smaller than the biquad. Skip the difference.
+    memory.CopyFromEmuSwapped<u16>((u16*)dst, addr, gap_begin);
+    memset(dst + gap_begin, 0, gap_end - gap_begin);
+    memory.CopyFromEmuSwapped<u16>((u16*)(dst + gap_end), addr + gap_begin, sizeof(pb) - gap_end);
+    break;
+  case 0xd9c4bf34:
+  case 0xadbc06bd:
+    // Skip updates field and skip gap after hpf.
+    memory.CopyFromEmuSwapped<u16>((u16*)dst, addr, updates_begin);
+    memset(dst + updates_begin, 0, sizeof(PBUpdatesWii));
+    memory.CopyFromEmuSwapped<u16>((u16*)(dst + updates_end), addr + updates_begin,
+                                   gap_begin - updates_end);
+    memset(dst + gap_begin, 0, gap_end - gap_begin);
+    memory.CopyFromEmuSwapped<u16>((u16*)(dst + gap_end), addr + gap_begin, sizeof(pb) - gap_end);
+    break;
+  case 0x347112ba:
+  case 0x4cc52064:
+    // Just skip updates field.
+    memory.CopyFromEmuSwapped<u16>((u16*)dst, addr, updates_begin);
+    memset(dst + updates_begin, 0, sizeof(PBUpdatesWii));
+    memory.CopyFromEmuSwapped<u16>((u16*)(dst + updates_end), addr + updates_begin,
+                                   sizeof(pb) - updates_end);
+    break;
+  }
+}
+
+void AXWiiUCode::WritePB(Memory::MemoryManager& memory, u32 addr, const AXPBWii& pb)
+{
+  const char* src = (const char*)&pb;
+  constexpr size_t updates_begin = offsetof(AXPBWii, updates);
+  constexpr size_t updates_end = offsetof(AXPBWii, updates) + sizeof(PBUpdatesWii);
+  constexpr size_t gap_begin = offsetof(AXPBWii, hpf) + sizeof(PBHighPassFilter);
+  constexpr size_t gap_end = offsetof(AXPBWii, biquad) + sizeof(PBBiquadFilter);
+  switch (m_crc)
+  {
+  case 0x7699af32:
+  case 0xfa450138:
+    memory.CopyToEmuSwapped<u16>(addr, (const u16*)src, gap_begin);
+    memory.CopyToEmuSwapped<u16>(addr + gap_begin, (const u16*)(src + gap_end),
+                                 sizeof(pb) - gap_end);
+    break;
+  case 0xd9c4bf34:
+  case 0xadbc06bd:
+    memory.CopyToEmuSwapped<u16>(addr, (const u16*)src, updates_begin);
+    memory.CopyToEmuSwapped<u16>(addr + updates_begin, (const u16*)(src + updates_end),
+                                 gap_begin - updates_end);
+    memory.CopyToEmuSwapped<u16>(addr + gap_begin, (const u16*)(src + gap_end),
+                                 sizeof(pb) - gap_end);
+    break;
+  case 0x347112ba:
+  case 0x4cc52064:
+    memory.CopyToEmuSwapped<u16>(addr, (const u16*)src, updates_begin);
+    memory.CopyToEmuSwapped<u16>(addr + updates_begin, (const u16*)(src + updates_end),
+                                 sizeof(pb) - updates_end);
+    break;
+  }
+}
+
+void AXWiiUCode::ProcessPBList(u32 pb_addr)
+{
+  // Samples per millisecond. In theory DSP sampling rate can be changed from
+  // 32KHz to 48KHz, but AX always process at 32KHz.
+  constexpr u32 spms = 32;
+
+  AXPBWii pb;
+
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  std::unordered_set<u32> visited;
+  while (pb_addr)
+  {
+    AXBuffers buffers = {{m_samples_main_left, m_samples_main_right, m_samples_main_surround,
+                          m_samples_auxA_left, m_samples_auxA_right, m_samples_auxA_surround,
+                          m_samples_auxB_left, m_samples_auxB_right, m_samples_auxB_surround,
+                          m_samples_auxC_left, m_samples_auxC_right, m_samples_auxC_surround,
+                          m_samples_wm0,       m_samples_aux0,       m_samples_wm1,
+                          m_samples_aux1,      m_samples_wm2,        m_samples_aux2,
+                          m_samples_wm3,       m_samples_aux3}};
+
+    if (!visited.insert(pb_addr).second || visited.size()>1024) throw std::runtime_error("cyclic/oversized AX voice list");
+    ReadPB(memory, pb_addr, pb);
+
+    if (m_old_axwii &&
+        (pb.updates.num_updates[0] | pb.updates.num_updates[1] | pb.updates.num_updates[2]))
+    {
+      PBUpdateData updates = LoadPBUpdates(memory, pb);
+      for (int curr_ms = 0; curr_ms < 3; ++curr_ms)
+      {
+        ApplyUpdatesForMs(curr_ms, pb, pb.updates.num_updates, updates);
+        ProcessVoice(static_cast<HLEAccelerator*>(m_accelerator.get()), pb, buffers, spms,
+                     ConvertMixerControl(HILO_TO_32(pb.mixer_control)),
+                     m_coeffs_checksum ? m_coeffs.data() : nullptr, m_new_filter);
+
+        // Forward the buffers
+        for (auto& ptr : buffers.regular_ptrs)
+          ptr += spms;
+        for (auto& ptr : buffers.wiimote_ptrs)
+          ptr += 6;
+      }
+    }
+    else
+    {
+      ProcessVoice(static_cast<HLEAccelerator*>(m_accelerator.get()), pb, buffers, 96,
+                   ConvertMixerControl(HILO_TO_32(pb.mixer_control)),
+                   m_coeffs_checksum ? m_coeffs.data() : nullptr, m_new_filter);
+    }
+
+    WritePB(memory, pb_addr, pb);
+    pb_addr = HILO_TO_32(pb.next_pb);
+  }
+}
+
+void AXWiiUCode::MixAUXSamples(int aux_id, u32 write_addr, u32 read_addr, u16 volume)
+{
+  std::array<u16, 96> volume_ramp;
+  GenerateVolumeRamp(volume_ramp.data(), m_last_aux_volumes[aux_id], volume, volume_ramp.size());
+  m_last_aux_volumes[aux_id] = volume;
+
+  std::array<int*, 3> main_buffers{
+      m_samples_main_left,
+      m_samples_main_right,
+      m_samples_main_surround,
+  };
+
+  std::array<const int*, 3> buffers{};
+  switch (aux_id)
+  {
+  case 0:
+    buffers = {
+        m_samples_auxA_left,
+        m_samples_auxA_right,
+        m_samples_auxA_surround,
+    };
+    break;
+
+  case 1:
+    buffers = {
+        m_samples_auxB_left,
+        m_samples_auxB_right,
+        m_samples_auxB_surround,
+    };
+    break;
+
+  case 2:
+    buffers = {
+        m_samples_auxC_left,
+        m_samples_auxC_right,
+        m_samples_auxC_surround,
+    };
+    break;
+  }
+
+  // Send the content of AUX buffers to the CPU
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  if (write_addr)
+  {
+    for (const auto& buffer : buffers)
+    {
+      memory.CopyToEmuSwapped(write_addr, buffer, 3 * 32 * sizeof(int));
+      write_addr += 3 * 32 * sizeof(int);
+    }
+  }
+
+  // Then read the buffers from the CPU and add to our main buffers.
+  const int* ptr = reinterpret_cast<int*>(
+      memory.GetPointerForRange(read_addr, main_buffers.size() * 3 * 32 * sizeof(int)));
+  for (auto& main_buffer : main_buffers)
+  {
+    for (u32 j = 0; j < 3 * 32; ++j)
+    {
+      s64 sample = (s64)(s32)Common::swap32(*ptr++);
+      sample *= volume_ramp[j];
+      main_buffer[j] += (s32)(sample >> 15);
+    }
+  }
+}
+
+void AXWiiUCode::UploadAUXMixLRSC(int aux_id, u32* addresses, u16 volume)
+{
+  int* aux_left = aux_id ? m_samples_auxB_left : m_samples_auxA_left;
+  int* aux_right = aux_id ? m_samples_auxB_right : m_samples_auxA_right;
+  int* aux_surround = aux_id ? m_samples_auxB_surround : m_samples_auxA_surround;
+  int* auxc_buffer = aux_id ? m_samples_auxC_surround : m_samples_auxC_right;
+
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  memory.CopyToEmuSwapped(addresses[0], aux_left, 96 * sizeof(int));
+  memory.CopyToEmuSwapped(addresses[0] + 96 * sizeof(int), aux_right, 96 * sizeof(int));
+  memory.CopyToEmuSwapped(addresses[0] + 2 * 96 * sizeof(int), aux_surround, 96 * sizeof(int));
+
+  memory.CopyToEmuSwapped(addresses[1], auxc_buffer, 96 * sizeof(int));
+
+  u16 volume_ramp[96];
+  GenerateVolumeRamp(volume_ramp, m_last_aux_volumes[aux_id], volume, 96);
+  m_last_aux_volumes[aux_id] = volume;
+
+  int* mix_dest[4] = {m_samples_main_left, m_samples_main_right, m_samples_main_surround,
+                      m_samples_auxC_left};
+  for (u32 mix_i = 0; mix_i < 4; ++mix_i)
+  {
+    memory.CopyFromEmuSwapped(aux_left, addresses[2 + mix_i], 96 * sizeof(int));
+
+    for (u32 i = 0; i < 96; ++i)
+    {
+      s64 sample = (s64)(s32)aux_left[i];
+      sample *= volume_ramp[i];
+      mix_dest[mix_i][i] += (s32)(sample >> 15);
+    }
+  }
+}
+
+void AXWiiUCode::OutputSamples(u32 lr_addr, u32 surround_addr, u16 volume, bool upload_auxc)
+{
+  std::array<u16, 96> volume_ramp;
+  GenerateVolumeRamp(volume_ramp.data(), m_last_main_volume, volume, volume_ramp.size());
+  m_last_main_volume = volume;
+
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  memory.CopyToEmuSwapped(surround_addr, m_samples_main_surround, 3 * 32 * sizeof(int));
+
+  if (upload_auxc)
+  {
+    memory.CopyToEmuSwapped(surround_addr + 3 * 32 * sizeof(int), m_samples_auxC_left,
+                            3 * 32 * sizeof(int));
+  }
+
+  // Clamp internal buffers to 16 bits.
+  for (size_t i = 0; i < volume_ramp.size(); ++i)
+  {
+    // Cast to s64 to avoid overflow.
+    s64 left = m_samples_main_left[i];
+    s64 right = m_samples_main_right[i];
+
+    // Apply global volume.
+    left = (left * volume_ramp[i]) >> 15;
+    right = (right * volume_ramp[i]) >> 15;
+
+    m_samples_main_left[i] = ClampS16(left);
+    m_samples_main_right[i] = ClampS16(right);
+  }
+
+  std::array<s16, 3 * 32 * 2> buffer;
+  for (size_t i = 0; i < 3 * 32; ++i)
+  {
+    buffer[2 * i] = Common::swap16(m_samples_main_right[i]);
+    buffer[2 * i + 1] = Common::swap16(m_samples_main_left[i]);
+  }
+
+  memory.CopyToEmu(lr_addr, buffer.data(), sizeof(buffer));
+  m_mail_handler.PushMail(DSP_SYNC, true);
+}
+
+void AXWiiUCode::OutputWMSamples(u32* addresses)
+{
+  int* buffers[] = {m_samples_wm0, m_samples_wm1, m_samples_wm2, m_samples_wm3};
+
+  auto& memory = m_dsphle->GetSystem().GetMemory();
+  for (u32 i = 0; i < 4; ++i)
+  {
+    int* in = buffers[i];
+    u16* out = reinterpret_cast<u16*>(memory.GetPointerForRange(addresses[i], 3 * 6 * sizeof(s16)));
+    for (u32 j = 0; j < 3 * 6; ++j)
+    {
+      s16 sample = ClampS16(in[j]);
+      out[j] = Common::swap16((u16)sample);
+    }
+  }
+}
+
+} // namespace DSP::HLE
diff --git a/nWiiRuntime/include/runtime/native_event_mask.h b/nWiiRuntime/include/runtime/native_event_mask.h
new file mode 100644
index 0000000..f147dcd
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_event_mask.h
@@ -0,0 +1,71 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+// NATIVE_EVENT_MASK_V1: one cache line that says "some producer may have made a
+// callback / interrupt due since the last real poll".
+//
+// The poll fast path used to read five independent producer locations on every
+// real poll (g_ipc_interrupt_delay, hw::g_di_interrupt_delay, ctx.vblank_pending,
+// hw::pi_intsr, hw::pi_intmr). The mask replaces the three that are cross-thread
+// atomics with a single word, read once per call.
+//
+// Producer -> bit table (every producer that can make a poll non-trivial):
+//
+//  bit                 producer                                          raiser / lowerer
+//  ------------------  ------------------------------------------------  ------------------------------------------
+//  kIpcDelay   (0)     hw_ipc.cpp arms g_ipc_interrupt_delay              raise on arm; ios.cpp poll lowers at 0
+//  kVBlank     (2)     host VI thread (main.cpp) and the EventScheduler  raise where vblank_pending is set;
+//                      VI callback (ios.cpp) set ctx.vblank_pending       ios.cpp poll lowers when it consumes it
+//  kPiIrq      (3)     trigger_pi_interrupt (VI/PE/DSP/AI/DI/IPC) and    raise on an unmasked 0->1 transition of
+//                      the PI INTMR writer                              pi_intsr / on an INTMR enable; lowered by
+//                                                                        the poll once (pi_intsr & pi_intmr) == 0
+//
+// Producers that deliberately do NOT get a bit, because the poll already reads
+// the exact value at the point where it decides:
+//
+//  hw::g_di_interrupt_delay  has no arming site in the runtime (only the zero
+//                        initializer and the di_tick() countdown exist), so the
+//                        fast path keeps its exact `== 0` test on the plain int
+//                        instead of a bit that nothing raises.
+//  queue_callback        pending_cb_count is re-read in the fast path: it is the
+//                        dispatch decision itself, and a queued callback is not a
+//                        "maybe" event. queue_callback already raises the
+//                        native_idle::attention latch through notify().
+//  DEC expiry            ctx.dec_expired() is only evaluated when the 16-poll
+//                        clock throttle says `due`, which already forces the
+//                        slow path; the mask cannot widen that cadence.
+//  EventScheduler        advanced only when `due`, same argument.
+//  GX staged bytes       read only on the idle PC (0x803BBFA0), where the value
+//                        itself is required; it is not a callback source.
+//  WPAD phase            native_wpad_poll runs on the fast path itself.
+//  native_idle::notify   keeps its own attention latch (native_idle::attention),
+//                        which native_poll_due() already tests at every site.
+//
+// Ordering: a producer raises its bit with release ordering *after* publishing
+// the value the poll reads, and the poll loads the mask with acquire ordering
+// before it looks at anything else. So "mask & kSlowMask == 0" observed by the
+// poll means the three conditions were false as of the mask load.
+//
+// A raise that races a lower can be lost (the same bounded-delay property the
+// existing native_idle::attention latch already relies on): the credit
+// countdown in native_poll_due() re-runs the slow path within NWII_POLL_CREDIT
+// poll points, and the slow path re-derives every condition from the raw
+// registers. The IPC rule is not affected by that bound: kIpcDelay stays set for
+// the whole countdown, so a poll runs at every site while a delay is armed.
+namespace nwii::runtime::native_events {
+
+enum : uint32_t {
+  kIpcDelay = 1u << 0,
+  kVBlank   = 1u << 2,
+  kPiIrq    = 1u << 3,
+  // The bits that gate the poll fast path.
+  kSlowMask = kIpcDelay | kVBlank | kPiIrq,
+};
+
+inline std::atomic<uint32_t> mask{0};
+
+inline void raise(uint32_t bits) { mask.fetch_or(bits, std::memory_order_release); }
+inline void lower(uint32_t bits) { mask.fetch_and(~bits, std::memory_order_release); }
+inline bool any(uint32_t bits) { return (mask.load(std::memory_order_relaxed) & bits) != 0; }
+
+} // namespace nwii::runtime::native_events
diff --git a/nWiiRuntime/include/runtime/native_fifo_lock.h b/nWiiRuntime/include/runtime/native_fifo_lock.h
new file mode 100644
index 0000000..4cb60cb
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_fifo_lock.h
@@ -0,0 +1,34 @@
+#pragma once
+// NATIVE_FIFO_SRWLOCK_V1: the FIFO publish/drain mutex is taken ~6000 times per
+// frame on the guest thread. MinGW std::mutex is winpthreads, whose lock/unlock
+// walk the pthread self/TLS path; an SRW lock is a single cmpxchg. Same
+// non-recursive, blocking semantics. This mutex is not paired with any condition
+// variable (the drain/wake condvars use g_gx_drain_mutex), so it is safe to swap.
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <mutex>
+#endif
+namespace nwii::runtime {
+struct NativeFifoLock {
+#ifdef _WIN32
+  SRWLOCK lock = SRWLOCK_INIT;
+  void acquire() { ::AcquireSRWLockExclusive(&lock); }
+  void release() { ::ReleaseSRWLockExclusive(&lock); }
+#else
+  std::mutex lock;
+  void acquire() { lock.lock(); }
+  void release() { lock.unlock(); }
+#endif
+};
+struct NativeFifoLockGuard {
+  NativeFifoLock& l;
+  explicit NativeFifoLockGuard(NativeFifoLock& x) : l(x) { l.acquire(); }
+  ~NativeFifoLockGuard() { l.release(); }
+  NativeFifoLockGuard(const NativeFifoLockGuard&) = delete;
+  NativeFifoLockGuard& operator=(const NativeFifoLockGuard&) = delete;
+};
+} // namespace nwii::runtime
diff --git a/nWiiRuntime/include/runtime/native_frame_limit.h b/nWiiRuntime/include/runtime/native_frame_limit.h
new file mode 100644
index 0000000..eff6281
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_frame_limit.h
@@ -0,0 +1,27 @@
+#pragma once
+// ' + MARK + ': a custom frame-rate cap shared by the host pacing and the
+// guest VI period. No dependency on the developer HUD.
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+
+namespace native_frame_limit {
+
+// The regional field period: 20 ms PAL, 16.683 ms NTSC, scaled by turbo.
+inline std::chrono::nanoseconds Period(bool pal, double turbo, const char* custom) {
+    const int64_t regional = int64_t((pal ? 20000000 : 16683333) / turbo);
+    if (!custom || !*custom) return std::chrono::nanoseconds(regional);
+    char* end = nullptr;
+    const double fps = std::strtod(custom, &end);
+    if (end == custom || *end || !std::isfinite(fps) || fps < 10 || fps > 1000)
+        return std::chrono::nanoseconds(regional);
+    return std::chrono::nanoseconds(int64_t(std::llround(1000000000.0 / fps)));
+}
+
+// The same cap expressed in guest timebase ticks.
+inline uint64_t GuestPeriodTicks(bool pal, uint64_t frequency, const char* custom) {
+    return uint64_t(std::llround(frequency * (Period(pal, 1.0, custom).count() / 1000000000.0)));
+}
+
+} // namespace native_frame_limit
diff --git a/nWiiRuntime/include/runtime/native_guest_bytes.h b/nWiiRuntime/include/runtime/native_guest_bytes.h
new file mode 100644
index 0000000..f731f98
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_guest_bytes.h
@@ -0,0 +1,86 @@
+#pragma once
+#include "runtime/cpu_context.h"
+#include <algorithm>
+#include <vector>
+#include <new>
+#include <cstring>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+// NATIVE_MOM_ADAPT_A3: MoM's replacement for CotT's native_guest_bytes.h.
+// CotT's version needs MMU::kMem1Limit / kMem2Limit and
+// native_watch_span_may_hit, which only exist after CotT's
+// fix_mmu_constant_limits and fix_watch_span_guards stages. Neither applies
+// to MoM, so the RAM extents are taken from the live vectors instead:
+// MEM1 = 24 MiB + 8, MEM2 = 64 MiB + 8.
+namespace native_guest_bytes {
+using nwii::runtime::MMU;
+inline bool Enabled() {
+  static const bool enabled = std::getenv("NWII_NO_IOS_BULK_TRANSFER") == nullptr;
+  return enabled;
+}
+inline uint8_t* OrdinarySpan(MMU& memory, uint32_t address, uint32_t bytes) {
+  if (!Enabled() || !bytes) return nullptr;
+  if (nwii::runtime::g_watch_addr) return nullptr;
+  const uint32_t physical = address & 0x3fffffffu;
+  const size_t mem1_limit = memory.mem1.size() - 8;
+  if (physical < mem1_limit && bytes <= mem1_limit - physical)
+    return memory.mem1.data() + physical;
+  if (physical >= 0x10000000u) {
+    const uint32_t offset = physical - 0x10000000u;
+    const size_t mem2_limit = memory.mem2.size() - 8;
+    if (offset < mem2_limit && bytes <= mem2_limit - offset)
+      return memory.mem2.data() + offset;
+  }
+  return nullptr;
+}
+inline void Copy(MMU& memory, uint32_t address, const uint8_t* bytes, uint32_t count) {
+  if (auto* target = OrdinarySpan(memory, address, count)) {
+    std::memcpy(target, bytes, count); return;
+  }
+  for (uint32_t i = 0; i < count; ++i) memory.write8(address + i, bytes[i]);
+}
+inline void Zero(MMU& memory, uint32_t address, uint32_t count) {
+  if (auto* target = OrdinarySpan(memory, address, count)) {
+    std::memset(target, 0, count); return;
+  }
+  for (uint32_t i = 0; i < count; ++i) memory.write8(address + i, 0);
+}
+struct ScratchState { std::vector<uint8_t> bytes; bool busy = false; };
+#ifdef _WIN32
+inline void NTAPI ReleaseScratch(void* pointer) { delete static_cast<ScratchState*>(pointer); }
+inline ScratchState* LocalScratch() {
+  static const DWORD index = FlsAlloc(ReleaseScratch);
+  if (index == FLS_OUT_OF_INDEXES) return nullptr;
+  if (auto* state = static_cast<ScratchState*>(FlsGetValue(index))) return state;
+  auto* state = new (std::nothrow) ScratchState;
+  if (!state) return nullptr;
+  if (!FlsSetValue(index, state)) { delete state; return nullptr; }
+  return state;
+}
+#else
+inline ScratchState* LocalScratch() { static thread_local ScratchState state; return &state; }
+#endif
+class ReadBuffer {
+  std::vector<uint8_t> local;
+  ScratchState* owner = nullptr;
+  std::vector<uint8_t>* buffer = &local;
+public:
+  explicit ReadBuffer(uint32_t count) {
+    if (count && Enabled() && count <= 8u * 1024u * 1024u) {
+      if (auto* state = LocalScratch(); state && !state->busy) { owner = state; buffer = &state->bytes; }
+    }
+    const size_t dirty = std::min<size_t>(buffer->size(), count);
+    buffer->resize(count);
+    std::fill(buffer->begin(), buffer->begin() + dirty, uint8_t(0));
+    if (owner) owner->busy = true;
+  }
+  ~ReadBuffer() { if (owner) owner->busy = false; }
+  ReadBuffer(const ReadBuffer&) = delete;
+  ReadBuffer& operator=(const ReadBuffer&) = delete;
+  uint8_t* data() { return buffer->data(); }
+};
+}
diff --git a/nWiiRuntime/include/runtime/native_idle_wait.h b/nWiiRuntime/include/runtime/native_idle_wait.h
new file mode 100644
index 0000000..211112b
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_idle_wait.h
@@ -0,0 +1,83 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <algorithm>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+// NATIVE_IDLE_WAIT_MOM_V1
+// MoM's variant of the CotT idle-wait overlay. The CotT original pulls in
+// runtime/native_hud.h, which needs runtime/native_perf_census.h; that census
+// belongs to CotT's developer overlay and has no MoM counterpart, so the wait
+// primitive is kept self-contained here. The behaviour is the same: the guest
+// thread owns its timer, producers only signal the wake event, and no guest
+// register, RAM, instruction count or virtual clock is advanced while parked.
+namespace nwii::runtime::native_idle {
+inline thread_local uint64_t waits = 0;
+// Producer attention latch: a raised interrupt or a queued callback sets it.
+inline std::atomic<uint32_t> attention{0};
+
+// Upper bound on one park: 250 us. That also bounds a source that forgot to
+// signal, so a lost notification can never stall the guest.
+inline uint64_t budget_ticks(uint64_t now, uint64_t next, bool dec_pending,
+                             uint64_t dec_origin, uint64_t dec_value, uint64_t freq) {
+  uint64_t ticks = freq / 4000;
+  if (!ticks) return 0;
+  if (next <= now) return 0;
+  ticks = std::min(ticks, next - now);
+  if (dec_pending) {
+    const uint64_t elapsed = now - dec_origin;
+    if (elapsed >= dec_value) return 0;
+    ticks = std::min(ticks, dec_value - elapsed);
+  }
+  return ticks;
+}
+
+#ifdef _WIN32
+struct Wake {
+  HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  ~Wake() { if (event) CloseHandle(event); }
+};
+inline Wake& wake() { static Wake s; return s; }
+inline void notify() {
+  attention.store(1, std::memory_order_relaxed);
+  if (wake().event) SetEvent(wake().event);
+}
+struct Timer {
+  HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, 0x2, TIMER_ALL_ACCESS);
+  ~Timer() { if (timer) CloseHandle(timer); }
+};
+template <class Pending>
+inline bool wait(uint64_t ticks, uint64_t freq, Pending pending) {
+  if (!ticks || !freq || pending()) return false;
+  static thread_local Timer t;
+  auto& w = wake();
+  if (!t.timer || !w.event) return false;
+  LARGE_INTEGER due{};
+  const uint64_t ns100 = ticks * 10000000ull / freq;
+  if (!ns100) return false;
+  due.QuadPart = -static_cast<LONGLONG>(ns100);
+  if (!SetWaitableTimer(t.timer, &due, 0, nullptr, nullptr, FALSE)) return false;
+  if (pending()) { CancelWaitableTimer(t.timer); return false; }
+  HANDLE handles[] = {w.event, t.timer};
+  // A signal that arrives between the predicate check and the wait stays
+  // pending in the event, so no notification is lost.
+  ++waits;
+  const DWORD result = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+  CancelWaitableTimer(t.timer);
+  return true;
+}
+#else
+inline void notify() { attention.store(1, std::memory_order_relaxed); }
+template <class Pending>
+inline bool wait(uint64_t, uint64_t, Pending) { return false; }
+#endif
+}  // namespace nwii::runtime::native_idle
diff --git a/nWiiRuntime/include/runtime/native_perf_census.h b/nWiiRuntime/include/runtime/native_perf_census.h
new file mode 100644
index 0000000..4ca4840
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_perf_census.h
@@ -0,0 +1,438 @@
+#pragma once
+// NATIVE_PERF_CENSUS_V1
+//
+// Ported from the Crash of the Titans port's runtime/native_perf_census.h and
+// adapted to this runtime. Game-independent: it names no guest address, reads
+// no guest RAM and prints nothing unless NWII_PERF_CENSUS is set.
+//
+// The CotT original counts the operations of CotT's own recompiler (its
+// dispatch switch, its quantised gather, its packed-vertex allocator, its
+// texture cache). None of those exist here: this runtime has a different
+// dispatcher, no quant gather and no packed-vertex path. What does exist, and
+// what this header measures, is the guest poll.
+//
+// The guest polls the host at every backward branch, so:
+//   * the poll rate is this runtime's closest thing to a "guest loop
+//     iterations per second" meter;
+//   * the guest's retired-instruction counter (ctx.inst_count, incremented by
+//     the generated code once per guest instruction) advances between two
+//     polls, so the instructions executed by one loop can be attributed
+//     exactly to the poll site that loop ends at.
+//
+// The per-site histogram therefore gives a hot-spot profile with exact
+// counts - not a sample - of where the guest spends its work.
+//
+// Cost, and why it is shaped the way it is
+// -----------------------------------------
+// The guest thread is close to saturating a core and the poll runs two to
+// three million times a second, so the census adds as little as possible to
+// that path:
+//   * the guest's counters share one cache line, and the counter the host
+//     thread writes has one of its own, so the two threads never bounce a
+//     line;
+//   * counters are read-modify-written with a load and a store, never with a
+//     locked read-modify-write;
+//   * the poll site is found through a four-entry cache, so the usual case is
+//     a comparison;
+//   * the clock is read only on every 64th poll. The counts stay exact; the
+//     wall-clock attribution becomes a sample, and an unbiased one, because a
+//     sampled poll draws the same site distribution as the polls themselves.
+//
+// An earlier revision read the clock on every poll and used locked
+// read-modify-writes on counters the host thread also wrote. It cost about a
+// third of a core, and on a guest already at 95 % of a core that was the
+// difference between the game running and the game stalling.
+//
+// Env:
+//   NWII_PERF_CENSUS=1        enable the census
+//   NWII_PERF_PC_HISTOGRAM=1  also record the per-poll-site histogram
+//   NWII_PERF_CENSUS_FAST=1   drop the clock read as well (counts only)
+//   NWII_PERF_CENSUS_FILE     write the whole per-site table as CSV
+//   NWII_PERF_CENSUS_PERIOD   seconds between [PERFCENSUS] reports (default 5)
+//
+// Output:
+//   [PERFCENSUS] t=12.0s polls=... polls_s=... fast=... slow=... instr=...
+//                instr_s=... polls_per_instr=... poll_us=... poll_pct=...
+//   [PERFPCS] n=1 pc=0x... polls=... instr=... exec_ms=... poll_us=... share_pct=...
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace native_perf_census {
+
+inline bool env_flag(const char *name) { return std::getenv(name) != nullptr; }
+
+inline const bool enabled = env_flag("NWII_PERF_CENSUS");
+inline const bool pc_histograms = enabled && env_flag("NWII_PERF_PC_HISTOGRAM");
+// The clock read is the expensive half of the histogram. NWII_PERF_CENSUS_FAST
+// drops it and keeps the exact instruction attribution.
+inline const bool timing = enabled && !env_flag("NWII_PERF_CENSUS_FAST");
+// How often the clock is read. The counts stay exact; only the wall-clock
+// attribution is sampled.
+inline const unsigned kClockEvery = 64;
+
+// The guest's counters. One cache line, one writer (the guest thread).
+struct alignas(64) GuestCounters {
+  std::atomic<uint64_t> polls{0};
+  std::atomic<uint64_t> polls_fast{0};
+  std::atomic<uint64_t> polls_slow{0};
+  std::atomic<uint64_t> instr{0};
+  std::atomic<uint64_t> poll_cost_ns{0};
+  std::atomic<uint64_t> poll_samples{0};
+  char pad[64 - 6 * sizeof(std::atomic<uint64_t>)];
+};
+inline GuestCounters g_counters;
+
+// The host's counter, on a line of its own so the two threads never share
+// one.
+struct alignas(64) HostCounter {
+  std::atomic<uint64_t> frames{0};
+  char pad[56];
+};
+inline HostCounter g_frames;
+
+__attribute__((always_inline)) inline void Bump(std::atomic<uint64_t> &field,
+                                                uint64_t amount) {
+  field.store(field.load(std::memory_order_relaxed) + amount, std::memory_order_relaxed);
+}
+
+inline uint64_t Polls() { return g_counters.polls.load(std::memory_order_relaxed); }
+inline uint64_t PollsFast() { return g_counters.polls_fast.load(std::memory_order_relaxed); }
+inline uint64_t PollsSlow() { return g_counters.polls_slow.load(std::memory_order_relaxed); }
+inline uint64_t GuestInstr() { return g_counters.instr.load(std::memory_order_relaxed); }
+inline uint64_t PollCostNs() { return g_counters.poll_cost_ns.load(std::memory_order_relaxed); }
+inline uint64_t PollSamples() { return g_counters.poll_samples.load(std::memory_order_relaxed); }
+
+// Kept for source compatibility with the CotT overlay headers, which call it
+// once per completed frame.
+inline void Frame() {
+  if (!enabled) return;
+  Bump(g_frames.frames, 1);
+}
+
+inline uint64_t now_ns() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count());
+}
+
+// What one clock read costs. The poll cost is a difference of two reads, so
+// the reads' own latency has to come out of it, otherwise the measurement
+// reports the clock instead of the poll.
+inline uint64_t clock_overhead_ns() {
+  static const uint64_t overhead = [] {
+    uint64_t best = UINT64_MAX;
+    for (int i = 0; i < 64; ++i) {
+      const uint64_t a = now_ns();
+      const uint64_t b = now_ns();
+      const uint64_t d = b >= a ? b - a : 0;
+      if (d < best) best = d;
+    }
+    return best == UINT64_MAX ? 0 : best;
+  }();
+  return overhead;
+}
+
+// ---------------------------------------------------------------------------
+// Per-poll-site histogram.
+//
+// One writer (the guest thread) and one reader (the reporter). Every field is
+// a relaxed atomic, and the writer never uses a locked read-modify-write.
+// ---------------------------------------------------------------------------
+// The guest has tens of thousands of backward branches and every one of them
+// is a poll site, so the table has to be large. 64 K sites of 32 bytes is
+// 2 MiB; the hot few stay in cache, the cold ones cost an L3 hit.
+constexpr unsigned kSlots = 65536;
+
+struct alignas(32) Site {
+  std::atomic<uint32_t> pc{0};
+  std::atomic<uint64_t> polls{0};
+  std::atomic<uint64_t> instr{0};
+  std::atomic<uint64_t> exec_ns{0};
+  char pad[4];
+};
+
+inline Site sites[kSlots];
+inline std::atomic<uint64_t> overflow{0};
+
+inline unsigned FindOrCreate(uint32_t pc) {
+  const unsigned base = unsigned((pc * 2654435761u) & (kSlots - 1u));
+  for (unsigned probe = 0; probe < 16; ++probe) {
+    const unsigned index = (base + probe) & (kSlots - 1u);
+    Site &s = sites[index];
+    const uint32_t cur = s.pc.load(std::memory_order_relaxed);
+    if (cur == pc) return index;
+    if (cur == 0) {
+      s.pc.store(pc, std::memory_order_relaxed);
+      return index;
+    }
+  }
+  overflow.fetch_add(1, std::memory_order_relaxed);
+  return UINT32_MAX;
+}
+
+// A four-entry cache in front of the table: the guest polls the same few
+// sites over and over, and this turns the usual lookup into a comparison.
+inline uint32_t g_cache_pc[4] = {0, 0, 0, 0};
+inline unsigned g_cache_slot[4] = {0, 0, 0, 0};
+inline unsigned g_cache_next = 0;
+
+inline unsigned SlotFor(uint32_t pc) {
+  if (!pc) return UINT32_MAX;
+  for (unsigned i = 0; i < 4; ++i)
+    if (g_cache_pc[i] == pc) return g_cache_slot[i];
+  const unsigned slot = FindOrCreate(pc);
+  if (slot == UINT32_MAX) return slot;
+  g_cache_pc[g_cache_next] = pc;
+  g_cache_slot[g_cache_next] = slot;
+  g_cache_next = (g_cache_next + 1) & 3u;
+  return slot;
+}
+
+// ---------------------------------------------------------------------------
+// Poll scope.
+//
+// Construct it at the top of the poll with the guest PC and the guest's
+// instruction counter; call mark_fast() on the cheap path; the destructor
+// accounts for the poll.
+// ---------------------------------------------------------------------------
+
+// State carried between two polls. Namespace scope, not function scope, so the
+// hot path pays no thread-safe-static guard check.
+inline uint64_t g_last_inst = 0;
+inline uint64_t g_last_exit_ns = 0;
+inline unsigned g_last_slot = UINT32_MAX;
+inline unsigned g_poll_index = 0;
+inline bool g_have_exit = false;
+inline uint64_t g_poll_cost_min = UINT64_MAX;
+
+// A histogram of the sampled poll costs, 10 ns per bucket. The mean is not a
+// usable figure here: the guest thread is descheduled for part of the run and
+// a poll that the scheduler interrupts measures the interruption too. The
+// distribution is not distorted that way.
+constexpr unsigned kPollBuckets = 128;
+inline std::atomic<uint32_t> g_poll_hist[kPollBuckets];
+
+struct PollScope {
+  uint32_t pc;
+  uint64_t inst;
+  uint64_t t_enter;
+  bool fast;
+  bool sampled;
+  PollScope(uint32_t pc_, uint64_t inst_)
+      : pc(pc_), inst(inst_), t_enter(0), fast(false), sampled(false) {
+    if (enabled && timing) {
+      sampled = ((++g_poll_index) & (kClockEvery - 1u)) == 0;
+      if (sampled) t_enter = now_ns();
+    }
+  }
+  PollScope(const PollScope &) = delete;
+  PollScope &operator=(const PollScope &) = delete;
+  void mark_fast() { fast = true; }
+  ~PollScope();
+};
+
+inline PollScope::~PollScope() {
+  if (!enabled) return;
+  const unsigned slot = SlotFor(pc);
+  if (slot != UINT32_MAX) Bump(sites[slot].polls, 1);
+  Bump(g_counters.polls, 1);
+  Bump(fast ? g_counters.polls_fast : g_counters.polls_slow, 1);
+
+  // The instructions executed since the previous poll belong to the loop
+  // whose backward branch is the *previous* poll site.
+  const uint64_t di = inst >= g_last_inst ? inst - g_last_inst : 0;
+  g_last_inst = inst;
+  if (di) {
+    Bump(g_counters.instr, di);
+    const unsigned target = (slot == g_last_slot) ? slot : g_last_slot;
+    if (target != UINT32_MAX) Bump(sites[target].instr, di);
+  }
+  g_last_slot = slot;
+
+  if (!sampled) return;
+  const uint64_t t_exit = now_ns();
+  // The two clock reads that bracket the poll are not part of the poll.
+  const uint64_t overhead = clock_overhead_ns() * 2;
+  const uint64_t raw = t_exit >= t_enter ? t_exit - t_enter : 0;
+  const uint64_t poll_ns = raw > overhead ? raw - overhead : 0;
+  if (!g_have_exit) {
+    // The first sample has no predecessor; it only starts the interval.
+    g_have_exit = true;
+    g_last_exit_ns = t_exit;
+    return;
+  }
+  const uint64_t interval = t_exit >= g_last_exit_ns ? t_exit - g_last_exit_ns : 0;
+  if (slot != UINT32_MAX) {
+    Bump(sites[slot].exec_ns, interval);
+  }
+  Bump(g_counters.poll_cost_ns, poll_ns);
+  Bump(g_counters.poll_samples, 1);
+  if (poll_ns < g_poll_cost_min) g_poll_cost_min = poll_ns;
+  {
+    const unsigned bucket = unsigned(poll_ns / 10u);
+    g_poll_hist[bucket < kPollBuckets ? bucket : kPollBuckets - 1u].fetch_add(
+        1, std::memory_order_relaxed);
+  }
+  g_last_exit_ns = t_exit;
+}
+
+// ---------------------------------------------------------------------------
+// Reporting. Called from the host loop, never from the guest thread, so the
+// line does not interleave with the guest's own output.
+// ---------------------------------------------------------------------------
+inline double report_period_s() {
+  static const double seconds = [] {
+    const char *e = std::getenv("NWII_PERF_CENSUS_PERIOD");
+    const double v = e ? std::strtod(e, nullptr) : 5.0;
+    return v > 0.05 ? v : 5.0;
+  }();
+  return seconds;
+}
+
+inline const char *census_file() {
+  static const char *path = std::getenv("NWII_PERF_CENSUS_FILE");
+  return path;
+}
+
+inline uint64_t g_report_last_ns = 0;
+inline uint64_t g_report_start_ns = 0;
+inline uint64_t g_report_last_polls = 0;
+inline uint64_t g_report_last_instr = 0;
+
+// The percentiles of the sampled poll costs, in nanoseconds.
+inline void poll_percentiles(double *p10, double *p50, double *p90) {
+  uint64_t total = 0;
+  for (unsigned i = 0; i < kPollBuckets; ++i)
+    total += g_poll_hist[i].load(std::memory_order_relaxed);
+  *p10 = *p50 = *p90 = 0.0;
+  if (!total) return;
+  const uint64_t want[3] = {total / 10, total / 2, (total * 9) / 10};
+  uint64_t seen = 0;
+  unsigned slot = 0;
+  for (unsigned i = 0; i < kPollBuckets; ++i) {
+    seen += g_poll_hist[i].load(std::memory_order_relaxed);
+    while (slot < 3 && seen >= want[slot]) {
+      double *target = slot == 0 ? p10 : (slot == 1 ? p50 : p90);
+      *target = double(i) * 10.0 + 5.0;
+      ++slot;
+    }
+    if (slot == 3) break;
+  }
+  while (slot < 3) {
+    double *target = slot == 0 ? p10 : (slot == 1 ? p50 : p90);
+    *target = double(kPollBuckets) * 10.0;
+    ++slot;
+  }
+}
+
+inline void WriteTable() {
+  const char *path = census_file();
+  if (!path || !*path) return;
+  std::FILE *out = std::fopen(path, "wb");
+  if (!out) return;
+  std::fprintf(out, "pc,polls,instr,exec_ns\n");
+  for (unsigned i = 0; i < kSlots; ++i) {
+    const uint32_t pc = sites[i].pc.load(std::memory_order_relaxed);
+    if (!pc) continue;
+    std::fprintf(out, "0x%08X,%llu,%llu,%llu\n", pc,
+                 (unsigned long long)sites[i].polls.load(std::memory_order_relaxed),
+                 (unsigned long long)sites[i].instr.load(std::memory_order_relaxed),
+                 (unsigned long long)sites[i].exec_ns.load(std::memory_order_relaxed));
+  }
+  std::fclose(out);
+}
+
+inline void maybe_report() {
+  if (!enabled) return;
+  const uint64_t now = now_ns();
+  if (!g_report_last_ns) {
+    g_report_last_ns = now;
+    g_report_start_ns = now;
+    return;
+  }
+  const double elapsed_s = double(now - g_report_last_ns) / 1e9;
+  if (elapsed_s < report_period_s()) return;
+  const double total_s = double(now - g_report_start_ns) / 1e9;
+
+  const uint64_t polls = Polls();
+  const uint64_t instr = GuestInstr();
+  const uint64_t dpolls = polls - g_report_last_polls;
+  const uint64_t dinstr = instr - g_report_last_instr;
+  // The cost of one poll, measured on the sampled polls. The guest thread is
+  // descheduled for part of the run, and a poll that is interrupted by the
+  // scheduler measures the interruption too, so the mean is an upper bound
+  // and the minimum is the better estimate of the poll's own cost.
+  const uint64_t samples = PollSamples();
+  const double poll_us = samples ? double(PollCostNs()) / double(samples) / 1000.0 : 0.0;
+  const double poll_us_min = g_poll_cost_min == UINT64_MAX ? 0.0 : double(g_poll_cost_min) / 1000.0;
+  double poll_p10 = 0.0, poll_p50 = 0.0, poll_p90 = 0.0;
+  poll_percentiles(&poll_p10, &poll_p50, &poll_p90);
+  const double poll_ms = poll_us * double(dpolls) / 1000.0;
+
+  std::printf(
+      "[PERFCENSUS] t=%.1fs polls=%llu polls_s=%.0f fast=%llu slow=%llu "
+      "instr=%llu instr_s=%.0f polls_per_instr=%.3f poll_us=%.2f poll_us_min=%.2f "
+      "poll_us_p10=%.2f poll_us_p50=%.2f poll_us_p90=%.2f poll_pct=%.1f\n",
+      total_s, (unsigned long long)polls, double(dpolls) / elapsed_s,
+      (unsigned long long)PollsFast(), (unsigned long long)PollsSlow(),
+      (unsigned long long)instr, double(dinstr) / elapsed_s,
+      dinstr ? double(dpolls) / double(dinstr) : 0.0, poll_us, poll_us_min,
+      poll_p10 / 1000.0, poll_p50 / 1000.0, poll_p90 / 1000.0,
+      elapsed_s > 0 ? 100.0 * poll_ms / (elapsed_s * 1000.0) : 0.0);
+  std::fflush(stdout);
+
+  if (pc_histograms) {
+    struct Row {
+      uint32_t pc;
+      uint64_t polls, instr, exec_ns;
+    };
+    std::vector<Row> rows;
+    rows.reserve(64);
+    uint64_t total_exec = 0;
+    for (unsigned i = 0; i < kSlots; ++i) {
+      const uint32_t pc = sites[i].pc.load(std::memory_order_relaxed);
+      if (!pc) continue;
+      Row r{pc,
+            sites[i].polls.load(std::memory_order_relaxed),
+            sites[i].instr.load(std::memory_order_relaxed),
+            sites[i].exec_ns.load(std::memory_order_relaxed)};
+      total_exec += r.exec_ns;
+      rows.push_back(r);
+    }
+    for (size_t i = 1; i < rows.size(); ++i) {
+      Row key = rows[i];
+      size_t j = i;
+      while (j > 0 && rows[j - 1].exec_ns < key.exec_ns) {
+        rows[j] = rows[j - 1];
+        --j;
+      }
+      rows[j] = key;
+    }
+    const size_t shown = rows.size() < 16 ? rows.size() : 16;
+    for (size_t i = 0; i < shown; ++i) {
+      const Row &r = rows[i];
+      std::printf(
+          "[PERFPCS] n=%zu pc=0x%08X polls=%llu instr=%llu exec_ms=%.1f "
+          "share_pct=%.1f\n",
+          i + 1, r.pc, (unsigned long long)r.polls, (unsigned long long)r.instr,
+          double(r.exec_ns) / 1e6,
+          total_exec ? 100.0 * double(r.exec_ns) / double(total_exec) : 0.0);
+    }
+    const uint64_t dropped = overflow.load(std::memory_order_relaxed);
+    if (dropped) std::printf("[PERFPCS] overflow=%llu slots=%u\n",
+                             (unsigned long long)dropped, kSlots);
+    WriteTable();
+  }
+
+  g_report_last_ns = now;
+  g_report_last_polls = polls;
+  g_report_last_instr = instr;
+}
+
+}  // namespace native_perf_census
diff --git a/nWiiRuntime/include/runtime/native_perf_phase.h b/nWiiRuntime/include/runtime/native_perf_phase.h
new file mode 100644
index 0000000..d0b1fa6
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_perf_phase.h
@@ -0,0 +1,343 @@
+#pragma once
+// NATIVE_PERF_PHASE_V1
+//
+// Ported from the Crash of the Titans port's frame_trace.h / native_stutter.h
+// family and adapted to this runtime. Game-independent: it names no guest
+// address, reads no guest RAM and prints nothing unless NWII_PERF_PHASE is
+// set.
+//
+// CotT's frame_trace.h is a Chrome-trace event recorder with per-thread
+// buffers, GPU query fences and a Windows thread-time bridge. None of that
+// exists here, and none of it is needed to answer the questions this port
+// actually asks: how long a frame takes, which part of the frame costs what,
+// and how much of the frame is spent waiting instead of working.
+//
+// This header keeps the part that transfers: a set of named phase scopes
+// around the host's render work, a per-frame record of how long each phase
+// took, and a periodic report.
+//
+// The frame is one iteration of the host render loop. That loop is field-paced
+// (see NATIVE_FIELD_PACING_V1), so the frame period is the display field
+// period and the interesting number is how much of it the host actually
+// spends working.
+//
+// Env:
+//   NWII_PERF_PHASE=1        enable the phase timers
+//   NWII_PERF_PHASE_FILE     append the per-frame timeline as CSV
+//   NWII_PERF_PHASE_PERIOD   seconds between [PERFPHASE] reports (default 5)
+//
+// Output:
+//   [PERFPHASE] t=12.0s window=5.0s frames=300 frame_ms=16.63 p95=17.20
+//               max=25.40 gx_parse=0.42 gx_decode=1.20 gl_render=8.90
+//               xfb_copy=0.55 present=0.20 swap=0.10 host_field=0.90
+//               host_drain_wait=0.85 guest_idle=0.00 host_sum=11.37
+//               budget=16.67 busy=68.2% guest_cpu_ms_s=900.0
+//
+// All the phase numbers are milliseconds per frame over the report window.
+//
+// Caveats, which the report repeats:
+//   * the frame phases are host-thread CPU time; the guest thread runs
+//     concurrently and its execution time is not part of any frame phase, so
+//     "host_sum" is the host's work and "frame_ms - host_sum" is the host's
+//     own overhead plus whatever the guest thread did during the frame;
+//   * guest_idle is the time the guest spent parked on its waitable timer;
+//     it is a stall measure, not a frame phase, and is reported separately;
+//   * the phase timers are wall clock, so a preempted host thread inflates
+//     the phase it was in.
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace native_perf_phase {
+
+enum Phase : unsigned {
+  Phase_GxParse = 0,
+  Phase_GxDecode,
+  Phase_GlRender,
+  Phase_XfbCopy,
+  Phase_Present,
+  Phase_Swap,
+  Phase_HostField,
+  Phase_HostDrainWait,
+  Phase_GuestIdle,
+  Phase_Count
+};
+
+inline const char *phase_name(unsigned phase) {
+  static const char *const names[Phase_Count] = {
+      "gx_parse",  "gx_decode", "gl_render", "xfb_copy", "present",
+      "swap",      "host_field", "host_drain_wait", "guest_idle"};
+  return phase < Phase_Count ? names[phase] : "unknown";
+}
+
+inline const bool enabled = std::getenv("NWII_PERF_PHASE") != nullptr;
+
+inline uint64_t now_ns() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count());
+}
+
+// One counter per cache line. The host thread writes most of them and the
+// guest thread writes guest_idle; on one shared line the two threads would
+// bounce it on every update.
+struct alignas(64) PhaseCounter {
+  std::atomic<uint64_t> ns{0};
+  std::atomic<uint64_t> hits{0};
+  char pad[64 - 2 * sizeof(std::atomic<uint64_t>)];
+};
+
+inline PhaseCounter counters[Phase_Count];
+
+__attribute__((always_inline)) inline void Add(Phase phase, uint64_t ns) {
+  counters[phase].ns.store(
+      counters[phase].ns.load(std::memory_order_relaxed) + ns,
+      std::memory_order_relaxed);
+  counters[phase].hits.store(
+      counters[phase].hits.load(std::memory_order_relaxed) + 1,
+      std::memory_order_relaxed);
+}
+inline uint64_t Total(Phase phase) {
+  return counters[phase].ns.load(std::memory_order_relaxed);
+}
+inline uint64_t Hits(Phase phase) {
+  return counters[phase].hits.load(std::memory_order_relaxed);
+}
+
+// A phase scope. Costs one clock read when the phase is enabled and none
+// when it is not. stop() ends the phase early; the destructor stops it too.
+struct Scope {
+  Phase phase;
+  uint64_t t0;
+  bool active;
+  explicit Scope(Phase p) : phase(p), t0(0), active(false) {
+    if (enabled) {
+      t0 = now_ns();
+      active = true;
+    }
+  }
+  Scope(const Scope &) = delete;
+  Scope &operator=(const Scope &) = delete;
+  void stop() {
+    if (!active) return;
+    Add(phase, now_ns() - t0);
+    active = false;
+  }
+  ~Scope() { stop(); }
+};
+
+// ---------------------------------------------------------------------------
+// Per-frame timeline.
+// ---------------------------------------------------------------------------
+constexpr unsigned kFrameRing = 8192;
+
+struct FrameRecord {
+  uint64_t wall_ns;
+  uint64_t phase_ns[Phase_Count];
+};
+
+inline FrameRecord ring[kFrameRing];
+inline uint64_t frame_index = 0;      // frames recorded so far
+inline uint64_t frame_start_ns = 0;
+inline uint64_t frame_snapshot[Phase_Count];
+inline uint64_t run_wall_ns = 0;
+inline uint64_t run_phase_ns[Phase_Count];
+inline uint64_t run_max_wall_ns = 0;
+
+inline void frame_begin() {
+  if (!enabled) return;
+  frame_start_ns = now_ns();
+  for (unsigned i = 0; i < Phase_Count; ++i)
+    frame_snapshot[i] = counters[i].ns.load(std::memory_order_relaxed);
+}
+
+inline void frame_end() {
+  if (!enabled) return;
+  const uint64_t t = now_ns();
+  FrameRecord &r = ring[frame_index % kFrameRing];
+  r.wall_ns = t - frame_start_ns;
+  for (unsigned i = 0; i < Phase_Count; ++i) {
+    const uint64_t now = counters[i].ns.load(std::memory_order_relaxed);
+    r.phase_ns[i] = now >= frame_snapshot[i] ? now - frame_snapshot[i] : 0;
+    run_phase_ns[i] += r.phase_ns[i];
+  }
+  run_wall_ns += r.wall_ns;
+  if (r.wall_ns > run_max_wall_ns) run_max_wall_ns = r.wall_ns;
+  ++frame_index;
+}
+
+// ---------------------------------------------------------------------------
+// Guest thread CPU time (Windows thread accounting). The guest thread is the
+// one that runs the recompiled code; its CPU time is the port's headline
+// cost, and it is not visible in any host-side phase.
+// ---------------------------------------------------------------------------
+inline std::atomic<uint32_t> g_guest_tid{0};
+
+// Call this from the thread that runs the recompiled guest code.
+inline void set_guest_thread() {
+#ifdef _WIN32
+  g_guest_tid.store(GetCurrentThreadId(), std::memory_order_relaxed);
+#endif
+}
+
+inline uint64_t guest_cpu_us() {
+#ifdef _WIN32
+  const uint32_t tid = g_guest_tid.load(std::memory_order_relaxed);
+  if (!tid) return 0;
+  HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid);
+  if (!h) return 0;
+  FILETIME c, e, k, u;
+  uint64_t us = 0;
+  if (GetThreadTimes(h, &c, &e, &k, &u)) {
+    const auto ticks = [](FILETIME f) {
+      return (uint64_t(f.dwHighDateTime) << 32) | uint64_t(f.dwLowDateTime);
+    };
+    us = (ticks(k) + ticks(u)) / 10;
+  }
+  CloseHandle(h);
+  return us;
+#else
+  return 0;
+#endif
+}
+
+// ---------------------------------------------------------------------------
+// Reporting.
+// ---------------------------------------------------------------------------
+inline double report_period_s() {
+  static const double seconds = [] {
+    const char *e = std::getenv("NWII_PERF_PHASE_PERIOD");
+    const double v = e ? std::strtod(e, nullptr) : 5.0;
+    return v > 0.05 ? v : 5.0;
+  }();
+  return seconds;
+}
+
+inline const char *phase_file() {
+  static const char *path = std::getenv("NWII_PERF_PHASE_FILE");
+  return path;
+}
+
+inline uint64_t g_report_last_ns = 0;
+inline uint64_t g_report_start_ns = 0;
+inline uint64_t g_report_last_frames = 0;
+inline uint64_t g_report_last_guest_cpu_us = 0;
+inline std::FILE *g_csv = nullptr;
+
+inline void csv_header() {
+  if (!phase_file() || !*phase_file()) return;
+  if (g_csv) return;
+  g_csv = std::fopen(phase_file(), "wb");
+  if (!g_csv) return;
+  std::fprintf(g_csv, "frame,wall_ms");
+  for (unsigned i = 0; i < Phase_Count; ++i)
+    std::fprintf(g_csv, ",%s_ms", phase_name(i));
+  std::fprintf(g_csv, "\n");
+  std::fflush(g_csv);
+}
+
+inline void flush_frames(uint64_t first, uint64_t last) {
+  csv_header();
+  if (!g_csv) return;
+  // The ring holds kFrameRing frames; anything older has been overwritten.
+  if (last - first > kFrameRing) {
+    first = last - kFrameRing;
+    std::fprintf(g_csv, "# %llu frame(s) dropped, the ring holds %u\n",
+                 (unsigned long long)(last - first), kFrameRing);
+  }
+  for (uint64_t i = first; i < last; ++i) {
+    const FrameRecord &r = ring[i % kFrameRing];
+    std::fprintf(g_csv, "%llu,%.3f", (unsigned long long)i,
+                 double(r.wall_ns) / 1e6);
+    for (unsigned p = 0; p < Phase_Count; ++p)
+      std::fprintf(g_csv, ",%.3f", double(r.phase_ns[p]) / 1e6);
+    std::fprintf(g_csv, "\n");
+  }
+  std::fflush(g_csv);
+}
+
+inline void maybe_report() {
+  if (!enabled) return;
+  const uint64_t now = now_ns();
+  if (!g_report_last_ns) {
+    g_report_last_ns = now;
+    g_report_start_ns = now;
+    g_report_last_guest_cpu_us = guest_cpu_us();
+    return;
+  }
+  const double elapsed_s = double(now - g_report_last_ns) / 1e9;
+  if (elapsed_s < report_period_s()) return;
+  const double total_s = double(now - g_report_start_ns) / 1e9;
+
+  const uint64_t first = g_report_last_frames;
+  const uint64_t last = frame_index;
+  const uint64_t frames = last > first ? last - first : 0;
+
+  std::vector<uint64_t> walls;
+  walls.reserve(frames < 4096 ? size_t(frames) : 4096);
+  for (uint64_t i = (last > kFrameRing ? last - kFrameRing : 0); i < last; ++i)
+    walls.push_back(ring[i % kFrameRing].wall_ns);
+  std::sort(walls.begin(), walls.end());
+  const auto pct = [&walls](double p) -> double {
+    if (walls.empty()) return 0.0;
+    size_t i = size_t((double(walls.size()) * p + 0.999999) - 1.0);
+    if (i >= walls.size()) i = walls.size() - 1;
+    return double(walls[i]) / 1e6;
+  };
+
+  double mean_wall_ms = 0.0, max_wall_ms = 0.0;
+  for (uint64_t i = first; i < last; ++i) {
+    const uint64_t w = ring[i % kFrameRing].wall_ns;
+    mean_wall_ms += double(w) / 1e6;
+    if (double(w) / 1e6 > max_wall_ms) max_wall_ms = double(w) / 1e6;
+  }
+  if (frames) mean_wall_ms /= double(frames);
+
+  double phase_ms[Phase_Count];
+  double host_sum_ms = 0.0;
+  for (unsigned p = 0; p < Phase_Count; ++p) {
+    uint64_t sum = 0;
+    for (uint64_t i = first; i < last; ++i)
+      sum += ring[i % kFrameRing].phase_ns[p];
+    phase_ms[p] = frames ? double(sum) / 1e6 / double(frames) : 0.0;
+  }
+  // The frame phases are the host's render work; the field wait and the
+  // guest's idle park are stalls and are reported, not summed into the frame.
+  host_sum_ms = phase_ms[Phase_GxParse] + phase_ms[Phase_GxDecode] +
+                phase_ms[Phase_GlRender] + phase_ms[Phase_XfbCopy] +
+                phase_ms[Phase_Present] + phase_ms[Phase_Swap];
+
+  const uint64_t guest_cpu_us_now = guest_cpu_us();
+  const double guest_cpu_ms_s =
+      elapsed_s > 0 ? double(guest_cpu_us_now - g_report_last_guest_cpu_us) / 1000.0 / elapsed_s : 0.0;
+
+  std::printf("[PERFPHASE] t=%.1fs window=%.1fs frames=%llu frame_ms=%.3f p95=%.3f max=%.3f",
+              total_s, elapsed_s, (unsigned long long)frames, mean_wall_ms,
+              pct(0.95), max_wall_ms);
+  for (unsigned p = 0; p < Phase_Count; ++p)
+    std::printf(" %s=%.3f", phase_name(p), phase_ms[p]);
+  std::printf(" host_sum=%.3f guest_cpu_ms_s=%.1f\n", host_sum_ms, guest_cpu_ms_s);
+  std::fflush(stdout);
+
+  flush_frames(first, last);
+
+  g_report_last_ns = now;
+  g_report_last_frames = last;
+  g_report_last_guest_cpu_us = guest_cpu_us_now;
+}
+
+}  // namespace native_perf_phase
