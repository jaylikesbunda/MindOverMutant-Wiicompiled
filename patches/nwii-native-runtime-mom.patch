+              << r.uv0[1] << " -> " << r.uv1[0] << "," << r.uv1[1]
+              << " hasuv=" << r.has_uv << " pos=" << r.pos0[0] << "," << r.pos0[1]
+              << "," << r.pos0[2] << " -> " << r.pos1[0] << "," << r.pos1[1]
+              << "," << r.pos1[2] << std::endl;
+  }
+}
