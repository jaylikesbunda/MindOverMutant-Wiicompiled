+// NATIVE_EFB_COPY_GEOMETRY_BEGIN
+// The GX copy rectangle is top-origin; decoded guest textures also have row
+// zero at their top. Reverse the source Y endpoints when transferring to GL.
+// Bind the actual draw EFB explicitly, preserving unrelated texture/FBO state.
+static void NativeCopyEfbTexture(GLuint texture, int x, int y, int width, int height,int scale=1) {
+  GLint draw=0,read=0,binding=0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&draw);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&read);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D,&binding);
+  const GLboolean scissor=glIsEnabled(GL_SCISSOR_TEST);
+  static GLuint copy_fbo=0;
+  if(!copy_fbo)glGenFramebuffers(1,&copy_fbo);
+  glBindTexture(GL_TEXTURE_2D,texture);
+  glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA8,width,height,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
+  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAX_LEVEL,0); // NATIVE_MOM_MIPMAPS_V1: a copy has no chain
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,GLuint(draw));
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,copy_fbo);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,texture,0);
+  NativeRasterDisable(GL_SCISSOR_TEST);
+  // NATIVE_EFB_COPY_MASK_V1: copies read the EFB and ignore the guest colour mask.
+  GLboolean copy_mask[4];glGetBooleanv(GL_COLOR_WRITEMASK,copy_mask);
+  NativeRasterColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+  glBlitFramebuffer(x*scale,(kNativeEfbHeight-y)*scale,(x+width)*scale,(kNativeEfbHeight-y-height)*scale,
+                    0,0,width,height,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+  if ((g_state.bp[0x43] & 7) != 1) { // NATIVE_MOM_ALPHA_ISOLATION_V1: no EFB alpha -> copies read alpha 1
+    GLboolean saved_mask[4];glGetBooleanv(GL_COLOR_WRITEMASK,saved_mask);
+    GLfloat saved_clear[4];glGetFloatv(GL_COLOR_CLEAR_VALUE,saved_clear);
+    NativeRasterColorMask(GL_FALSE,GL_FALSE,GL_FALSE,GL_TRUE);
+    glClearColor(0.f,0.f,0.f,1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glClearColor(saved_clear[0],saved_clear[1],saved_clear[2],saved_clear[3]);
+    NativeRasterColorMask(saved_mask[0],saved_mask[1],saved_mask[2],saved_mask[3]);
+  }
+  NativeRasterColorMask(copy_mask[0],copy_mask[1],copy_mask[2],copy_mask[3]);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,GLuint(draw));
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,GLuint(read));
+  glBindTexture(GL_TEXTURE_2D,GLuint(binding));
+  if(scissor)NativeRasterEnable(GL_SCISSOR_TEST);
+}
