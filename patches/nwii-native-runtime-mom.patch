+    case 0x804A4EA0: case 0x804A5800: case 0x804A4F2C: case 0x804A4F94:
+    case 0x804A4FFC: case 0x804A5064: case 0x804A50AC: case 0x804A59A0:
+    case 0x804A4CE0: case 0x804A7818: case 0x804A788C:
+    case 0x804A5160: case 0x804A5218: break;
