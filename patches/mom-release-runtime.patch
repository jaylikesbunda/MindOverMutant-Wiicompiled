+}();
+static std::vector<NativePackedBatchVertex> s_packed_batch; // reused, no per-draw alloc
+static GLuint s_attrib_buffer = 0;
+static int s_attrib_layout = -1; // -1 unset, 0 float(160), 1 packed(136)
