+              (unsigned long long)window_submits,
+              window_draws ? double(window_submits) / double(window_draws) : 0.0,
+              window_submits ? double(window_draws) / double(window_submits) : 0.0,
+              (unsigned long long)window_vertices,
+              (unsigned long long)window_requests, (unsigned long long)window_empty,
+              (unsigned long long)total_draws, (unsigned long long)total_submits,
+              total_draws ? double(total_submits) / double(total_draws) : 0.0,
