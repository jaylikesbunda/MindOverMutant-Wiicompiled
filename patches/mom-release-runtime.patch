+// NATIVE_MOM_POLL_SPIN_OUTLINE_V1: the poll-site "Spinning at PC" console line, out of line.
+// Generated poll sites carry only their inst_count test; this prints the identical line.
+#pragma once
+#include <cstdint>
+#include <iostream>
+namespace nwii::runtime {
+__attribute__((noinline, cold)) inline void native_poll_spinning(uint32_t pc, uint32_t lr) {
+    std::cout << "Spinning at PC: 0x" << std::hex << pc << " LR: 0x" << std::hex << lr << std::dec << std::endl;
+}
+} // namespace nwii::runtime
diff --git a/nWiiRuntime/include/runtime/native_prompt_device.h b/nWiiRuntime/include/runtime/native_prompt_device.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_prompt_device.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace native_prompts {
+// Shared between the SDL host thread and the rendering thread. No guest state is changed.
+inline std::atomic<unsigned> device{2}; // Xbox, PlayStation, keyboard/mouse
+struct Activity {
+    unsigned selected = 2;
+    unsigned pending = 2;
+    uint64_t changed = 0;
+    bool select(unsigned candidate,uint64_t now) {
+        if(candidate>=3)return false;
+        pending=candidate;const bool different=selected!=candidate;
+        selected=candidate;changed=now;return different;
+    }
+    bool update(unsigned candidate, uint64_t now) {
+        if(candidate < 3) pending = candidate;
+        if (pending == selected || now - changed < 250) return false;
+        selected = pending; changed = now;
+        return true;
+    }
+};
+}
diff --git a/nWiiRuntime/include/runtime/native_prompt_textures_mom.h b/nWiiRuntime/include/runtime/native_prompt_textures_mom.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_prompt_textures_mom.h
@@ -0,0 +1,137 @@
+#pragma once
+#include "runtime/native_prompt_device.h"
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <unordered_map>
+#include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace native_prompts {
+// GL objects and candidate bytes belong exclusively to the render thread.
+class MomTextures {
+    struct Glyph {
+        std::array<unsigned char,4096> original{};
+        std::array<std::array<unsigned char,4096>,3> pixels{};
+        std::array<std::array<GLuint,3>,2> textures{};
+        bool observed=false;
+    };
+    struct Candidate {
+        unsigned format=~0u,palette_format=~0u;
+        std::vector<unsigned char> source,palette;
+        int glyph=-2;
+    };
+    std::vector<Glyph> glyphs;
+    std::unordered_map<unsigned,Candidate> candidates;
+    std::vector<GLuint> retired;
+    const std::filesystem::path path=[](){const char* p=std::getenv("NWII_PROMPT_PACK");return p?p:"";}();
+    uint64_t pack_time=0;
+    std::chrono::steady_clock::time_point next_check{};
+
+    bool modified(uint64_t& stamp) const {
+#ifdef _WIN32
+        // MinGW's filesystem timestamp can truncate to whole seconds. Rapid
+        // same-size remaps need the native 100 ns FILETIME instead.
+        WIN32_FILE_ATTRIBUTE_DATA info{};
+        if(!GetFileAttributesExW(path.c_str(),GetFileExInfoStandard,&info))return false;
+        stamp=(uint64_t(info.ftLastWriteTime.dwHighDateTime)<<32)|info.ftLastWriteTime.dwLowDateTime;
+#else
+        std::error_code error;const auto value=std::filesystem::last_write_time(path,error);
+        if(error)return false;stamp=uint64_t(value.time_since_epoch().count());
+#endif
+        return true;
+    }
+
+    static bool matches(const unsigned char* original,const unsigned char* rgba,bool flip,unsigned threshold) {
+        for(unsigned y=0;y<32;++y)for(unsigned x=0;x<32;++x) {
+            const unsigned p=(y*32+x)*4,q=((flip?31-y:y)*32+x)*4;
+            if(!threshold) { if(std::memcmp(original+q,rgba+p,4))return false;continue; }
+            const bool opaque=original[q+3]>=threshold;
+            const unsigned a=original[q+3]>>5;
+            if(rgba[p+3]!=(opaque?255u:(a<<5)|(a<<2)|(a>>1)))return false;
+            for(unsigned c=0;c<3;++c) {
+                const unsigned v=original[q+c]>>(opaque?3:4);
+                if(rgba[p+c]!=(opaque?((v<<3)|(v>>2)):((v<<4)|v)))return false;
+            }
+        }
+        return true;
+    }
+    void refresh() {
+        if(path.empty())return;
+        const auto now=std::chrono::steady_clock::now();if(now<next_check)return;
+        next_check=now+std::chrono::milliseconds(250);
+        uint64_t stamp=0;
+        if(!modified(stamp) || (!glyphs.empty() && stamp==pack_time))return;
+        std::ifstream file(path,std::ios::binary);char magic[8]{};file.read(magic,8);
+        if(!file || std::memcmp(magic,"MMPRMT01",8))return;
+        std::vector<Glyph> loaded(8);
+        for(auto& g:loaded) {
+            file.read(reinterpret_cast<char*>(g.original.data()),4096);
+            for(auto& pixels:g.pixels)file.read(reinterpret_cast<char*>(pixels.data()),4096);
+        }
+        if(!file || file.peek()!=std::char_traits<char>::eof())return;
+        // An open batch may still reference an old name. Delete only at the texture
+        // cache's protected-name boundary, never during a live remap.
+        for(auto& g:glyphs)for(auto& orientation:g.textures)for(GLuint tex:orientation)if(tex)retired.push_back(tex);
+        glyphs=std::move(loaded);candidates.clear();pack_time=stamp;
+        std::cout<<"[Prompts] MoM live pack loaded: 8 action glyphs"<<std::endl;
+    }
+public:
+    MomTextures(){refresh();}
+    int probe(unsigned address,unsigned format,unsigned palette_format,const unsigned char* source,size_t bytes,
+              const unsigned char* palette,size_t palette_bytes) {
+        refresh();if(glyphs.empty())return -1;
+        if(candidates.size()>1024)candidates.clear();
+        auto& c=candidates[address];
+        if(c.format==format && c.palette_format==palette_format && c.source.size()==bytes && c.palette.size()==palette_bytes &&
+           !std::memcmp(c.source.data(),source,bytes) && (!palette_bytes || !std::memcmp(c.palette.data(),palette,palette_bytes)))return c.glyph;
+        c.format=format;c.palette_format=palette_format;c.source.assign(source,source+bytes);
+        c.palette.clear();if(palette_bytes)c.palette.assign(palette,palette+palette_bytes);
+        c.glyph=-2;return -2;
+    }
+    int record(unsigned address,const unsigned char* rgba) {
+        auto& c=candidates.at(address);c.glyph=-1;if(!rgba)return -1;
+        for(unsigned i=0;i<glyphs.size();++i)for(unsigned flip=0;flip<2;++flip) {
+            bool match=matches(glyphs[i].original.data(),rgba,flip,0);
+            if(!match && (c.format==8 || c.format==9 || c.format==10) && c.palette_format==2)
+                match=matches(glyphs[i].original.data(),rgba,flip,224) || matches(glyphs[i].original.data(),rgba,flip,255);
+            if(match) {
+                c.glyph=int(i+flip*8);
+                if(!glyphs[i].observed){glyphs[i].observed=true;std::cout<<"[Prompts] matched MoM action "<<i<<" flip="<<flip<<std::endl;}
+                return c.glyph;
+            }
+        }
+        return -1;
+    }
+    GLuint texture(int glyph) {
+        if(glyph<0 || unsigned(glyph)>=glyphs.size()*2)return 0;
+        const unsigned selected=device.load(std::memory_order_relaxed);
+        if(selected>=3)return 0;
+        auto& g=glyphs[unsigned(glyph)%8];const unsigned flip=unsigned(glyph)/8;
+        auto& tex=g.textures[flip][selected];if(tex)return tex;
+        GLint bound=0;glGetIntegerv(GL_TEXTURE_BINDING_2D,&bound);
+        glGenTextures(1,&tex);glBindTexture(GL_TEXTURE_2D,tex);
+        std::array<unsigned char,4096> pixels{};
+        for(unsigned y=0;y<32;++y)std::memcpy(pixels.data()+128*y,g.pixels[selected].data()+128*(flip?31-y:y),128);
+        glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,32,32,0,GL_RGBA,GL_UNSIGNED_BYTE,pixels.data());
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_NEAREST);glGenerateMipmap(GL_TEXTURE_2D);
+        glBindTexture(GL_TEXTURE_2D,GLuint(bound));return tex;
+    }
+    void clear() {
+        for(auto& g:glyphs)for(auto& orientation:g.textures)for(auto& tex:orientation){if(tex)glDeleteTextures(1,&tex);tex=0;}
+        for(GLuint tex:retired)glDeleteTextures(1,&tex);
+        retired.clear();candidates.clear();
+    }
+};
+inline MomTextures& mom_textures(){static MomTextures textures;return textures;}
+}
diff --git a/nWiiRuntime/include/runtime/native_ram_write_watch_mom.h b/nWiiRuntime/include/runtime/native_ram_write_watch_mom.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_ram_write_watch_mom.h
@@ -0,0 +1,55 @@
+#pragma once
+// NATIVE_MOM_RAM_WRITE_WATCH_V1: OS write-watch generations shared by all
+// overlapping ranges. A failed query always makes callers compare bytes.
+#include <windows.h>
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+namespace nwii::runtime::native_ram_watch {
+struct Result { bool ok; uint64_t newest; uint64_t generation; };
+struct Bank {
+  const uint8_t* base = nullptr;
+  size_t pages = 0;
+  bool failed = false;
+  std::vector<uint64_t> stamps;
+};
+inline std::mutex mutex;
+inline uint64_t generation = 1;
+inline Bank banks[4];
+
+inline Result query(const uint8_t* base, size_t bank_bytes, size_t offset, size_t bytes) {
+  if (!base || !bytes || offset >= bank_bytes || bytes > bank_bytes - offset)
+    return {false, 0, 0};
+  std::lock_guard<std::mutex> lock(mutex);
+  Bank* bank = nullptr;
+  for (auto& candidate : banks) if (candidate.base == base) { bank = &candidate; break; }
+  if (!bank) for (auto& candidate : banks) if (!candidate.base) {
+    bank = &candidate; bank->base = base; bank->pages = (bank_bytes + 4095) / 4096;
+    bank->stamps.assign(bank->pages, 0); break;
+  }
+  if (!bank || bank->failed || bank->pages != (bank_bytes + 4095) / 4096)
+    return {false, 0, 0};
+  const size_t first = offset / 4096, last = (offset + bytes - 1) / 4096;
+  static thread_local std::vector<void*> pages;
+  pages.resize(last - first + 1);
+  ULONG_PTR count = pages.size();
+  DWORD granularity = 0;
+  if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, const_cast<uint8_t*>(base) + first * 4096,
+                    (last - first + 1) * 4096, pages.data(), &count, &granularity) != 0 ||
+      granularity != 4096) {
+    bank->failed = true;
+    return {false, 0, 0};
+  }
+  if (count) {
+    const uint64_t stamp = ++generation;
+    for (ULONG_PTR i = 0; i < count; ++i)
+      bank->stamps[(static_cast<const uint8_t*>(pages[i]) - base) / 4096] = stamp;
+  }
+  uint64_t newest = 0;
+  for (size_t page = first; page <= last; ++page)
+    newest = std::max(newest, bank->stamps[page]);
+  return {true, newest, generation};
+}
+}
diff --git a/nWiiRuntime/include/runtime/native_render_queue.h b/nWiiRuntime/include/runtime/native_render_queue.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_render_queue.h
@@ -0,0 +1,89 @@
+#pragma once
+// NATIVE_RENDER_QUEUE_V1: bounded, in-order hand-off from one producer thread (the main thread: drain servicing and frame
+// submission) to one executor thread (the GL thread, which owns the context). See tools/fix_render_queue.py.
+//
+// Item k lives in slot k % capacity. The producer may write slot k only after item k - capacity has completed, so an
+// executing item and a slot being filled never share storage. Publishing and completing both happen under the mutex, so
+// everything the producer wrote before Publish() is visible to the executor, and everything the executor wrote before
+// it completed is visible to the producer's next Acquire().
+#include <condition_variable>
+#include <cstddef>
+#include <functional>
+#include <mutex>
+#include <vector>
+
+namespace nwii::runtime::native_render_queue {
+
+template <class Item>
+class OrderedQueue {
+public:
+    explicit OrderedQueue(size_t capacity) : slots_(capacity ? capacity : 1) {}
+
+    // Producer: waits until a slot is free and returns it. Only the producer touches it until Publish().
+    Item& Acquire() {
+        std::unique_lock<std::mutex> lock(mutex_);
+        space_.wait(lock, [&] { return published_ - done_ < slots_.size(); });
+        return slots_[published_ % slots_.size()];
+    }
+
+    // Producer: hands the slot returned by the last Acquire() to the executor.
+    void Publish() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            ++published_;
+        }
+        work_.notify_one();
+    }
+
+    // Producer: waits until every published item has completed. The executor is then idle until the next Publish().
+    void Flush() {
+        std::unique_lock<std::mutex> lock(mutex_);
+        idle_.wait(lock, [&] { return done_ == published_; });
+    }
+
+    // Executor thread: runs items in order. Returns after Stop() once nothing is left to run.
+    void Run(const std::function<void(Item&)>& execute) {
+        for (;;) {
+            size_t k = 0;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                work_.wait(lock, [&] { return stop_ || done_ < published_; });
+                if (done_ == published_) return;
+                k = done_;
+            }
+            execute(slots_[k % slots_.size()]); // unlocked: the producer does not reuse this slot until done_ moves past it
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                ++done_;
+            }
+            space_.notify_one();
+            idle_.notify_all();
+        }
+    }
+
+    // Any thread: ask Run() to return once the queue is empty.
+    void Stop() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stop_ = true;
+        }
+        work_.notify_all();
+    }
+
+    size_t Capacity() const { return slots_.size(); }
+
+    // Items published and not yet completed. Only meaningful as a snapshot.
+    size_t InFlight() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return published_ - done_;
+    }
+
+private:
+    std::vector<Item> slots_;
+    std::mutex mutex_;
+    std::condition_variable work_, space_, idle_;
+    size_t published_ = 0, done_ = 0;
+    bool stop_ = false;
+};
+
+} // namespace nwii::runtime::native_render_queue
diff --git a/nWiiRuntime/include/runtime/native_resolution.h b/nWiiRuntime/include/runtime/native_resolution.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_resolution.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <glad/glad.h>
+#include <algorithm>
+#include <cstdio>
+
+// Shared host-only state. All guest GX addresses, rectangles and texture sizes
+// remain in native coordinates; scale is chosen once after GL initialization.
+inline int& NativeResolutionScaleStorage() { static int scale=1;return scale; }
+inline int NativeResolutionScale() { return NativeResolutionScaleStorage(); }
+inline int NativeEfbWidth() { return 640*NativeResolutionScale(); }
+inline int NativeEfbHeight() { return 528*NativeResolutionScale(); }
+inline void NativeSetResolutionScale(int requested) {
+  GLint texture=0,renderbuffer=0;
+  glGetIntegerv(GL_MAX_TEXTURE_SIZE,&texture);
+  glGetIntegerv(GL_MAX_RENDERBUFFER_SIZE,&renderbuffer);
+  const int supported=std::max(1,std::min({4,texture/640,renderbuffer/640}));
+  NativeResolutionScaleStorage()=std::clamp(requested,1,supported);
+  std::printf("[Resolution] requested=%d scale=%d EFB=%dx%d\n",requested,
+      NativeResolutionScale(),NativeEfbWidth(),NativeEfbHeight());
+}
+
+// Diagnostic reads retain native-sized arrays even when the EFB is larger.
+// Game presentation and screenshots read full-sized completed XFBs directly.
+inline void NativeReadEfbPixels(int x,int y,int width,int height,GLenum format,GLenum type,void* pixels) {
+  const int scale=NativeResolutionScale();
+  if(scale==1) {glReadPixels(x,y,width,height,format,type,pixels);return;}
+  GLint draw=0,read=0,binding=0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&draw);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&read);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D,&binding);
+  const GLboolean scissor=glIsEnabled(GL_SCISSOR_TEST);
+  static GLuint fbo=0,texture=0;static int old_width=0,old_height=0;
+  if(!fbo) {glGenFramebuffers(1,&fbo);glGenTextures(1,&texture);}
+  glBindTexture(GL_TEXTURE_2D,texture);
+  if(width!=old_width || height!=old_height) {
+    glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA8,width,height,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
+    old_width=width;old_height=height;
+  }
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,fbo);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,texture,0);
+  glDisable(GL_SCISSOR_TEST);
+  glBlitFramebuffer(x*scale,y*scale,(x+width)*scale,(y+height)*scale,
+                    0,0,width,height,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,fbo);
+  glReadPixels(0,0,width,height,format,type,pixels);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,GLuint(draw));
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,GLuint(read));
+  glBindTexture(GL_TEXTURE_2D,GLuint(binding));
+  if(scissor)glEnable(GL_SCISSOR_TEST);
+}
diff --git a/nWiiRuntime/include/runtime/native_savestate.h b/nWiiRuntime/include/runtime/native_savestate.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_savestate.h
@@ -0,0 +1,68 @@
+// NATIVE_SAVESTATE_V1: snapshot of guest-visible state at a dispatcher boundary (run_game loop head).
+//
+// At that point no host frame holds guest state: callbacks and thread switches unwind to run_game, so the CPU context and guest
+// memory are complete. Each device module owns one function that both writes and reads its file-scope state through Stream
+// (symmetric serialization) and, when loading, re-arms the scheduler events its saved registers imply. ios.cpp orchestrates.
+//
+// Saving waits for a quiet point: no callback in flight or queued, no IPC/DI/ARAM transfer pending, the DSP idle and the GX FIFO
+// drained by the render thread. Loading happens at the first dispatcher step after a normal boot, before guest code runs, so all
+// host devices are freshly initialised and the scheduler is empty.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace native_ss {
+
+inline constexpr uint32_t kFormat = 1;   // launcher savestates.rs FORMAT
+
+struct Stream {
+  bool loading = false;
+  std::vector<uint8_t> buf;
+  size_t pos = 0;
+
+  void raw(void* p, size_t n) {
+    if (loading) {
+      if (n > buf.size() - pos) throw std::runtime_error("save state is truncated");
+      std::memcpy(p, buf.data() + pos, n); pos += n;
+    } else {
+      const auto* b = static_cast<const uint8_t*>(p);
+      buf.insert(buf.end(), b, b + n);
+    }
+  }
+  template <class T> void pod(T& v) { static_assert(std::is_trivially_copyable_v<T>); raw(&v, sizeof v); }
+  template <class T> void atom(std::atomic<T>& a) { T v = a.load(); pod(v); if (loading) a.store(v); }
+  void str(std::string& s) {
+    uint32_t n = uint32_t(s.size()); pod(n);
+    if (loading) { if (n > (64u << 20)) throw std::runtime_error("save state string too long"); s.resize(n); }
+    if (n) raw(s.data(), n);
+  }
+  template <class T> void vec(std::vector<T>& v) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    uint32_t n = uint32_t(v.size()); pod(n);
+    if (loading) { if (uint64_t(n) * sizeof(T) > buf.size() - pos) throw std::runtime_error("save state vector too long"); v.resize(n); }
+    if (n) raw(v.data(), size_t(n) * sizeof(T));
+  }
+  template <class T> void deq(std::deque<T>& d) { std::vector<T> v(d.begin(), d.end()); vec(v); if (loading) d.assign(v.begin(), v.end()); }
+  // Section marker: a mismatch on load means the file and this runtime disagree about the layout.
+  void tag(const char (&t)[5]) {
+    uint32_t want; std::memcpy(&want, t, 4);
+    uint32_t got = want; pod(got);
+    if (loading && got != want) throw std::runtime_error(std::string("save state section mismatch at ") + t);
+  }
+};
+
+// 1 = save requested (F1 on the host thread), 2 = load requested (NWII_LOAD_STATE at startup). Serviced by the guest thread.
+inline std::atomic<int> request{0};
+
+// Screenshot for the save state's thumbnail: the host thread fills it at its next present after `want` is set.
+struct Thumb { std::mutex mutex; bool want = false, ready = false; std::vector<uint8_t> bmp; };
+inline Thumb thumb;
+
+}  // namespace native_ss
diff --git a/nWiiRuntime/include/runtime/native_shader_cache_io.h b/nWiiRuntime/include/runtime/native_shader_cache_io.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_shader_cache_io.h
@@ -0,0 +1,109 @@
+#pragma once
+// NATIVE_MOM_SHADER_CACHE_IO_V1: bounded filesystem writer for the program
+// binary cache (MoM port of CotT's native_shader_cache_io.h; the include of
+// CotT's native_frame_trace.h becomes this tree's runtime/frame_trace.h).
+// GL binary queries stay on the context owner. This worker only saves owned
+// bytes; it never receives a GL object, game RAM pointer or renderer state.
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include <string>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <cerrno>
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+#include "runtime/frame_trace.h"
+namespace native_shader_cache {
+class Writer {
+ struct Job {std::filesystem::path path;std::array<char,24> header;std::vector<char> data;std::atomic<uint64_t>* successes;};
+ std::mutex mutex;std::condition_variable wake,idle;std::deque<Job> jobs;
+ std::thread thread;size_t bytes=0;bool stopping=false,busy=false;
+ static bool save(const Job& job) {
+  static std::atomic<uint64_t> sequence{0};
+  for (unsigned attempt = 0; attempt < 32; ++attempt) {
+   auto temporary = job.path;
+#ifdef _WIN32
+   temporary += "." + std::to_string(GetCurrentProcessId()) + "." +
+                std::to_string(sequence.fetch_add(1)) + ".tmp";
+   HANDLE file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr,
+                             CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+   if (file == INVALID_HANDLE_VALUE) {
+    if (GetLastError() == ERROR_FILE_EXISTS || GetLastError() == ERROR_ALREADY_EXISTS) continue;
+    return false;
+   }
+   DWORD written = 0;
+   bool ok = WriteFile(file, job.header.data(), DWORD(job.header.size()), &written, nullptr)
+             && written == job.header.size();
+   if (ok) ok = WriteFile(file, job.data.data(), DWORD(job.data.size()), &written, nullptr)
+                && written == job.data.size();
+   if (ok) ok = FlushFileBuffers(file) != 0;
+   if (!CloseHandle(file)) ok = false;
+   if (ok) ok = MoveFileExW(temporary.c_str(), job.path.c_str(),
+                            MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+   if (!ok) DeleteFileW(temporary.c_str()); // This invocation exclusively created it.
+   return ok;
+#else
+   temporary += "." + std::to_string(getpid()) + "." +
+                std::to_string(sequence.fetch_add(1)) + ".tmp";
+   const int file = ::open(temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+   if (file < 0) { if (errno == EEXIST) continue; return false; }
+   auto write_all = [file](const char* data, size_t bytes) {
+    while (bytes) {
+     const auto n = ::write(file, data, bytes);
