diff --git a/nWiiRuntime/include/runtime/native_shader_preload.h b/nWiiRuntime/include/runtime/native_shader_preload.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_shader_preload.h
@@ -0,0 +1,162 @@
+#pragma once
+// NATIVE_SHADER_PRELOAD_V1: GL-free reader for the program binary cache (see tools/fix_shader_preload.py).
+// The worker thread reads and validates <cache>/<16 hex digits>.bin files and hands over owned bytes only.
+// It never calls GL. glProgramBinary and the link check stay on the render thread.
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <system_error>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace native_shader_preload {
+// Layout written by NativeProgramCache::store in renderer_gl.cpp: magic[8], key u64, format u32, length u32, binary.
+inline constexpr char kMagic[8] = {'N', 'W', 'P', 'B', 'C', '0', '0', '1'};
+inline constexpr size_t kHeaderBytes = 24;
+inline constexpr uint32_t kMaxBinaryBytes = 64u << 20; // same bound as the on-demand load
+
+struct Entry {
+  uint64_t key = 0;
+  uint32_t format = 0;
+  std::vector<char> data;
+};
+
+struct Counts {
+  size_t read = 0;     // valid files handed to the render thread queue (taken or still queued)
+  size_t rejected = 0; // unreadable, truncated, mis-named or oversized files
+  size_t skipped = 0;  // valid files left on disk because a bound was reached
+};
+
+inline bool ReadEntry(const std::filesystem::path &path, Entry &entry) {
+  std::ifstream in(path, std::ios::binary);
+  if (!in) return false;
+  char header[kHeaderBytes];
+  in.read(header, kHeaderBytes);
+  if (!in || std::memcmp(header, kMagic, sizeof kMagic) != 0) return false;
+  uint64_t key = 0;
+  uint32_t format = 0, length = 0;
+  std::memcpy(&key, header + 8, 8);
+  std::memcpy(&format, header + 16, 4);
+  std::memcpy(&length, header + 20, 4);
+  if (length == 0 || length > kMaxBinaryBytes) return false;
+  // The file name is the key it was stored under, so a renamed or copied file cannot satisfy another shader.
+  char name[32];
+  std::snprintf(name, sizeof name, "%016llx", static_cast<unsigned long long>(key));
+  if (path.stem().string() != name) return false;
+  std::error_code size_error;
+  const auto file_size = std::filesystem::file_size(path, size_error);
+  if (size_error || file_size != kHeaderBytes + length) return false;
+  entry.key = key;
+  entry.format = format;
+  entry.data.resize(length);
+  in.read(entry.data.data(), std::streamsize(length));
+  return bool(in);
+}
+
+class Loader {
+  std::mutex mutex;
+  std::deque<Entry> ready;
+  size_t queued_bytes = 0;
+  bool finished = false;
+  bool stopping = false;
+  size_t max_entries;
+  size_t max_queued_bytes;
+  Counts counts;
+  std::thread thread;
+
+  void run(std::filesystem::path directory) {
+    std::vector<std::pair<std::filesystem::file_time_type, std::filesystem::path>> files;
+    std::error_code error;
+    for (std::filesystem::directory_iterator it(directory, error), end; !error && it != end; it.increment(error)) {
+      const auto &path = it->path();
+      if (path.extension() != ".bin") continue;
+      std::error_code time_error;
+      const auto stamp = std::filesystem::last_write_time(path, time_error);
+      if (!time_error) files.emplace_back(stamp, path);
+    }
+    // Newest first: the binaries written most recently are the ones the last session compiled last.
+    std::sort(files.begin(), files.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+    for (const auto &file : files) {
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (stopping || counts.read >= max_entries) break;
+      }
+      Entry entry;
+      const bool valid = ReadEntry(file.second, entry);
+      std::lock_guard<std::mutex> lock(mutex);
+      if (stopping) break;
+      if (!valid) {
+        ++counts.rejected;
+        continue;
+      }
+      if (queued_bytes + entry.data.size() > max_queued_bytes) {
+        ++counts.skipped;
+        continue;
+      }
+      queued_bytes += entry.data.size();
+      ready.push_back(std::move(entry));
+      ++counts.read;
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+    finished = true;
+  }
+
+public:
+  // Bounds: entries read in total, and bytes held in the queue waiting for the render thread.
+  explicit Loader(size_t entries = 256, size_t queued_bytes_max = size_t(64) << 20)
+      : max_entries(entries), max_queued_bytes(queued_bytes_max) {}
+  Loader(const Loader &) = delete;
+  Loader &operator=(const Loader &) = delete;
+
+  void start(std::filesystem::path directory) {
+    if (thread.joinable()) return;
+    try {
+      thread = std::thread([this, directory] { run(directory); });
+    } catch (const std::system_error &) {
+      std::lock_guard<std::mutex> lock(mutex);
+      finished = true; // no preload; every shader takes the on-demand path
+    }
+  }
+
+  bool take(Entry &out) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (ready.empty()) return false;
+    out = std::move(ready.front());
+    ready.pop_front();
+    queued_bytes -= out.data.size();
+    return true;
+  }
+
+  // True once the directory scan has ended (the queue may still hold entries).
+  bool scanned() {
+    std::lock_guard<std::mutex> lock(mutex);
+    return finished;
+  }
+
+  // True once the scan has ended and every queued entry has been taken.
+  bool drained() {
+    std::lock_guard<std::mutex> lock(mutex);
+    return finished && ready.empty();
+  }
+
+  Counts snapshot() {
+    std::lock_guard<std::mutex> lock(mutex);
+    return counts;
+  }
+
+  ~Loader() {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      stopping = true;
+    }
+    if (thread.joinable()) thread.join();
+  }
+};
+} // namespace native_shader_preload
diff --git a/nWiiRuntime/include/runtime/native_static_ram_mom.h b/nWiiRuntime/include/runtime/native_static_ram_mom.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_static_ram_mom.h
@@ -0,0 +1,80 @@
+#pragma once
+// NATIVE_STATIC_RAM_MOM_V1 -- guest MEM1 and MEM2 at fixed host virtual addresses.
+//
+// Installed by tools/stages/fix_static_ram_base_mom.py (report: logs/agent-reports/static_ram_base.md).
+//
+// MMU::mem1 and MMU::mem2 keep their names and their data()/size()/operator[] interface, but they are
+// FixedRam objects whose data() is a compile-time constant:
+//     MEM1  host 0x20000000   24 MiB + 8 bytes
+//     MEM2  host 0x30000000   64 MiB + 8 bytes
+// 0x30000000 - 0x10000000 == 0x20000000, so the MEM2 accessors' `mem2.data() + (paddr - 0x10000000)` folds to
+// host [paddr + 0x20000000] as well. The size is a constant too, so a guest access is one bounds compare
+// against an immediate and one disp32 address, instead of loading begin, end and data from the MMU object.
+// Nothing else changes: the +8 padding, every bounds check, the 0x0C sentinel, MMIO, watches and the
+// slow paths keep their existing code.
+//
+// Both banks are committed once, when the MMU is constructed, with VirtualAlloc(MEM_RESERVE | MEM_COMMIT)
+// at the fixed address. The pages are zero-filled, as the old resize(n, 0) was. The address is a
+// compile-time choice, so if it is already in use the process prints a message and aborts. This build
+// has no run-time fallback. Run the stage with --restore to get the std::vector banks back.
+//
+// This header is Windows-only (VirtualAlloc). cpu_context.h already includes <windows.h> through
+// native_idle_wait.h before it reaches this header, so no extra Windows macros are introduced here.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+#if !defined(_WIN32)
+#error "NATIVE_STATIC_RAM_MOM_V1 needs Windows VirtualAlloc. Restore the std::vector banks on other hosts."
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+namespace nwii::runtime::native_static_ram_mom {
+
+inline constexpr uintptr_t kMem1Host = 0x20000000u;
+inline constexpr uintptr_t kMem2Host = 0x30000000u;
+inline constexpr size_t kMem1Bytes = 24u * 1024u * 1024u + 8u;
+inline constexpr size_t kMem2Bytes = 64u * 1024u * 1024u + 8u;
+
+// A RAM bank whose base is a compile-time constant. Same surface the MMU and the span proofs use on a vector.
+template <uintptr_t Host, size_t Bytes>
+struct FixedRam {
+  uint8_t *data() const { return reinterpret_cast<uint8_t *>(Host); }
+  static constexpr size_t size() { return Bytes; }
+  uint8_t &operator[](size_t index) const { return data()[index]; }
+};
+
+using Mem1Ram = FixedRam<kMem1Host, kMem1Bytes>;
+using Mem2Ram = FixedRam<kMem2Host, kMem2Bytes>;
+
+// Commits [base, base + bytes) once per process. A second MMU in the same process (test fixtures) finds its
+// bank already committed and reuses it, so the bank is never aliased and never committed twice.
+inline void Commit(uintptr_t base, size_t bytes) {
+  static uintptr_t placed[4] = {};
+  static unsigned count = 0;
+  for (unsigned i = 0; i < count; ++i) {
+    if (placed[i] == base) return;
+  }
+  // NATIVE_MOM_RAM_WRITE_WATCH_V1: allocation falls back without tracking.
+  void *mapped = VirtualAlloc(reinterpret_cast<void *>(base), bytes, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH, PAGE_READWRITE);
+  if (!mapped)
+    mapped = VirtualAlloc(reinterpret_cast<void *>(base), bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+  if (mapped != reinterpret_cast<void *>(base)) {
+    const unsigned long error = static_cast<unsigned long>(GetLastError());
+    std::fprintf(stderr,
+                 "[StaticRAM] cannot commit guest RAM at 0x%llx (error %lu). Another module owns that address and "
+                 "the fixed base is chosen at compile time. Run tools/stages/fix_static_ram_base_mom.py --restore "
+                 "to return to the dynamic std::vector banks.\n",
+                 static_cast<unsigned long long>(base), error);
+    std::fflush(stderr);
+    std::abort();
+  }
+  if (count < 4) placed[count++] = base;
+}
+
+}  // namespace nwii::runtime::native_static_ram_mom
diff --git a/nWiiRuntime/include/runtime/native_used_texture_mask_mom.h b/nWiiRuntime/include/runtime/native_used_texture_mask_mom.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_used_texture_mask_mom.h
@@ -0,0 +1,39 @@
+// Conservative used-texture-slot mask for MoM's GenerateTEVShader emission.
+// Mirrors the CotT staged helper: primary TEV texMap slots plus indirect
+// texture maps the TEV configuration can reach; invalid inputs fail closed to
+// 0xff (all slots bound).  Used by the texture-bind loop to skip sampler work
+// for slots no generated shader reads, and by the XF boundary check.
+#pragma once
+#include "runtime/gx_state.h"
+
+namespace nwii::runtime::gx {
+
+// Settled conservative mask:
+//  - one bit per TEV stage's primary texMap (0xff decodes as map 0);
+//  - indirect texture bits for each configured stage whose selected indirect
+//    order is within the available count and has a matrix or bump scale;
+//  - any invalid map (>=8) or count (>16) fails closed to all slots;
+//  - a USED slot whose texStage base_addr is 0 keeps its bit (it may still
+//    sample the unit's existing bound texture or unit 0 state).
+inline unsigned NativeUsedTextureMask(const GXState& state) {
+  unsigned mask = 0;
+  unsigned count = state.numTevStages ? state.numTevStages : 1;
+  if (count > 16) return 0xff;
+  for (unsigned i = 0; i < count; ++i) {
+    const unsigned map = state.tevStages[i].texMap;
+    if (map != 0xff && map >= 8) return 0xff;
+    mask |= 1u << (map == 0xff ? 0 : map);
+    const uint32_t config = state.bp[0x10 + i];
+    const unsigned selected = config & 3;
+    if (selected < ((state.bp[0] >> 16) & 7) &&
+        ((config >> 9) & 3 || (config >> 7) & 3))
+      mask |= 1u << ((state.bp[0x27] >> (selected * 6)) & 7);
+  }
+  for (unsigned unit = 1; unit < 8; ++unit)
+    if ((mask >> unit) & 1 && state.texStages[unit].base_addr == 0)
+      mask |= 1u; // keep unit 0 as the fallback alias - a used slot with no
+    // base_addr still samples whatever is bound there, so keep slot 0 bound
+  return mask;
+}
+
+} // namespace nwii::runtime::gx
