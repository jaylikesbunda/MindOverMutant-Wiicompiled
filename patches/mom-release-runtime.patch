+      case 0x34: // SI_COM_CSR: TSTART is write-only; reads see transfer complete.
+        return si_reg[off / 4] & ~1u;
+      default:
+        return si_reg[off / 4];
+    }
+  };
+  auto write = [](uint32_t addr, uint32_t value) {
+    uint32_t off = (addr & 0xFF) & ~3u;
+    switch (off) {
+      case 0x34: // SI_COM_CSR: TSTART self-clears; TCINT/RDSTINT are W1C.
+        si_reg[off / 4] = value & ~1u;
+        break;
+      case 0x38: { // SI_STATUS: UNRUN/OVRUN/COLL/NOREP are W1C, WR self-clears.
