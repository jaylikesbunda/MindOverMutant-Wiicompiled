+// NATIVE_MOM_PACKED_VERTICES_V1: (re)point the attribute pointers for the bound buffer's
+// layout.  Locations: 0 pos3F, 1 colour (byte+normalised packed / float),
+// 2 uv2F, 3 normal3F, 4 colour1 same, 5..12 texgen3F.  The shadow guards the
+// reprogram; a layout or buffer swap always reprograms.
+// NATIVE_MOM_PERSISTENT_UPLOAD_V1: opt-in persistent upload.  Strict '1' only.
+static const bool s_persist_wanted = [] {
