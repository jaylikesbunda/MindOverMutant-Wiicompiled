+    if (selected < indirect && (((config >> 9) & 3) || ((config >> 7) & 3))) {
+      const unsigned order = (state.bp[0x27] >> (selected * 6)) & 63;
+      const unsigned lane = order >> 3;
+      if (lane + 1 > lanes) lanes = lane + 1;
+    }
