+  if (window_s < 3.0) return;
+  const double total_s = double(now - report_start_ns) / 1e9;
+  std::printf("[BATCH] t=%.1fs window=%.1fs draws=%llu submissions=%llu "
+              "per_draw=%.3f merge=%.2fx verts=%llu req=%llu empty=%llu | "
+              "run draws=%llu submissions=%llu per_draw=%.3f verts=%llu\n",
