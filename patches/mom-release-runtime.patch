+
+    int* wm_main0;
+    int* wm_aux0;
+    int* wm_main1;
+    int* wm_aux1;
+    int* wm_main2;
+    int* wm_aux2;
+    int* wm_main3;
+    int* wm_aux3;
+#endif
+  };
+
+#ifdef AX_GC
+  int* ptrs[9];
+#else
+  struct
+  {
