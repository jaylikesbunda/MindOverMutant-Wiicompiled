+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},
+    {0x00, 0x00, 0x00, 0x00, 0x00},  // 122 'z'
+    {0x00, 0x08, 0x36, 0x41, 0x00},  // 123 '{'
+    {0x00, 0x00, 0x7F, 0x00, 0x00},  // 124 '|'
+    {0x00, 0x41, 0x36, 0x08, 0x00},  // 125 '}'
+    {0x08, 0x04, 0x08, 0x10, 0x08},  // 126 '~'
+};
+
+// Cell 95 of the atlas (code 127) is a solid block: rectangles reuse the text
+// batch instead of adding a second draw path.
+inline constexpr int kCellW = 6, kCellH = 8, kGlyphW = 5, kGlyphH = 7;
+
+struct Font {
+  GLuint tex = 0;
+  bool ok = false;
+};
+inline Font font;
+inline int text_scale = 2;
+
+inline bool init_font() {
+  if (font.ok) return true;
+  const int W = 96 * kCellW, H = kCellH;
+  std::vector<unsigned char> pix(size_t(W) * size_t(H), 0);
+  for (int c = 32; c < 127; ++c) {
+    const unsigned char *g = kFont[c - 32];
+    const int cx = (c - 32) * kCellW;
+    for (int x = 0; x < kGlyphW; ++x)
+      for (int y = 0; y < kGlyphH; ++y)
+        if (g[x] & (1u << y)) pix[size_t(y) * size_t(W) + size_t(cx + x)] = 255;
+  }
+  for (int y = 0; y < kGlyphH; ++y)
+    for (int x = 0; x < kGlyphW; ++x)
+      pix[size_t(y) * size_t(W) + size_t(95 * kCellW + x)] = 255;
+  GLint unpack = 4;
+  glGetIntegerv(GL_UNPACK_ALIGNMENT, &unpack);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  GLint bound = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+  glGenTextures(1, &font.tex);
+  glBindTexture(GL_TEXTURE_2D, font.tex);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, W, H, 0, GL_RED, GL_UNSIGNED_BYTE, pix.data());
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glBindTexture(GL_TEXTURE_2D, GLuint(bound));
+  glPixelStorei(GL_UNPACK_ALIGNMENT, unpack);
+  font.ok = true;
+  return true;
+}
+
+struct Gpu {
+  GLuint prog = 0, vao = 0, vbo = 0;
+  GLint u_view = -1;
+  bool ready = false;
+};
+inline Gpu gpu;
+
+inline bool init_gpu() {
+  if (gpu.ready) return true;
+  if (!init_font()) return false;
+  const char *vs =
+      "#version 330 core\n"
+      "layout(location=0) in vec2 p; layout(location=1) in vec2 t; layout(location=2) in vec4 c;\n"
+      "uniform vec2 uView; out vec2 vt; out vec4 vc;\n"
+      "void main(){vt=t;vc=c;gl_Position=vec4(p.x/uView.x*2.0-1.0,1.0-p.y/uView.y*2.0,0.0,1.0);}\n";
+  const char *fs =
+      "#version 330 core\n"
+      "uniform sampler2D uTex; in vec2 vt; in vec4 vc; out vec4 o;\n"
+      "void main(){o=vec4(vc.rgb,vc.a*texture(uTex,vt).r);}\n";
+  auto compile = [](GLenum type, const char *src) {
+    GLuint s = glCreateShader(type);
+    glShaderSource(s, 1, &src, nullptr);
+    glCompileShader(s);
+    return s;
+  };
+  GLuint v = compile(GL_VERTEX_SHADER, vs), f = compile(GL_FRAGMENT_SHADER, fs);
+  gpu.prog = glCreateProgram();
+  glAttachShader(gpu.prog, v);
+  glAttachShader(gpu.prog, f);
+  glLinkProgram(gpu.prog);
+  glDeleteShader(v);
+  glDeleteShader(f);
+  GLint ok = 0;
+  glGetProgramiv(gpu.prog, GL_LINK_STATUS, &ok);
+  if (!ok) return false;
+  gpu.u_view = glGetUniformLocation(gpu.prog, "uView");
+  GLint vao = 0, vbo = 0;
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+  glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &vbo);
+  glGenVertexArrays(1, &gpu.vao);
+  glBindVertexArray(gpu.vao);
+  glGenBuffers(1, &gpu.vbo);
+  glBindBuffer(GL_ARRAY_BUFFER, gpu.vbo);
+  const GLsizei stride = 8 * sizeof(float);
+  glEnableVertexAttribArray(0);
+  glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, stride, (void *)0);
+  glEnableVertexAttribArray(1);
+  glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, stride, (void *)(2 * sizeof(float)));
+  glEnableVertexAttribArray(2);
+  glVertexAttribPointer(2, 4, GL_FLOAT, GL_FALSE, stride, (void *)(4 * sizeof(float)));
+  glBindVertexArray(GLuint(vao));
+  glBindBuffer(GL_ARRAY_BUFFER, GLuint(vbo));
+  gpu.ready = true;
+  return true;
+}
+
+struct Canvas {
+  std::vector<float> v;
+  void quad(float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1, const float c[4]) {
+    const float q[6][8] = {{x0, y0, u0, v0, c[0], c[1], c[2], c[3]},
+                           {x1, y0, u1, v0, c[0], c[1], c[2], c[3]},
+                           {x1, y1, u1, v1, c[0], c[1], c[2], c[3]},
+                           {x0, y0, u0, v0, c[0], c[1], c[2], c[3]},
+                           {x1, y1, u1, v1, c[0], c[1], c[2], c[3]},
+                           {x0, y1, u0, v1, c[0], c[1], c[2], c[3]}};
+    const size_t begin = v.size();
+    v.resize(begin + 48);
+    std::memcpy(v.data() + begin, q, sizeof(q));
+  }
+  void rect(float x0, float y0, float x1, float y1, const float c[4]) {
+    const float W = float(96 * kCellW), H = float(kCellH);
+    const float u = (95.f * kCellW + kGlyphW * 0.5f) / W, w = kGlyphH * 0.5f / H;
+    quad(x0, y0, x1, y1, u, w, u, w, c);
+  }
+  float text(float x, float y, const std::string &s, const float c[4]) {
+    const float W = float(96 * kCellW), H = float(kCellH);
+    const float cw = float(kCellW * text_scale);
+    const float gw = float(kGlyphW * text_scale), gh = float(kGlyphH * text_scale);
+    for (char raw : s) {
+      int code = static_cast<unsigned char>(raw);
+      if (code >= 'a' && code <= 'z') code -= 32;   // the atlas holds upper case
+      if (code < 32 || code > 126) code = ' ';
+      if (code != ' ') {
+        const float u0 = float((code - 32) * kCellW) / W;
+        quad(x, y, x + gw, y + gh, u0, 0.f, u0 + float(kGlyphW) / W, float(kGlyphH) / H, c);
+      }
+      x += cw;
+    }
+    return x;
+  }
+};
+
+// ---------------------------------------------------------------------------
+// Frame history. The frame is one iteration of the host render loop, exactly
+// what native_perf_phase::frame_end() records, so the percentiles are the same
+// quantity as [PERFPHASE] frame_ms and its CSV.
+// ---------------------------------------------------------------------------
+inline constexpr unsigned kRing = 256;
+inline constexpr unsigned kWindow = 240;   // the window [PERFPHASE] uses
+inline uint64_t ring_ns[kRing] = {};
+inline unsigned ring_n = 0;
+inline uint64_t last_stamp_ns = 0;
+inline uint64_t last_index = 0;      // native_perf_phase::frame_index already consumed
+inline uint64_t frame_calls = 0;
+inline uint64_t presents = 0, fresh_frames = 0, copies_now = 0;
+inline uint64_t worst_ns = 0, worst_index = ~uint64_t(0);
+
+inline bool is_stall(unsigned p) {
+  return p == native_perf_phase::Phase_HostField ||
+         p == native_perf_phase::Phase_HostDrainWait ||
+         p == native_perf_phase::Phase_GuestIdle;
+}
+
+// Total()/Hits() take the enum; the tables are indexed by its ordinal.
+inline native_perf_phase::Phase phase_of(unsigned p) {
+  return native_perf_phase::Phase(p);
+}
+
+struct Snapshot {
+  double window_s = 0, frames = 0;
+  double new_fps = 0, present_fps = 0, xfb_fps = 0;
+  double avg_ms = 0, p50_ms = 0, p95_ms = 0, p99_ms = 0, max_ms = 0;
+  unsigned late = 0, samples = 0;
+  bool phases = false;
+  double phase_ms[Phase_Count] = {};
+  double phase_calls[Phase_Count] = {};
+  double host_sum_ms = 0, busy_pct = 0;
+  double guest_cpu_ms_s = 0, draws_per_frame = 0;
+  double worst_ms = 0;
+  uint64_t worst_index = ~uint64_t(0);
+  std::vector<double> recent;   // chronological, ms
+  bool valid = false;
+};
+inline Snapshot current;
+
+inline uint64_t snap_stamp = 0, snap_frames = 0, snap_presents = 0, snap_fresh = 0;
+inline uint64_t snap_copies = 0, snap_draws = 0, snap_guest_cpu = 0;
+inline uint64_t snap_phase[Phase_Count] = {};
+inline uint64_t snap_hits[Phase_Count] = {};
+
+inline void take_baseline() {
+  snap_stamp = native_perf_phase::now_ns();
+  snap_frames = frame_calls;
+  snap_presents = presents;
+  snap_fresh = fresh_frames;
+  snap_copies = nwii::runtime::gx::NativeXfbCopyCount();
+  snap_draws = g_stat_draws;
+  snap_guest_cpu = native_perf_phase::guest_cpu_us();
+  for (unsigned p = 0; p < Phase_Count; ++p) {
+    snap_phase[p] = native_perf_phase::Total(phase_of(p));
+    snap_hits[p] = native_perf_phase::Hits(phase_of(p));
+  }
+}
+
+inline bool compute(Snapshot &s) {
+  if (!snap_stamp) return false;
+  const uint64_t now = native_perf_phase::now_ns();
+  const double win = double(now - snap_stamp) / 1e9;
+  if (win < 0.45) return false;
+  const double df = double(frame_calls - snap_frames);
+  if (df < 1.0) return false;
+  Snapshot r;
+  r.window_s = win;
+  r.frames = df;
+  copies_now = nwii::runtime::gx::NativeXfbCopyCount();
+  r.new_fps = double(fresh_frames - snap_fresh) / win;
+  r.present_fps = double(presents - snap_presents) / win;
+  r.xfb_fps = double(copies_now - snap_copies) / win;
+  r.draws_per_frame = double(g_stat_draws - snap_draws) / df;
+  r.guest_cpu_ms_s = double(native_perf_phase::guest_cpu_us() - snap_guest_cpu) / 1000.0 / win;
+  r.phases = native_perf_phase::enabled;
+  for (unsigned p = 0; p < Phase_Count; ++p) {
+    r.phase_ms[p] = double(native_perf_phase::Total(phase_of(p)) - snap_phase[p]) / 1e6 / df;
+    r.phase_calls[p] = double(native_perf_phase::Hits(phase_of(p)) - snap_hits[p]) / df;
+  }
+  r.host_sum_ms = r.phase_ms[native_perf_phase::Phase_GxParse] +
+                  r.phase_ms[native_perf_phase::Phase_GxDecode] +
+                  r.phase_ms[native_perf_phase::Phase_GlRender] +
+                  r.phase_ms[native_perf_phase::Phase_XfbCopy] +
+                  r.phase_ms[native_perf_phase::Phase_Present] +
+                  r.phase_ms[native_perf_phase::Phase_Swap];
+  r.busy_pct = budget_ms > 0.0 ? 100.0 * r.host_sum_ms / budget_ms : 0.0;
+  const unsigned n = std::min<unsigned>(ring_n, kWindow);
+  r.recent.clear();
+  r.recent.reserve(n);
+  for (unsigned i = 0; i < n; ++i)
+    r.recent.push_back(double(ring_ns[(ring_n - n + i) % kRing]) / 1e6);
+  r.late = 0;
+  for (double ms : r.recent)
+    if (ms > late_ms) ++r.late;
+  r.samples = n;
+  if (!r.recent.empty()) {
+    std::vector<double> v = r.recent;
+    std::sort(v.begin(), v.end());
+    double sum = 0;
+    for (double x : v) sum += x;
+    auto pct = [&v](double p) { return v[std::min<size_t>(v.size() - 1, size_t(p * (v.size() - 1) + 0.5))]; };
+    r.avg_ms = sum / double(v.size());
+    r.p50_ms = pct(0.5);
+    r.p95_ms = pct(0.95);
+    r.p99_ms = pct(0.99);
+    r.max_ms = v.back();
+  }
+  r.worst_ms = double(worst_ns) / 1e6;
+  r.worst_index = worst_index;
+  r.valid = true;
+  s = r;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Entry points used by the host loop.
+// ---------------------------------------------------------------------------
+inline void frame() {                       // once per host loop iteration
+  if (!on.load(std::memory_order_relaxed)) return;
+  uint64_t dt = 0, index = ~uint64_t(0);
+  if (native_perf_phase::enabled && native_perf_phase::frame_index > last_index) {
+    // The phase timers just closed this frame's record: use it. That wall_ns is
+    // exactly the frame_ms column [PERFPHASE] and perf_report.py read, so the
+    // percentiles here are the same series, not a second measurement of it.
+    index = native_perf_phase::frame_index - 1;
+    dt = native_perf_phase::ring[index % native_perf_phase::kFrameRing].wall_ns;
+    last_index = native_perf_phase::frame_index;
+    last_stamp_ns = 0;
+  } else {
+    // No phase timers: the host loop period is the frame time.
+    const uint64_t t = native_perf_phase::now_ns();
+    if (!last_stamp_ns) {
+      last_stamp_ns = t;
+      return;
+    }
+    dt = t - last_stamp_ns;
+    last_stamp_ns = t;
+  }
+  ring_ns[ring_n % kRing] = dt;
+  ++ring_n;
+  ++frame_calls;
+  if (dt >= worst_ns) {
+    worst_ns = dt;
+    worst_index = index;
+  }
+}
+
+inline void present(bool fresh) {            // once per presented field
+  if (!on.load(std::memory_order_relaxed)) return;
+  ++presents;
+  if (fresh) ++fresh_frames;
+}
+
+// ---------------------------------------------------------------------------
+// Panel text. One source of truth: draw() renders these lines and F4 writes
+// the same lines to the .txt file.
+// ---------------------------------------------------------------------------
+inline std::string pct_text(unsigned part, unsigned whole) {
+  return whole ? fmt("%.1f%%", 100.0 * double(part) / double(whole)) : std::string("--");
+}
+
+inline std::vector<std::string> header_lines(const Snapshot &s) {
+  std::vector<std::string> L;
+  L.push_back("DEV STATS    F3 hide   F4 export   F9 reset");
+  if (!s.valid) {
+    L.push_back("collecting the first window...");
+    return L;
+  }
+  L.push_back(fmt("new %5.1f/s   present %5.1f/s   xfb %5.1f/s   budget %5.2f ms",
+                  s.new_fps, s.present_fps, s.xfb_fps, budget_ms));
+  L.push_back(fmt("frame ms  avg %5.2f  p50 %5.2f  p95 %5.2f  p99 %5.2f  max %5.2f",
+                  s.avg_ms, s.p50_ms, s.p95_ms, s.p99_ms, s.max_ms));
+  L.push_back(fmt("          over %5.2f ms: %u of %u frames (%s)",
+                  late_ms, s.late, s.samples, pct_text(s.late, s.samples).c_str()));
+  return L;
+}
+
+inline std::vector<std::string> body_lines(const Snapshot &s) {
+  std::vector<std::string> L;
+  if (!s.valid) return L;
+  if (!s.phases) {
+    L.push_back("phases off - run with NWII_PERF_PHASE=1 to time the nine host phases");
+  } else {
+    L.push_back(fmt("phases ms/frame   host_sum %5.2f   busy %5.1f%%   window %.2fs / %.0f frames",
+                    s.host_sum_ms, s.busy_pct, s.window_s, s.frames));
+    for (unsigned p = 0; p < Phase_Count; ++p) {
+      const double per_call = s.phase_calls[p] > 0.0 ? 1000.0 * s.phase_ms[p] / s.phase_calls[p] : 0.0;
+      L.push_back(fmt("  %-16s %6.2f ms  %5.1f x/frame  %6.1f us/call%s",
+                      native_perf_phase::phase_name(p), s.phase_ms[p], s.phase_calls[p], per_call,
+                      is_stall(p) ? "  stall" : ""));
+    }
+  }
+  if (s.worst_index != ~uint64_t(0) && native_perf_phase::enabled &&
+      s.worst_index < native_perf_phase::frame_index) {
+    const native_perf_phase::FrameRecord &r = native_perf_phase::ring[s.worst_index % native_perf_phase::kFrameRing];
+    std::string line = fmt("worst frame %6.2f ms:", s.worst_ms);
+    for (unsigned p = 0; p < Phase_Count; ++p)
+      line += fmt(" %s %.1f", native_perf_phase::phase_name(p), double(r.phase_ns[p]) / 1e6);
+    L.push_back(line);
+  } else {
+    L.push_back(fmt("worst frame %6.2f ms (no phase record: NWII_PERF_PHASE=1)", s.worst_ms));
+  }
+  L.push_back(fmt("gx frames %llu   draws %llu (%.1f/frame)   shaders %llu   guest cpu %.0f ms/s",
+                  (unsigned long long)g_stat_frames, (unsigned long long)g_stat_draws,
+                  s.draws_per_frame, (unsigned long long)nwii_stat_shaders(), s.guest_cpu_ms_s));
+  L.push_back(info);
+  return L;
+}
+
+// ---------------------------------------------------------------------------
+// F4: txt + json snapshot under logs/ (or NWII_DEV_HUD_DIR).
+// ---------------------------------------------------------------------------
+inline void export_snapshot() {
+  Snapshot s = current;
+  if (!compute(s)) s = current;
+  if (!s.valid) {
+    toast = "no window yet - press F3 and let a few frames run";
+    toast_until = native_perf_phase::now_ns() + 3000000000ull;
+    std::printf("[DEVHUD] %s\n", toast.c_str());
+    std::fflush(stdout);
+    return;
+  }
+  const char *dir_env = std::getenv("NWII_DEV_HUD_DIR");
+  const std::string dir = (dir_env && *dir_env) ? dir_env : "logs";
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  std::time_t now = std::time(nullptr);
+  char stamp[32];
+  std::strftime(stamp, sizeof stamp, "%Y%m%d-%H%M%S", std::localtime(&now));
+  const std::string base = dir + "/dev-hud-" + stamp;
+
+  std::string text = "MoM native port - developer HUD snapshot (F3 overlay, F4 export)\n";
+  text += info + "\n";
+  text += fmt("window %.2fs, %.0f frames, budget %.3f ms, late threshold %.2f ms\n\n",
+              s.window_s, s.frames, budget_ms, late_ms);
+  for (const std::string &l : header_lines(s)) text += l + "\n";
+  text += "\n";
+  for (const std::string &l : body_lines(s)) text += l + "\n";
+  text += "\nframe_ms history (oldest first, " + std::to_string(s.recent.size()) + " frames):\n";
+  for (size_t i = 0; i < s.recent.size(); ++i) {
+    text += fmt(i ? " %.2f" : "%.2f", s.recent[i]);
+    if ((i + 1) % 16 == 0) text += "\n";
+  }
+  text += "\ncross-check: the same frame intervals are the frame_ms column of the\n";
+  text += "NWII_PERF_PHASE_FILE csv; python logs/perf_report.py prints its p95/max.\n";
+
+  std::string json = "{\"schema\":1,\"marker\":\"NATIVE_MOM_DEV_HUD_V1\"";
+  json += ",\"timing_source\":\"native_perf_phase\"";
+  json += ",\"info\":\"" + info + "\"";
+  json += fmt(",\"budget_ms\":%.3f,\"late_ms\":%.3f,\"late_frames\":%u,\"late_samples\":%u",
+              budget_ms, late_ms, s.late, s.samples);
+  json += fmt(",\"window_s\":%.3f,\"frames\":%.0f", s.window_s, s.frames);
+  json += fmt(",\"new_fps\":%.3f,\"present_fps\":%.3f,\"xfb_fps\":%.3f",
+              s.new_fps, s.present_fps, s.xfb_fps);
+  json += fmt(",\"frame_ms\":{\"avg\":%.3f,\"p50\":%.3f,\"p95\":%.3f,\"p99\":%.3f,\"max\":%.3f}",
+              s.avg_ms, s.p50_ms, s.p95_ms, s.p99_ms, s.max_ms);
+  json += fmt(",\"phases_available\":%s,\"host_sum_ms\":%.3f,\"busy_pct\":%.2f",
+              s.phases ? "true" : "false", s.host_sum_ms, s.busy_pct);
+  json += fmt(",\"work\":{\"gx_frames\":%llu,\"draws\":%llu,\"draws_per_frame\":%.3f,\"shaders\":%llu,\"guest_cpu_ms_s\":%.2f}",
+              (unsigned long long)g_stat_frames, (unsigned long long)g_stat_draws,
+              s.draws_per_frame, (unsigned long long)nwii_stat_shaders(), s.guest_cpu_ms_s);
+  json += ",\"phases\":[";
+  for (unsigned p = 0; p < Phase_Count; ++p) {
+    json += fmt("%s{\"name\":\"%s\",\"ms_per_frame\":%.4f,\"calls_per_frame\":%.3f,\"stall\":%s}",
+                p ? "," : "", native_perf_phase::phase_name(p), s.phase_ms[p], s.phase_calls[p],
+                is_stall(p) ? "true" : "false");
+  }
+  json += fmt("],\"worst_frame\":{\"frame_ms\":%.3f,\"has_phase_record\":%s",
+              s.worst_ms,
+              (s.worst_index != ~uint64_t(0) && native_perf_phase::enabled &&
+               s.worst_index < native_perf_phase::frame_index) ? "true" : "false");
+  if (s.worst_index != ~uint64_t(0) && native_perf_phase::enabled &&
+      s.worst_index < native_perf_phase::frame_index) {
+    const native_perf_phase::FrameRecord &r = native_perf_phase::ring[s.worst_index % native_perf_phase::kFrameRing];
+    json += fmt(",\"frame\":%llu,\"wall_ms\":%.3f,\"phase_ms\":[",
+                (unsigned long long)s.worst_index, double(r.wall_ns) / 1e6);
+    for (unsigned p = 0; p < Phase_Count; ++p)
+      json += fmt(p ? ",%.3f" : "%.3f", double(r.phase_ns[p]) / 1e6);
+    json += "]";
+  }
+  json += "},\"frame_ms_history\":[";
+  for (size_t i = 0; i < s.recent.size(); ++i) json += fmt(i ? ",%.3f" : "%.3f", s.recent[i]);
+  json += "]}";
+
+  {
+    std::ofstream f(base + ".txt", std::ios::binary);
+    f << text;
+  }
+  {
+    std::ofstream f(base + ".json", std::ios::binary);
+    f << json;
+  }
+  SDL_SetClipboardText(text.c_str());
+  std::printf("[DEVHUD] exported %s.txt / .json (text copied to clipboard)\n", base.c_str());
+  std::fflush(stdout);
+  toast = "exported " + base;
+  toast_until = native_perf_phase::now_ns() + 4000000000ull;
+}
+
+// ---------------------------------------------------------------------------
+// Visibility, reset, keys.
+// ---------------------------------------------------------------------------
+inline void reset_window(const char *why) {
+  ring_n = 0;
+  frame_calls = 0;
+  presents = 0;
+  fresh_frames = 0;
+  last_stamp_ns = 0;
+  last_index = 0;
+  worst_ns = 0;
+  worst_index = ~uint64_t(0);
+  current = Snapshot();
+  take_baseline();
+  if (why) {
+    toast = why;
+    toast_until = native_perf_phase::now_ns() + 2000000000ull;
+  }
+}
+
+inline void set_on(bool v) {
+  if (v && !on.load(std::memory_order_relaxed)) {
+    on.store(true, std::memory_order_relaxed);
+    reset_window(nullptr);
+    std::printf("[DEVHUD] visible: percentages over the last %u frames; F4 exports, F9 resets\n", kWindow);
+  } else if (!v && on.load(std::memory_order_relaxed)) {
+    on.store(false, std::memory_order_relaxed);
+    std::printf("[DEVHUD] hidden: timing stopped\n");
+  }
+  std::fflush(stdout);
+}
+
+// Returns true when the key was consumed, so the caller's else-if chain in the
+// SDL poll still reaches F11 and the rest of the game's keys.
+inline bool key(SDL_Keycode k) {
+  const int code = int(k);
+  switch (code) {
+    case SDLK_F3:
+      set_on(!on.load(std::memory_order_relaxed));
+      return true;
+    case SDLK_F4:
+      export_snapshot();
+      return true;
+    case SDLK_F9:
+      reset_window("window reset");
+      return true;
+    default:
+      return false;
+  }
+}
+
+inline void configure(double field_ms, const char *renderer, int internal_scale) {
+  if (field_ms > 1.0 && field_ms < 1000.0) {
+    budget_ms = field_ms;
+    // One dropped 50 Hz field: 20.05 ms. In an NTSC field (16.68 ms) that is
+    // also a dropped field, so the threshold never falls below 20.05.
+    late_ms = (field_ms > 20.0 ? field_ms : 20.0) + 0.05;
+  }
+  info = renderer && *renderer ? std::string("GPU ") + renderer : std::string("headless");
+  info += fmt(" | internal %dx | budget %.2f ms | phases %s",
+              internal_scale, budget_ms,
+              native_perf_phase::enabled ? "on (NWII_PERF_PHASE)" : "off (set NWII_PERF_PHASE=1)");
+  if (std::getenv("NWII_DEV_HUD")) set_on(true);
+}
+
+// ---------------------------------------------------------------------------
+// Draw. Everything GL touches is saved and restored: the renderer caches its
+// own state and the raster shadow caches caps, so the overlay must leave the
+// pipeline exactly as it found it.
+// ---------------------------------------------------------------------------
+inline void draw(int W, int H) {
+  if (!on.load(std::memory_order_relaxed)) return;
+  if (W <= 0 || H <= 0) return;
+  static uint64_t next_refresh = 0;
+  const uint64_t t = native_perf_phase::now_ns();
+  if (t >= next_refresh) {
+    next_refresh = t + 500000000ull;
+    Snapshot s = current;
+    if (compute(s)) {
+      current = s;
+      take_baseline();
+      worst_ns = 0;
+      worst_index = ~uint64_t(0);
+    }
+  }
+  const int scale = std::clamp(int(std::lround(double(H) / 400.0)), 1, 3);
+  text_scale = scale;
+  if (!init_gpu()) return;
+  const Snapshot &s = current;
+
+  static Canvas c;
+  static uint64_t built = 0;
+  static int old_w = 0, old_h = 0, old_scale = 0;
+  static bool old_valid = false;
+  const bool rebuild = t >= built + 125000000ull || W != old_w || H != old_h ||
+                       scale != old_scale || old_valid != s.valid;
+  if (rebuild) {
+    built = t;
+    old_w = W;
+    old_h = H;
+    old_scale = scale;
+    old_valid = s.valid;
+    c.v.clear();
+    if (c.v.capacity() < 131072) c.v.reserve(131072);
+    const std::vector<std::string> head = header_lines(s), body = body_lines(s);
+    size_t cols = 0;
+    for (const std::string &l : head) cols = std::max(cols, l.size());
+    for (const std::string &l : body) cols = std::max(cols, l.size());
+    const float lh = float(kCellH * scale), pad = 6.f * scale, x0 = 8.f * scale, y0 = 8.f * scale;
+    const float graph_h = 16.f * scale;
+    const float pw = float(cols) * float(kCellW * scale) + pad * 2.f;
+    const float ph = pad * 2.f + lh * float(head.size() + body.size() + 2) + graph_h;
+    const float white[4] = {0.93f, 0.94f, 0.97f, 1}, dim[4] = {0.58f, 0.62f, 0.70f, 1},
+                green[4] = {0.30f, 0.87f, 0.50f, 1}, amber[4] = {1.0f, 0.70f, 0.25f, 1},
+                red[4] = {0.97f, 0.40f, 0.40f, 1}, bg[4] = {0.035f, 0.045f, 0.06f, 0.93f},
+                accent[4] = {1.0f, 0.54f, 0.17f, 1}, grey[4] = {0.16f, 0.20f, 0.26f, 0.85f};
+    c.rect(x0, y0, x0 + pw, y0 + ph, bg);
+    c.rect(x0, y0, x0 + 3.f * scale, y0 + ph, accent);
+    float y = y0 + pad;
+    const float x = x0 + pad + 3.f * scale;
+    if (!head.empty()) {
+      c.text(x, y, head[0], accent);
+      y += lh;
+      for (size_t i = 1; i < head.size(); ++i) {
+        c.text(x, y, head[i], i == 3 && s.late ? red : white);
+        y += lh;
+      }
+    }
+    // frame-time graph: the last 120 intervals, budget line across.
+    {
+      const float gx = x, gw = pw - pad * 2.f - 3.f * scale, gh = graph_h - 4.f * scale;
+      c.rect(gx, y, gx + gw, y + gh, grey);
+      const double top_ms = std::max(2.5 * budget_ms, s.max_ms * 1.05);
+      const size_t n = std::min<size_t>(s.recent.size(), 120);
+      const float bw = gw / 120.f;
+      for (size_t i = 0; i < n; ++i) {
+        const double ms = s.recent[s.recent.size() - n + i];
+        const float hh = float(std::min(1.0, ms / top_ms)) * gh;
+        const float *col = ms <= budget_ms * 1.15 ? green : (ms <= budget_ms * 2.15 ? amber : red);
+        c.rect(gx + float(120 - n) * bw + float(i) * bw, y + gh - hh,
+               gx + (float(120 - n) + float(i) + 1.f) * bw - 0.5f, y + gh, col);
+      }
+      const float by = y + gh - float(budget_ms / top_ms) * gh;
+      c.rect(gx, by, gx + gw, by + 1.5f * scale, white);
+      y += graph_h;
+    }
+    for (const std::string &l : body) {
+      const float *col = dim;
+      if (!l.empty() && l[0] == ' ') col = white;          // phase rows
+      if (l.size() > 8 && l.compare(0, 5, "worst") == 0) col = amber;
+      if (l.size() > 4 && l.compare(0, 9, "gx frames") == 0) col = white;
+      c.text(x, y, l, col);
+      y += lh;
+    }
+    if (t < toast_until && !toast.empty()) c.text(x, y, toast, green);
+  }
+
+  // ---- save GL state
+  GLint prog, vao, abuf, aunit, viewport[4], blendsrc_rgb, blenddst_rgb, blendsrc_a,
+      blenddst_a, eq_rgb, eq_a, fbo_r, fbo_d;
+  GLboolean blend = glIsEnabled(GL_BLEND), depth = glIsEnabled(GL_DEPTH_TEST),
+            cull = glIsEnabled(GL_CULL_FACE), scissor = glIsEnabled(GL_SCISSOR_TEST), mask[4];
+  glGetIntegerv(GL_CURRENT_PROGRAM, &prog);
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+  glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &abuf);
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &aunit);
+  glGetIntegerv(GL_VIEWPORT, viewport);
+  glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+  glGetIntegerv(GL_BLEND_SRC_RGB, &blendsrc_rgb);
+  glGetIntegerv(GL_BLEND_DST_RGB, &blenddst_rgb);
+  glGetIntegerv(GL_BLEND_SRC_ALPHA, &blendsrc_a);
+  glGetIntegerv(GL_BLEND_DST_ALPHA, &blenddst_a);
+  glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb);
+  glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_a);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fbo_d);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &fbo_r);
+  glActiveTexture(GL_TEXTURE0);
+  GLint tex0 = 0, sampler0 = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex0);
+  glGetIntegeri_v(GL_SAMPLER_BINDING, 0, &sampler0);
+
+  // ---- draw
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+  glViewport(0, 0, W, H);
+  (glDisable)(GL_DEPTH_TEST);
+  (glDisable)(GL_CULL_FACE);
+  (glDisable)(GL_SCISSOR_TEST);
+  (glEnable)(GL_BLEND);
+  (glBlendFuncSeparate)(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+  (glBlendEquation)(GL_FUNC_ADD);
+  (glColorMask)(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glUseProgram(gpu.prog);
+  glUniform2f(gpu.u_view, float(W), float(H));
+  glBindVertexArray(gpu.vao);
+  glBindBuffer(GL_ARRAY_BUFFER, gpu.vbo);
+  glBindTexture(GL_TEXTURE_2D, font.tex);
+  glBindSampler(0, 0);
+  if (rebuild) glBufferData(GL_ARRAY_BUFFER, GLsizeiptr(c.v.size() * sizeof(float)), c.v.data(), GL_STREAM_DRAW);
+  glDrawArrays(GL_TRIANGLES, 0, GLsizei(c.v.size() / 8));
+
+  // ---- restore
+  glBindTexture(GL_TEXTURE_2D, GLuint(tex0));
+  glBindSampler(0, GLuint(sampler0));
+  glActiveTexture(GLenum(aunit));
+  glBindBuffer(GL_ARRAY_BUFFER, GLuint(abuf));
+  glBindVertexArray(GLuint(vao));
+  glUseProgram(GLuint(prog));
+  (glBlendFuncSeparate)(GLenum(blendsrc_rgb), GLenum(blenddst_rgb), GLenum(blendsrc_a), GLenum(blenddst_a));
+  (glBlendEquationSeparate)(GLenum(eq_rgb), GLenum(eq_a));
+  if (!blend) (glDisable)(GL_BLEND);
+  if (depth) (glEnable)(GL_DEPTH_TEST);
+  if (cull) (glEnable)(GL_CULL_FACE);
+  if (scissor) (glEnable)(GL_SCISSOR_TEST);
+  (glColorMask)(mask[0], mask[1], mask[2], mask[3]);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, GLuint(fbo_d));
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, GLuint(fbo_r));
+  glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+}
+
+}  // namespace native_dev_hud
diff --git a/nWiiRuntime/include/runtime/native_event_mask.h b/nWiiRuntime/include/runtime/native_event_mask.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_event_mask.h
@@ -0,0 +1,71 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+// NATIVE_EVENT_MASK_V1: one cache line that says "some producer may have made a
+// callback / interrupt due since the last real poll".
+//
+// The poll fast path used to read five independent producer locations on every
+// real poll (g_ipc_interrupt_delay, hw::g_di_interrupt_delay, ctx.vblank_pending,
+// hw::pi_intsr, hw::pi_intmr). The mask replaces the three that are cross-thread
+// atomics with a single word, read once per call.
+//
+// Producer -> bit table (every producer that can make a poll non-trivial):
+//
+//  bit                 producer                                          raiser / lowerer
+//  ------------------  ------------------------------------------------  ------------------------------------------
+//  kIpcDelay   (0)     hw_ipc.cpp arms g_ipc_interrupt_delay              raise on arm; ios.cpp poll lowers at 0
+//  kVBlank     (2)     host VI thread (main.cpp) and the EventScheduler  raise where vblank_pending is set;
+//                      VI callback (ios.cpp) set ctx.vblank_pending       ios.cpp poll lowers when it consumes it
+//  kPiIrq      (3)     trigger_pi_interrupt (VI/PE/DSP/AI/DI/IPC) and    raise on an unmasked 0->1 transition of
+//                      the PI INTMR writer                              pi_intsr / on an INTMR enable; lowered by
+//                                                                        the poll once (pi_intsr & pi_intmr) == 0
+//
+// Producers that deliberately do NOT get a bit, because the poll already reads
+// the exact value at the point where it decides:
+//
+//  hw::g_di_interrupt_delay  has no arming site in the runtime (only the zero
+//                        initializer and the di_tick() countdown exist), so the
+//                        fast path keeps its exact `== 0` test on the plain int
+//                        instead of a bit that nothing raises.
+//  queue_callback        pending_cb_count is re-read in the fast path: it is the
+//                        dispatch decision itself, and a queued callback is not a
+//                        "maybe" event. queue_callback already raises the
+//                        native_idle::attention latch through notify().
+//  DEC expiry            ctx.dec_expired() is only evaluated when the 16-poll
+//                        clock throttle says `due`, which already forces the
+//                        slow path; the mask cannot widen that cadence.
+//  EventScheduler        advanced only when `due`, same argument.
+//  GX staged bytes       read only on the idle PC (0x803BBFA0), where the value
+//                        itself is required; it is not a callback source.
+//  WPAD phase            native_wpad_poll runs on the fast path itself.
+//  native_idle::notify   keeps its own attention latch (native_idle::attention),
+//                        which native_poll_due() already tests at every site.
+//
+// Ordering: a producer raises its bit with release ordering *after* publishing
+// the value the poll reads, and the poll loads the mask with acquire ordering
+// before it looks at anything else. So "mask & kSlowMask == 0" observed by the
+// poll means the three conditions were false as of the mask load.
+//
+// A raise that races a lower can be lost (the same bounded-delay property the
+// existing native_idle::attention latch already relies on): the credit
+// countdown in native_poll_due() re-runs the slow path within NWII_POLL_CREDIT
+// poll points, and the slow path re-derives every condition from the raw
+// registers. The IPC rule is not affected by that bound: kIpcDelay stays set for
+// the whole countdown, so a poll runs at every site while a delay is armed.
+namespace nwii::runtime::native_events {
+
+enum : uint32_t {
+  kIpcDelay = 1u << 0,
+  kVBlank   = 1u << 2,
+  kPiIrq    = 1u << 3,
+  // The bits that gate the poll fast path.
+  kSlowMask = kIpcDelay | kVBlank | kPiIrq,
+};
+
+inline std::atomic<uint32_t> mask{0};
+
+inline void raise(uint32_t bits) { mask.fetch_or(bits, std::memory_order_release); }
+inline void lower(uint32_t bits) { mask.fetch_and(~bits, std::memory_order_release); }
+inline bool any(uint32_t bits) { return (mask.load(std::memory_order_relaxed) & bits) != 0; }
+
+} // namespace nwii::runtime::native_events
diff --git a/nWiiRuntime/include/runtime/native_fifo_lock.h b/nWiiRuntime/include/runtime/native_fifo_lock.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_fifo_lock.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <cstdint>
+#include <vector>
+// NATIVE_FIFO_SRWLOCK_V1: the FIFO publish/drain mutex is taken ~6000 times per
+// frame on the guest thread. MinGW std::mutex is winpthreads, whose lock/unlock
+// walk the pthread self/TLS path; an SRW lock is a single cmpxchg. Same
+// non-recursive, blocking semantics. This mutex is not paired with any condition
+// variable (the drain/wake condvars use g_gx_drain_mutex), so it is safe to swap.
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <mutex>
+#endif
+namespace nwii::runtime {
+struct NativeFifoLock {
+#ifdef _WIN32
+  SRWLOCK lock = SRWLOCK_INIT;
+  void acquire() { ::AcquireSRWLockExclusive(&lock); }
+  void release() { ::ReleaseSRWLockExclusive(&lock); }
+#else
+  std::mutex lock;
+  void acquire() { lock.lock(); }
+  void release() { lock.unlock(); }
+#endif
+};
+struct NativeFifoLockGuard {
+  NativeFifoLock& l;
+  explicit NativeFifoLockGuard(NativeFifoLock& x) : l(x) { l.acquire(); }
+  ~NativeFifoLockGuard() { l.release(); }
+  NativeFifoLockGuard(const NativeFifoLockGuard&) = delete;
+  NativeFifoLockGuard& operator=(const NativeFifoLockGuard&) = delete;
+};
+// NATIVE_MOM_FIFO_HANDOFF_V1: append source to destination, transferring the whole
+// buffer with one swap when the destination is empty.  Callers hold the FIFO
+// lock (or own both buffers); byte order is the plain concatenation either way.
+inline void NativeAppendFifo(std::vector<uint8_t>& destination,
+                             std::vector<uint8_t>& source) {
+  if (destination.empty()) destination.swap(source);
+  else { destination.insert(destination.end(), source.begin(), source.end());
+         source.clear(); }
+}
+} // namespace nwii::runtime
diff --git a/nWiiRuntime/include/runtime/native_frame_limit.h b/nWiiRuntime/include/runtime/native_frame_limit.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_frame_limit.h
@@ -0,0 +1,50 @@
+#pragma once
+// ' + MARK + ': a custom frame-rate cap shared by the host pacing and the
+// guest VI period. No dependency on the developer HUD.
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <cstdlib>
+
+namespace native_frame_limit {
+
+// The regional field period: 20 ms PAL, 16.683 ms NTSC, scaled by turbo.
+inline std::chrono::nanoseconds Period(bool pal, double turbo, const char* custom) {
+    const int64_t regional = int64_t((pal ? 20000000 : 16683333) / turbo);
+    if (!custom || !*custom) return std::chrono::nanoseconds(regional);
+    char* end = nullptr;
+    const double fps = std::strtod(custom, &end);
+    if (end == custom || *end || !std::isfinite(fps) || fps < 10 || fps > 1000)
+        return std::chrono::nanoseconds(regional);
+    return std::chrono::nanoseconds(int64_t(std::llround(1000000000.0 / fps)));
+}
+
+// NATIVE_MOM_FRAME_GATE_V1: the guest's frame-gate threshold load.  Returns the
+// original value bit-preserved unless it is exactly the stock 1/60 constant
+// and NWII_FPS_LIMIT parses to a finite fps inside 10..1000 (strtod, full
+// string) without NWII_NO_GUEST_FRAME_LIMIT.  No fixed-dt speed hack: the
+// override only changes the cap the game already applies to itself.
+inline float MinimumUpdateSeconds(float original) {
+    static const float override_dt = []() {
+        if (std::getenv("NWII_NO_GUEST_FRAME_LIMIT")) return 0.f;
+        const char* e = std::getenv("NWII_FPS_LIMIT");
+        if (!e || !*e) return 0.f;
+        char* end = nullptr;
+        const double fps = std::strtod(e, &end);
+        if (end == e || *end || !std::isfinite(fps) || fps < 10.0 || fps > 1000.0)
+            return 0.f;
+        return float(1.0 / fps);
+    }();
+    if (!override_dt) return original;
+    uint32_t bits;
+    std::memcpy(&bits, &original, 4);
+    return bits == 0x3C888889u ? override_dt : original;
+}
+
+// The same cap expressed in guest timebase ticks.
+inline uint64_t GuestPeriodTicks(bool pal, uint64_t frequency, const char* custom) {
+    return uint64_t(std::llround(frequency * (Period(pal, 1.0, custom).count() / 1000000000.0)));
+}
+
+} // namespace native_frame_limit
diff --git a/nWiiRuntime/include/runtime/native_gpu_vertex_mom.h b/nWiiRuntime/include/runtime/native_gpu_vertex_mom.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_gpu_vertex_mom.h
@@ -0,0 +1,106 @@
+#pragma once
+
+
+
+// NATIVE_MOM_GPU_VERTEX_V1: the switches for the vertex-shader transform.
+//
+// A qualified draw keeps its *object-space* position and normal in the batch and
+// the generated vertex shader applies the XF banks the draw was parsed with
+// (`NativeGpuXF`, binding point 1).  Everything the shader cannot reproduce with
+// those banks stays on the CPU path, per draw - see the eligibility test in
+// ``fifo_parser.cpp`` and the stage docstring.
+//
+// Two independent runtime switches, each read once per process:
+//
+//   NWII_NO_GPU_VERTEX=1  every draw takes today's CPU path, byte for byte
+//   NWII_NO_GPU_TEXGEN=1  position/normal on the GPU, regular texgen on the CPU
+//
+// The diagnostics below read a decoded vertex as if it were view space (they
+// print, archive or re-project position/normal/uv before the shader sees it), so
+// they keep the whole pipeline on the CPU - the same idea as CotT's
+// ``NativeGpuVertexEnabled``:
+//
+//   NWII_VTXTRACE            prints raw and view position per vertex
+//   NWII_SKINDBG             reports per-vertex matrix rows during decode
+//   NWII_DRAWLOG             prints cmd.vertices[].pos/tex from the draw ring
+//   NWII_NORMAL_DRAW_PROBE   prints decoded normals per draw
+//   NWII_DRAW_ARCHIVE        writes the batch and per-draw vertices to disk
+//   NWII_EFB_PROBE(_AFTER)   archives the batch around a draw
+//   NWII_EFB_PROBE_ARM_FILE  arms the two probes above
+//   NWII_NOSHADER            there is no vertex shader to do the transform
+//
+// NWII_FLATCOLOR is a fragment-shader override and stays compatible.
+#include <cstdlib>
+#include "runtime/gx_command.h"
+#include "runtime/gx/fifo_parser.h"
+
+namespace nwii::runtime::gx {
+
+inline bool NativeGpuVertexEnabled() {
+  static const bool enabled = []() {
+    // Experimental until a scene-matched GPU/CPU image comparison passes.
+    const char* requested = std::getenv("NWII_GPU_VERTEX");
+    if (!requested || requested[0] != '1' || requested[1] != '\0') return false;
+    const char* blocked[] = {"NWII_NO_GPU_VERTEX", "NWII_NOSHADER",
+                             "NWII_VTXTRACE", "NWII_SKINDBG", "NWII_DRAWLOG",
+                             "NWII_NORMAL_DRAW_PROBE", "NWII_DRAW_ARCHIVE",
+                             "NWII_EFB_PROBE", "NWII_EFB_PROBE_AFTER",
+                             "NWII_EFB_PROBE_ARM_FILE"};
+    for (const char* key : blocked)
+      if (std::getenv(key)) return false;
+    return true;
+  }();
+  return enabled;
+}
+
+// Regular texgen (ST/STQ from position, normal or a previous coordinate, plus the
+// post matrix) moves to the vertex shader only for draws the transform already
+// qualified for, and only when no generator chains another generator's output.
+inline bool NativeGpuTexgenEnabled() {
+  static const bool enabled = NativeGpuVertexEnabled() &&
+                              std::getenv("NWII_NO_GPU_TEXGEN") == nullptr;
+  return enabled;
+}
+
+}  // namespace nwii::runtime::gx
+
+namespace nwii::runtime::gx {
+inline void NativeGpuViewTransform(const DrawRaw& r, VertexData& vtx) {
+  // One definition of the per-draw snapshot transform; the parser's
+  // NativeApplySnapshotXf delegates here, so the CPU path, the CPU texgen
+  // fallback and the vertex shader all describe the same arithmetic.
+  if (!r.snap_pos_bank.empty() && vtx.has_pos) {
+    const uint32_t pb = (uint32_t)vtx.posMtxIdx * 4;
+    const uint32_t nb = 3u * (vtx.posMtxIdx & 31u);
+    if (pb + 12 <= 256 && nb + 9 <= 96) {
+      const float* m = &r.snap_pos_bank[pb];
+      const float x = vtx.pos[0], y = vtx.pos[1], z = vtx.pos[2];
+      vtx.pos[0] = m[0]*x + m[1]*y + m[2]*z + m[3];
+      vtx.pos[1] = m[4]*x + m[5]*y + m[6]*z + m[7];
+      vtx.pos[2] = m[8]*x + m[9]*y + m[10]*z + m[11];
+      if (vtx.has_norm && !r.snap_nrm_bank.empty()) {
+        const float* n = &r.snap_nrm_bank[nb];
+        const float a = vtx.norm[0], b = vtx.norm[1], cc = vtx.norm[2];
+        vtx.norm[0] = n[0]*a + n[1]*b + n[2]*cc;
+        vtx.norm[1] = n[3]*a + n[4]*b + n[5]*cc;
+        vtx.norm[2] = n[6]*a + n[7]*b + n[8]*cc;
+      }
+      vtx.pre_xf = true;
+    }
+  } else if (r.have_snap_mtx && vtx.has_pos) {
+    const float* m = r.snap_pos_mtx;
+    const float x = vtx.pos[0], y = vtx.pos[1], z = vtx.pos[2];
+    vtx.pos[0] = m[0]*x + m[1]*y + m[2]*z + m[3];
+    vtx.pos[1] = m[4]*x + m[5]*y + m[6]*z + m[7];
+    vtx.pos[2] = m[8]*x + m[9]*y + m[10]*z + m[11];
+    if (vtx.has_norm) {
+      const float* n = r.snap_nrm_mtx;
+      const float a = vtx.norm[0], b = vtx.norm[1], cc = vtx.norm[2];
+      vtx.norm[0] = n[0]*a + n[1]*b + n[2]*cc;
+      vtx.norm[1] = n[3]*a + n[4]*b + n[5]*cc;
+      vtx.norm[2] = n[6]*a + n[7]*b + n[8]*cc;
+    }
+    vtx.pre_xf = true;
+  }
+}
+}  // namespace nwii::runtime::gx
diff --git a/nWiiRuntime/include/runtime/native_guest_bytes.h b/nWiiRuntime/include/runtime/native_guest_bytes.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_guest_bytes.h
@@ -0,0 +1,86 @@
+#pragma once
+#include "runtime/cpu_context.h"
+#include <algorithm>
+#include <vector>
+#include <new>
+#include <cstring>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+// NATIVE_MOM_ADAPT_A3: MoM's replacement for CotT's native_guest_bytes.h.
+// CotT's version needs MMU::kMem1Limit / kMem2Limit and
+// native_watch_span_may_hit, which only exist after CotT's
+// fix_mmu_constant_limits and fix_watch_span_guards stages. Neither applies
+// to MoM, so the RAM extents are taken from the live vectors instead:
+// MEM1 = 24 MiB + 8, MEM2 = 64 MiB + 8.
+namespace native_guest_bytes {
+using nwii::runtime::MMU;
+inline bool Enabled() {
+  static const bool enabled = std::getenv("NWII_NO_IOS_BULK_TRANSFER") == nullptr;
+  return enabled;
+}
+inline uint8_t* OrdinarySpan(MMU& memory, uint32_t address, uint32_t bytes) {
+  if (!Enabled() || !bytes) return nullptr;
+  if (nwii::runtime::g_watch_addr) return nullptr;
+  const uint32_t physical = address & 0x3fffffffu;
+  const size_t mem1_limit = memory.mem1.size() - 8;
+  if (physical < mem1_limit && bytes <= mem1_limit - physical)
+    return memory.mem1.data() + physical;
+  if (physical >= 0x10000000u) {
+    const uint32_t offset = physical - 0x10000000u;
+    const size_t mem2_limit = memory.mem2.size() - 8;
+    if (offset < mem2_limit && bytes <= mem2_limit - offset)
+      return memory.mem2.data() + offset;
+  }
+  return nullptr;
+}
+inline void Copy(MMU& memory, uint32_t address, const uint8_t* bytes, uint32_t count) {
+  if (auto* target = OrdinarySpan(memory, address, count)) {
+    std::memcpy(target, bytes, count); return;
+  }
+  for (uint32_t i = 0; i < count; ++i) memory.write8(address + i, bytes[i]);
+}
+inline void Zero(MMU& memory, uint32_t address, uint32_t count) {
+  if (auto* target = OrdinarySpan(memory, address, count)) {
+    std::memset(target, 0, count); return;
+  }
+  for (uint32_t i = 0; i < count; ++i) memory.write8(address + i, 0);
+}
+struct ScratchState { std::vector<uint8_t> bytes; bool busy = false; };
+#ifdef _WIN32
+inline void NTAPI ReleaseScratch(void* pointer) { delete static_cast<ScratchState*>(pointer); }
+inline ScratchState* LocalScratch() {
+  static const DWORD index = FlsAlloc(ReleaseScratch);
+  if (index == FLS_OUT_OF_INDEXES) return nullptr;
+  if (auto* state = static_cast<ScratchState*>(FlsGetValue(index))) return state;
+  auto* state = new (std::nothrow) ScratchState;
+  if (!state) return nullptr;
+  if (!FlsSetValue(index, state)) { delete state; return nullptr; }
+  return state;
+}
+#else
+inline ScratchState* LocalScratch() { static thread_local ScratchState state; return &state; }
+#endif
+class ReadBuffer {
+  std::vector<uint8_t> local;
+  ScratchState* owner = nullptr;
+  std::vector<uint8_t>* buffer = &local;
+public:
+  explicit ReadBuffer(uint32_t count) {
+    if (count && Enabled() && count <= 8u * 1024u * 1024u) {
+      if (auto* state = LocalScratch(); state && !state->busy) { owner = state; buffer = &state->bytes; }
+    }
+    const size_t dirty = std::min<size_t>(buffer->size(), count);
+    buffer->resize(count);
+    std::fill(buffer->begin(), buffer->begin() + dirty, uint8_t(0));
+    if (owner) owner->busy = true;
+  }
+  ~ReadBuffer() { if (owner) owner->busy = false; }
+  ReadBuffer(const ReadBuffer&) = delete;
+  ReadBuffer& operator=(const ReadBuffer&) = delete;
+  uint8_t* data() { return buffer->data(); }
+};
+}
diff --git a/nWiiRuntime/include/runtime/native_idle_wait.h b/nWiiRuntime/include/runtime/native_idle_wait.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_idle_wait.h
@@ -0,0 +1,97 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <algorithm>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+// NATIVE_IDLE_WAIT_MOM_V1
+// MoM's variant of the CotT idle-wait overlay. The CotT original pulls in
+// runtime/native_hud.h, which needs runtime/native_perf_census.h; that census
+// belongs to CotT's developer overlay and has no MoM counterpart, so the wait
+// primitive is kept self-contained here. The behaviour is the same: the guest
+// thread owns its timer, producers only signal the wake event, and no guest
+// register, RAM, instruction count or virtual clock is advanced while parked.
+namespace nwii::runtime::native_idle {
+inline thread_local uint64_t waits = 0;
+// Producer attention latch: a raised interrupt or a queued callback sets it.
+inline std::atomic<uint32_t> attention{0};
+
+// Upper bound on one park: 250 us. That also bounds a source that forgot to
+// signal, so a lost notification can never stall the guest.
+inline uint64_t budget_ticks(uint64_t now, uint64_t next, bool dec_pending,
+                             uint64_t dec_origin, uint64_t dec_value, uint64_t freq) {
+  // NATIVE_MOM_IDLE_PARK_CHURN_V1: 1 ms of speculative park instead of 250 us.  The clamp
+  // against the next deadline below still bounds a real timer wake, and
+  // notify() sets the wake event, so this only reduces how often the guest
+  // re-enters the park - it never delays a timer or a signal.
+  static const uint64_t park_ticks = []() {
+    const char* e = std::getenv("NWII_IDLE_PARK_US");
+    const long us = e ? std::strtol(e, nullptr, 10) : 1000;
+    return uint64_t(us > 0 ? us : 250);
+  }();
+  uint64_t ticks = park_ticks * freq / 1000000ull;
+  if (!ticks) ticks = 1;
+  if (!ticks) return 0;
+  if (next <= now) return 0;
+  ticks = std::min(ticks, next - now);
+  if (dec_pending) {
+    const uint64_t elapsed = now - dec_origin;
+    if (elapsed >= dec_value) return 0;
+    ticks = std::min(ticks, dec_value - elapsed);
+  }
+  return ticks;
+}
+
+#ifdef _WIN32
+struct Wake {
+  HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  ~Wake() { if (event) CloseHandle(event); }
+};
+inline Wake& wake() { static Wake s; return s; }
+inline void notify() {
+  attention.store(1, std::memory_order_relaxed);
+  if (wake().event) SetEvent(wake().event);
+}
+struct Timer {
+  HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, 0x2, TIMER_ALL_ACCESS);
+  ~Timer() { if (timer) CloseHandle(timer); }
+};
+template <class Pending>
+inline bool wait(uint64_t ticks, uint64_t freq, Pending pending) {
+  if (!ticks || !freq || pending()) return false;
+  static thread_local Timer t;
+  auto& w = wake();
+  if (!t.timer || !w.event) return false;
+  LARGE_INTEGER due{};
+  const uint64_t ns100 = ticks * 10000000ull / freq;
+  if (!ns100) return false;
+  due.QuadPart = -static_cast<LONGLONG>(ns100);
+  if (!SetWaitableTimer(t.timer, &due, 0, nullptr, nullptr, FALSE)) return false;
+  if (pending()) { CancelWaitableTimer(t.timer); return false; }
+  HANDLE handles[] = {w.event, t.timer};
+  // A signal that arrives between the predicate check and the wait stays
+  // pending in the event, so no notification is lost.
+  ++waits;
+  static const bool keep_cancel =
+      std::getenv("NWII_NO_IDLE_PARK_CHURN") != nullptr;
+  const DWORD result = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+  // NATIVE_MOM_IDLE_PARK_CHURN_V1: the timer is one-shot and the next arm replaces its due
+  // time, so cancelling here is a third syscall per park for nothing.
+  if (keep_cancel) CancelWaitableTimer(t.timer);
+  return true;
+}
+#else
+inline void notify() { attention.store(1, std::memory_order_relaxed); }
+template <class Pending>
+inline bool wait(uint64_t, uint64_t, Pending) { return false; }
+#endif
+}  // namespace nwii::runtime::native_idle
diff --git a/nWiiRuntime/include/runtime/native_mom_lane.h b/nWiiRuntime/include/runtime/native_mom_lane.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_mom_lane.h
@@ -0,0 +1,174 @@
+#pragma once
+// NATIVE_MOM_GUEST_MEMORY_LANE_V1 -- measured, switchable host-side memory work.
+//
+// Installed by tools/stages/fix_guest_memory_lane_mom.py.  Read that file's
+// docstring for the evidence behind each item.
+//
+// Switches (read once, at static-initialisation time):
+//     NWII_MOM_LANE=words,decode,mem2,fill,psq    the five items by name
+//     NWII_MOM_LANE=all / unset                  all five (default)
+//     NWII_MOM_LANE=none                         none of them
+// An unrecognised name selects nothing, so a typo leaves the reference lane.
+//
+// Nothing here can change a guest-visible value:
+//   * a span proof is refused for every address the per-word MMU path has to
+//     handle itself (see Span()), and the caller then runs the original
+//     statement sequence, which is still in the generated code;
+//   * a refused proof is the *whole* run: the items never split a run between
+//     the two paths, so ordering, watches and the 0x0C sentinel stay exact.
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace nwii::runtime {
+// Declared (and defined) by cpu_context.h, which includes this header before the
+// MMU.  Forward-declared here so the span proofs can read the live watch state:
+// a store run must keep the per-word path whenever a watch is armed.
+extern uint32_t g_watch_addr;
+}
+
+namespace nwii::runtime::native_mom_lane {
+
+// ---------------------------------------------------------------------------
+// Switches.  One dynamically initialised object, so no path pays a
+// thread-safe-static guard and there is no initialisation order to reason about
+// between five separate flags.
+// ---------------------------------------------------------------------------
+enum Item : unsigned {
+    kWords  = 1u << 0,
+    kDecode = 1u << 1,
+    kMem2   = 1u << 2,
+    kFill   = 1u << 3,
+    kPsq    = 1u << 4,
+    kAll    = kWords | kDecode | kMem2 | kFill | kPsq,
+};
+
+inline unsigned Parse(const char *text) {
+    if (!text || !*text) return kAll;
+    unsigned mask = 0;
+    for (const char *p = text; *p;) {
+        while (*p == ',' || *p == ' ' || *p == '\t') ++p;
+        const char *begin = p;
+        while (*p && *p != ',' && *p != ' ' && *p != '\t') ++p;
+        const unsigned length = unsigned(p - begin);
+        if (length == 4 && std::memcmp(begin, "none", 4) == 0) return 0;
+        else if (length == 3 && std::memcmp(begin, "all", 3) == 0) return kAll;
+        else if (length == 5 && std::memcmp(begin, "words", 5) == 0) mask |= kWords;
+        else if (length == 6 && std::memcmp(begin, "decode", 6) == 0) mask |= kDecode;
+        else if (length == 4 && std::memcmp(begin, "mem2", 4) == 0) mask |= kMem2;
+        else if (length == 4 && std::memcmp(begin, "fill", 4) == 0) mask |= kFill;
+        else if (length == 3 && std::memcmp(begin, "psq", 3) == 0) mask |= kPsq;
+    }
+    return mask;
+}
+
+struct Switches { unsigned mask; };
+inline Switches Mix() { Switches s; s.mask = Parse(std::getenv("NWII_MOM_LANE")); return s; }
+inline const Switches g_switches = Mix();
+
+inline bool On(Item item) { return (g_switches.mask & unsigned(item)) != 0; }
+inline bool WordsOn()  { return On(kWords); }
+inline bool DecodeOn() { return On(kDecode); }
+inline bool Mem2On()   { return On(kMem2); }
+inline bool FillOn()   { return On(kFill); }
+inline bool PsqOn()    { return On(kPsq); }
+
+// ---------------------------------------------------------------------------
+// One ordinary-RAM proof for a whole run of words.
+//
+// Returns a host pointer only when every byte of [address, address+bytes) maps
+// to the same ordinary bank, with the *same* bounds the per-word fast path uses
+// (`size() - 8`).  It is refused -- and the caller keeps the per-word path --
+// for:
+//
+//   * an armed watch: a watch must see every individual write, in order;
+//   * the first 16 physical bytes, which contain the 0x0C sentinel word that
+//     read32 zeroes and write32 drops;
+//   * MEM2 outside its padding limit, the MMIO windows, the GX write-gather page
+//     (none of them is inside either bank, so the bank tests refuse them);
+//   * a run that wraps.  A run never wraps here: a run that would cross 2^32 (or
+//     the 0x3FFFFFFF address mask) needs `address > 0xFFFFFFE0`, i.e.
+//     `physical > 0x3FFFFFE0`, which neither bank limit accepts.
+//
+// `Memory` is nwii::runtime::MMU; it is a template so this header can be parsed
+// before `struct MMU` is defined.
+template <class Memory>
+inline uint8_t *Span(Memory &memory, uint32_t address, uint32_t bytes, bool watched) {
+    if (watched || bytes == 0) return nullptr;
+    const uint32_t physical = address & 0x3fffffffu;
+    if (physical < 0x10u) return nullptr;
+    const uint64_t mem1_limit = memory.mem1.size() - 8;
+    if (uint64_t(physical) + bytes <= mem1_limit) return memory.mem1.data() + physical;
+    const uint64_t mem2_limit = memory.mem2.size() - 8;
+    if (physical >= 0x10000000u &&
+        uint64_t(physical) - 0x10000000u + bytes <= mem2_limit)
+        return memory.mem2.data() + (physical - 0x10000000u);
+    return nullptr;
+}
+
+// Guest words are big-endian; one swap per word, no per-word address work.
+inline uint32_t Load(const uint8_t *pointer) {
+    uint32_t bits;
+    std::memcpy(&bits, pointer, 4);
+    return __builtin_bswap32(bits);
+}
+inline void Store(uint8_t *pointer, uint32_t value) {
+    const uint32_t bits = __builtin_bswap32(value);
+    std::memcpy(pointer, &bits, 4);
+}
+
+// lmw / stmw: the proof is only worth its own compare for >= 16 words (the
+// reference measured the break-even; below it the per-word path wins).
+template <class Memory>
+inline uint8_t *SpanWordsLoad(Memory &memory, uint32_t address, uint32_t bytes) {
+    if (!WordsOn()) return nullptr;
+    return Span(memory, address, bytes, false);
+}
+template <class Memory>
+inline uint8_t *SpanWordsStore(Memory &memory, uint32_t address, uint32_t bytes) {
+    if (!WordsOn()) return nullptr;
+    return Span(memory, address, bytes, nwii::runtime::g_watch_addr != 0);
+}
+
+// The same guest word repeated `words` times, in ascending address order.
+inline void FillWords(uint8_t *destination, unsigned words, uint32_t value) {
+    if (value == (value & 255u) * 0x01010101u) {   // 0x00000000, 0xVVVVVVVV
+        std::memset(destination, int(value & 255u), size_t(words) * 4u);
+        return;
+    }
+    const uint32_t big_endian = __builtin_bswap32(value);
+    const uint32_t pattern[4] = {big_endian, big_endian, big_endian, big_endian};
+    unsigned offset = 0;
+    const unsigned total = words * 4u;
+    for (; offset + 16u <= total; offset += 16u)
+        std::memcpy(destination + offset, pattern, 16);
+    for (; offset < total; offset += 4u)
+        std::memcpy(destination + offset, &big_endian, 4);
+}
+
+// One straight-line fill run: prove the span, write every word, and report
+// whether the caller may skip its own per-word stores.  Every word is a store,
+// so an armed watch refuses it.  Returns false (caller stores per word) for
+// anything Span() refuses.
+template <class Memory>
+inline bool FillRun(Memory &memory, uint32_t address, unsigned words, uint32_t value) {
+    if (!FillOn() || words == 0) return false;
+    uint8_t *span = Span(memory, address, words * 4u, nwii::runtime::g_watch_addr != 0);
+    if (!span) return false;
+    FillWords(span, words, value);
+    return true;
+}
+
+// psq: a W==0 plain-F32 pair is two adjacent floats.
+template <class Memory>
+inline uint8_t *SpanPairLoad(Memory &memory, uint32_t address) {
+    if (!PsqOn()) return nullptr;
+    return Span(memory, address, 8u, false);
+}
+template <class Memory>
+inline uint8_t *SpanPairStore(Memory &memory, uint32_t address) {
+    if (!PsqOn()) return nullptr;
+    return Span(memory, address, 8u, nwii::runtime::g_watch_addr != 0);
+}
+
+}  // namespace nwii::runtime::native_mom_lane
diff --git a/nWiiRuntime/include/runtime/native_packed_vertices_mom.h b/nWiiRuntime/include/runtime/native_packed_vertices_mom.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_packed_vertices_mom.h
@@ -0,0 +1,79 @@
+// NATIVE_MOM_PACKED_VERTICES_V1: compact POST-decode upload layout for FlushBatch.
+//
+// This is a repack, not a direct packed decoder: the parser/ConvertVertex still
+// produces the 160-byte float BatchVertex rows; NativePackBatch rewrites them for
+// the upload when every colour channel round-trips through a byte exactly, and
+// FlushBatch selects between the packed buffer (stride 136) and the original
+// s_batch (stride 160) per draw batch.  Opt-in: NWII_PACKED_VERTICES=1, and
+// NWII_NO_PACKED_VERTICES always wins.
+//
+// The two colour quads become normalised RGBA8.  A channel only packs when
+// float(byte)/255 compares bit-equal to the source float: exact 0.0/1.0 and the
+// byte-representable fractions pass; NaN, Inf, out-of-range, -0.0 and any value
+// sitting between byte steps fails the WHOLE batch back to the float layout, so
+// no draw ever gets a silently shifted colour.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <cmath>
+#include <vector>
+
+struct NativePackedBatchVertex {
+  float position[3];   // 0
+  uint8_t color0[4];   // 12
+  float uv[2];         // 16
+  float normal[3];     // 24
+  uint8_t color1[4];   // 36
+  float texgen[8][3];  // 40
+  NativePackedBatchVertex() {}
+};
+static_assert(sizeof(NativePackedBatchVertex) == 136,
+              "packed vertex stride changed");
+static_assert(offsetof(NativePackedBatchVertex, color0) == 12 &&
+              offsetof(NativePackedBatchVertex, uv) == 16 &&
+              offsetof(NativePackedBatchVertex, normal) == 24 &&
+              offsetof(NativePackedBatchVertex, color1) == 36 &&
+              offsetof(NativePackedBatchVertex, texgen) == 40,
+              "packed vertex offsets changed");
+
+// One channel: byte-representable iff lround(c*255)/255 is bit-identical to c.
+// Rejects NaN/Inf (isfinite), out-of-range, -0.0 (roundtrip gives +0.0, bits
+// differ) and any non-byte-aligned float.
+inline bool NativePackChannel(float c, uint8_t& out) {
+  if (!std::isfinite(c)) return false;
+  if (c < 0.f || c > 1.f) return false; // reject before c*255 can overflow
+  const long v = std::lround(c * 255.f);
+  if (v < 0 || v > 255) return false;
+  const uint8_t b = uint8_t(v);
+  const float rt = float(b) / 255.f;
+  if (std::memcmp(&rt, &c, 4) != 0) return false;
+  out = b;
+  return true;
+}
+
+// Repack `input` into `out`.  Returns false and clears `out` if any vertex has a
+// non-representable colour - the caller then uploads the float batch instead.
+// The generic-vertex fields (position, uv, normal, texgen incl. matrix indices,
+// STQ and NaN/-0 bit patterns) are copied verbatim.
+template<class Vertex>
+inline bool NativePackBatch(const std::vector<Vertex>& input,
+                            std::vector<NativePackedBatchVertex>& out) {
+  out.clear();
+  out.resize(input.size()); // every field is assigned below
+  for (size_t i = 0; i < input.size(); ++i) {
+    const Vertex& s = input[i];
+    NativePackedBatchVertex& d = out[i];
+    const float c0[4] = {s.r, s.g, s.b, s.a};
+    for (int k = 0; k < 4; ++k)
+      if (!NativePackChannel(c0[k], d.color0[k])) { out.clear(); return false; }
+    for (int k = 0; k < 4; ++k)
+      if (!NativePackChannel(s.color1[k], d.color1[k])) { out.clear(); return false; }
+    std::memcpy(d.position, &s.x, 12);
+    std::memcpy(d.uv, &s.u, 8);
+    std::memcpy(d.normal, &s.nx, 12);
+    std::memcpy(d.texgen, s.texgen, sizeof(d.texgen));
+  }
+  return true;
+}
diff --git a/nWiiRuntime/include/runtime/native_perf_census.h b/nWiiRuntime/include/runtime/native_perf_census.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_perf_census.h
@@ -0,0 +1,438 @@
+#pragma once
+// NATIVE_PERF_CENSUS_V1
+//
+// Ported from the Crash of the Titans port's runtime/native_perf_census.h and
+// adapted to this runtime. Game-independent: it names no guest address, reads
+// no guest RAM and prints nothing unless NWII_PERF_CENSUS is set.
+//
+// The CotT original counts the operations of CotT's own recompiler (its
+// dispatch switch, its quantised gather, its packed-vertex allocator, its
+// texture cache). None of those exist here: this runtime has a different
+// dispatcher, no quant gather and no packed-vertex path. What does exist, and
+// what this header measures, is the guest poll.
+//
+// The guest polls the host at every backward branch, so:
+//   * the poll rate is this runtime's closest thing to a "guest loop
+//     iterations per second" meter;
+//   * the guest's retired-instruction counter (ctx.inst_count, incremented by
+//     the generated code once per guest instruction) advances between two
+//     polls, so the instructions executed by one loop can be attributed
+//     exactly to the poll site that loop ends at.
+//
+// The per-site histogram therefore gives a hot-spot profile with exact
+// counts - not a sample - of where the guest spends its work.
+//
+// Cost, and why it is shaped the way it is
+// -----------------------------------------
+// The guest thread is close to saturating a core and the poll runs two to
+// three million times a second, so the census adds as little as possible to
+// that path:
+//   * the guest's counters share one cache line, and the counter the host
+//     thread writes has one of its own, so the two threads never bounce a
+//     line;
+//   * counters are read-modify-written with a load and a store, never with a
+//     locked read-modify-write;
+//   * the poll site is found through a four-entry cache, so the usual case is
+//     a comparison;
+//   * the clock is read only on every 64th poll. The counts stay exact; the
+//     wall-clock attribution becomes a sample, and an unbiased one, because a
+//     sampled poll draws the same site distribution as the polls themselves.
+//
+// An earlier revision read the clock on every poll and used locked
+// read-modify-writes on counters the host thread also wrote. It cost about a
+// third of a core, and on a guest already at 95 % of a core that was the
+// difference between the game running and the game stalling.
+//
+// Env:
+//   NWII_PERF_CENSUS=1        enable the census
+//   NWII_PERF_PC_HISTOGRAM=1  also record the per-poll-site histogram
+//   NWII_PERF_CENSUS_FAST=1   drop the clock read as well (counts only)
+//   NWII_PERF_CENSUS_FILE     write the whole per-site table as CSV
+//   NWII_PERF_CENSUS_PERIOD   seconds between [PERFCENSUS] reports (default 5)
+//
+// Output:
+//   [PERFCENSUS] t=12.0s polls=... polls_s=... fast=... slow=... instr=...
+//                instr_s=... polls_per_instr=... poll_us=... poll_pct=...
+//   [PERFPCS] n=1 pc=0x... polls=... instr=... exec_ms=... poll_us=... share_pct=...
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace native_perf_census {
+
+inline bool env_flag(const char *name) { return std::getenv(name) != nullptr; }
+
+inline const bool enabled = env_flag("NWII_PERF_CENSUS");
+inline const bool pc_histograms = enabled && env_flag("NWII_PERF_PC_HISTOGRAM");
+// The clock read is the expensive half of the histogram. NWII_PERF_CENSUS_FAST
+// drops it and keeps the exact instruction attribution.
+inline const bool timing = enabled && !env_flag("NWII_PERF_CENSUS_FAST");
+// How often the clock is read. The counts stay exact; only the wall-clock
+// attribution is sampled.
+inline const unsigned kClockEvery = 64;
+
+// The guest's counters. One cache line, one writer (the guest thread).
+struct alignas(64) GuestCounters {
+  std::atomic<uint64_t> polls{0};
+  std::atomic<uint64_t> polls_fast{0};
+  std::atomic<uint64_t> polls_slow{0};
+  std::atomic<uint64_t> instr{0};
+  std::atomic<uint64_t> poll_cost_ns{0};
+  std::atomic<uint64_t> poll_samples{0};
+  char pad[64 - 6 * sizeof(std::atomic<uint64_t>)];
+};
+inline GuestCounters g_counters;
+
+// The host's counter, on a line of its own so the two threads never share
+// one.
+struct alignas(64) HostCounter {
+  std::atomic<uint64_t> frames{0};
+  char pad[56];
+};
+inline HostCounter g_frames;
+
+__attribute__((always_inline)) inline void Bump(std::atomic<uint64_t> &field,
+                                                uint64_t amount) {
+  field.store(field.load(std::memory_order_relaxed) + amount, std::memory_order_relaxed);
+}
+
+inline uint64_t Polls() { return g_counters.polls.load(std::memory_order_relaxed); }
+inline uint64_t PollsFast() { return g_counters.polls_fast.load(std::memory_order_relaxed); }
+inline uint64_t PollsSlow() { return g_counters.polls_slow.load(std::memory_order_relaxed); }
+inline uint64_t GuestInstr() { return g_counters.instr.load(std::memory_order_relaxed); }
+inline uint64_t PollCostNs() { return g_counters.poll_cost_ns.load(std::memory_order_relaxed); }
+inline uint64_t PollSamples() { return g_counters.poll_samples.load(std::memory_order_relaxed); }
+
+// Kept for source compatibility with the CotT overlay headers, which call it
+// once per completed frame.
+inline void Frame() {
+  if (!enabled) return;
+  Bump(g_frames.frames, 1);
+}
+
+inline uint64_t now_ns() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count());
+}
+
+// What one clock read costs. The poll cost is a difference of two reads, so
+// the reads' own latency has to come out of it, otherwise the measurement
+// reports the clock instead of the poll.
+inline uint64_t clock_overhead_ns() {
+  static const uint64_t overhead = [] {
+    uint64_t best = UINT64_MAX;
+    for (int i = 0; i < 64; ++i) {
+      const uint64_t a = now_ns();
+      const uint64_t b = now_ns();
+      const uint64_t d = b >= a ? b - a : 0;
+      if (d < best) best = d;
+    }
+    return best == UINT64_MAX ? 0 : best;
+  }();
+  return overhead;
+}
+
+// ---------------------------------------------------------------------------
+// Per-poll-site histogram.
+//
+// One writer (the guest thread) and one reader (the reporter). Every field is
+// a relaxed atomic, and the writer never uses a locked read-modify-write.
+// ---------------------------------------------------------------------------
+// The guest has tens of thousands of backward branches and every one of them
+// is a poll site, so the table has to be large. 64 K sites of 32 bytes is
+// 2 MiB; the hot few stay in cache, the cold ones cost an L3 hit.
+constexpr unsigned kSlots = 65536;
+
+struct alignas(32) Site {
+  std::atomic<uint32_t> pc{0};
+  std::atomic<uint64_t> polls{0};
+  std::atomic<uint64_t> instr{0};
+  std::atomic<uint64_t> exec_ns{0};
+  char pad[4];
+};
+
+inline Site sites[kSlots];
+inline std::atomic<uint64_t> overflow{0};
+
+inline unsigned FindOrCreate(uint32_t pc) {
+  const unsigned base = unsigned((pc * 2654435761u) & (kSlots - 1u));
+  for (unsigned probe = 0; probe < 16; ++probe) {
+    const unsigned index = (base + probe) & (kSlots - 1u);
+    Site &s = sites[index];
+    const uint32_t cur = s.pc.load(std::memory_order_relaxed);
+    if (cur == pc) return index;
+    if (cur == 0) {
+      s.pc.store(pc, std::memory_order_relaxed);
+      return index;
+    }
+  }
+  overflow.fetch_add(1, std::memory_order_relaxed);
+  return UINT32_MAX;
+}
+
+// A four-entry cache in front of the table: the guest polls the same few
+// sites over and over, and this turns the usual lookup into a comparison.
+inline uint32_t g_cache_pc[4] = {0, 0, 0, 0};
+inline unsigned g_cache_slot[4] = {0, 0, 0, 0};
+inline unsigned g_cache_next = 0;
+
+inline unsigned SlotFor(uint32_t pc) {
+  if (!pc) return UINT32_MAX;
+  for (unsigned i = 0; i < 4; ++i)
+    if (g_cache_pc[i] == pc) return g_cache_slot[i];
+  const unsigned slot = FindOrCreate(pc);
+  if (slot == UINT32_MAX) return slot;
+  g_cache_pc[g_cache_next] = pc;
+  g_cache_slot[g_cache_next] = slot;
+  g_cache_next = (g_cache_next + 1) & 3u;
+  return slot;
+}
+
+// ---------------------------------------------------------------------------
+// Poll scope.
+//
+// Construct it at the top of the poll with the guest PC and the guest's
+// instruction counter; call mark_fast() on the cheap path; the destructor
+// accounts for the poll.
+// ---------------------------------------------------------------------------
+
+// State carried between two polls. Namespace scope, not function scope, so the
+// hot path pays no thread-safe-static guard check.
+inline uint64_t g_last_inst = 0;
+inline uint64_t g_last_exit_ns = 0;
+inline unsigned g_last_slot = UINT32_MAX;
+inline unsigned g_poll_index = 0;
+inline bool g_have_exit = false;
+inline uint64_t g_poll_cost_min = UINT64_MAX;
+
+// A histogram of the sampled poll costs, 10 ns per bucket. The mean is not a
+// usable figure here: the guest thread is descheduled for part of the run and
+// a poll that the scheduler interrupts measures the interruption too. The
+// distribution is not distorted that way.
+constexpr unsigned kPollBuckets = 128;
+inline std::atomic<uint32_t> g_poll_hist[kPollBuckets];
+
+struct PollScope {
+  uint32_t pc;
+  uint64_t inst;
+  uint64_t t_enter;
+  bool fast;
+  bool sampled;
+  PollScope(uint32_t pc_, uint64_t inst_)
+      : pc(pc_), inst(inst_), t_enter(0), fast(false), sampled(false) {
+    if (enabled && timing) {
+      sampled = ((++g_poll_index) & (kClockEvery - 1u)) == 0;
+      if (sampled) t_enter = now_ns();
+    }
+  }
+  PollScope(const PollScope &) = delete;
+  PollScope &operator=(const PollScope &) = delete;
+  void mark_fast() { fast = true; }
+  ~PollScope();
+};
+
+inline PollScope::~PollScope() {
+  if (!enabled) return;
+  const unsigned slot = SlotFor(pc);
+  if (slot != UINT32_MAX) Bump(sites[slot].polls, 1);
+  Bump(g_counters.polls, 1);
+  Bump(fast ? g_counters.polls_fast : g_counters.polls_slow, 1);
+
+  // The instructions executed since the previous poll belong to the loop
+  // whose backward branch is the *previous* poll site.
+  const uint64_t di = inst >= g_last_inst ? inst - g_last_inst : 0;
+  g_last_inst = inst;
+  if (di) {
+    Bump(g_counters.instr, di);
+    const unsigned target = (slot == g_last_slot) ? slot : g_last_slot;
+    if (target != UINT32_MAX) Bump(sites[target].instr, di);
+  }
+  g_last_slot = slot;
+
+  if (!sampled) return;
+  const uint64_t t_exit = now_ns();
+  // The two clock reads that bracket the poll are not part of the poll.
+  const uint64_t overhead = clock_overhead_ns() * 2;
+  const uint64_t raw = t_exit >= t_enter ? t_exit - t_enter : 0;
+  const uint64_t poll_ns = raw > overhead ? raw - overhead : 0;
+  if (!g_have_exit) {
+    // The first sample has no predecessor; it only starts the interval.
+    g_have_exit = true;
+    g_last_exit_ns = t_exit;
+    return;
+  }
+  const uint64_t interval = t_exit >= g_last_exit_ns ? t_exit - g_last_exit_ns : 0;
+  if (slot != UINT32_MAX) {
+    Bump(sites[slot].exec_ns, interval);
+  }
+  Bump(g_counters.poll_cost_ns, poll_ns);
+  Bump(g_counters.poll_samples, 1);
+  if (poll_ns < g_poll_cost_min) g_poll_cost_min = poll_ns;
+  {
+    const unsigned bucket = unsigned(poll_ns / 10u);
+    g_poll_hist[bucket < kPollBuckets ? bucket : kPollBuckets - 1u].fetch_add(
+        1, std::memory_order_relaxed);
+  }
+  g_last_exit_ns = t_exit;
+}
+
+// ---------------------------------------------------------------------------
+// Reporting. Called from the host loop, never from the guest thread, so the
+// line does not interleave with the guest's own output.
+// ---------------------------------------------------------------------------
+inline double report_period_s() {
+  static const double seconds = [] {
+    const char *e = std::getenv("NWII_PERF_CENSUS_PERIOD");
+    const double v = e ? std::strtod(e, nullptr) : 5.0;
+    return v > 0.05 ? v : 5.0;
+  }();
+  return seconds;
+}
+
+inline const char *census_file() {
+  static const char *path = std::getenv("NWII_PERF_CENSUS_FILE");
+  return path;
+}
+
+inline uint64_t g_report_last_ns = 0;
+inline uint64_t g_report_start_ns = 0;
+inline uint64_t g_report_last_polls = 0;
+inline uint64_t g_report_last_instr = 0;
+
+// The percentiles of the sampled poll costs, in nanoseconds.
+inline void poll_percentiles(double *p10, double *p50, double *p90) {
+  uint64_t total = 0;
+  for (unsigned i = 0; i < kPollBuckets; ++i)
+    total += g_poll_hist[i].load(std::memory_order_relaxed);
+  *p10 = *p50 = *p90 = 0.0;
+  if (!total) return;
+  const uint64_t want[3] = {total / 10, total / 2, (total * 9) / 10};
+  uint64_t seen = 0;
+  unsigned slot = 0;
+  for (unsigned i = 0; i < kPollBuckets; ++i) {
+    seen += g_poll_hist[i].load(std::memory_order_relaxed);
+    while (slot < 3 && seen >= want[slot]) {
+      double *target = slot == 0 ? p10 : (slot == 1 ? p50 : p90);
+      *target = double(i) * 10.0 + 5.0;
+      ++slot;
+    }
+    if (slot == 3) break;
+  }
+  while (slot < 3) {
+    double *target = slot == 0 ? p10 : (slot == 1 ? p50 : p90);
+    *target = double(kPollBuckets) * 10.0;
+    ++slot;
+  }
+}
+
+inline void WriteTable() {
+  const char *path = census_file();
+  if (!path || !*path) return;
+  std::FILE *out = std::fopen(path, "wb");
+  if (!out) return;
+  std::fprintf(out, "pc,polls,instr,exec_ns\n");
+  for (unsigned i = 0; i < kSlots; ++i) {
+    const uint32_t pc = sites[i].pc.load(std::memory_order_relaxed);
+    if (!pc) continue;
+    std::fprintf(out, "0x%08X,%llu,%llu,%llu\n", pc,
+                 (unsigned long long)sites[i].polls.load(std::memory_order_relaxed),
+                 (unsigned long long)sites[i].instr.load(std::memory_order_relaxed),
+                 (unsigned long long)sites[i].exec_ns.load(std::memory_order_relaxed));
+  }
+  std::fclose(out);
+}
+
+inline void maybe_report() {
+  if (!enabled) return;
+  const uint64_t now = now_ns();
+  if (!g_report_last_ns) {
+    g_report_last_ns = now;
+    g_report_start_ns = now;
+    return;
+  }
+  const double elapsed_s = double(now - g_report_last_ns) / 1e9;
+  if (elapsed_s < report_period_s()) return;
+  const double total_s = double(now - g_report_start_ns) / 1e9;
+
+  const uint64_t polls = Polls();
+  const uint64_t instr = GuestInstr();
+  const uint64_t dpolls = polls - g_report_last_polls;
+  const uint64_t dinstr = instr - g_report_last_instr;
+  // The cost of one poll, measured on the sampled polls. The guest thread is
+  // descheduled for part of the run, and a poll that is interrupted by the
+  // scheduler measures the interruption too, so the mean is an upper bound
+  // and the minimum is the better estimate of the poll's own cost.
+  const uint64_t samples = PollSamples();
+  const double poll_us = samples ? double(PollCostNs()) / double(samples) / 1000.0 : 0.0;
+  const double poll_us_min = g_poll_cost_min == UINT64_MAX ? 0.0 : double(g_poll_cost_min) / 1000.0;
+  double poll_p10 = 0.0, poll_p50 = 0.0, poll_p90 = 0.0;
+  poll_percentiles(&poll_p10, &poll_p50, &poll_p90);
+  const double poll_ms = poll_us * double(dpolls) / 1000.0;
+
+  std::printf(
+      "[PERFCENSUS] t=%.1fs polls=%llu polls_s=%.0f fast=%llu slow=%llu "
+      "instr=%llu instr_s=%.0f polls_per_instr=%.3f poll_us=%.2f poll_us_min=%.2f "
+      "poll_us_p10=%.2f poll_us_p50=%.2f poll_us_p90=%.2f poll_pct=%.1f\n",
+      total_s, (unsigned long long)polls, double(dpolls) / elapsed_s,
+      (unsigned long long)PollsFast(), (unsigned long long)PollsSlow(),
+      (unsigned long long)instr, double(dinstr) / elapsed_s,
+      dinstr ? double(dpolls) / double(dinstr) : 0.0, poll_us, poll_us_min,
+      poll_p10 / 1000.0, poll_p50 / 1000.0, poll_p90 / 1000.0,
+      elapsed_s > 0 ? 100.0 * poll_ms / (elapsed_s * 1000.0) : 0.0);
+  std::fflush(stdout);
+
+  if (pc_histograms) {
+    struct Row {
+      uint32_t pc;
+      uint64_t polls, instr, exec_ns;
+    };
+    std::vector<Row> rows;
+    rows.reserve(64);
+    uint64_t total_exec = 0;
+    for (unsigned i = 0; i < kSlots; ++i) {
+      const uint32_t pc = sites[i].pc.load(std::memory_order_relaxed);
+      if (!pc) continue;
+      Row r{pc,
+            sites[i].polls.load(std::memory_order_relaxed),
+            sites[i].instr.load(std::memory_order_relaxed),
+            sites[i].exec_ns.load(std::memory_order_relaxed)};
+      total_exec += r.exec_ns;
+      rows.push_back(r);
+    }
+    for (size_t i = 1; i < rows.size(); ++i) {
+      Row key = rows[i];
+      size_t j = i;
+      while (j > 0 && rows[j - 1].exec_ns < key.exec_ns) {
+        rows[j] = rows[j - 1];
+        --j;
+      }
+      rows[j] = key;
+    }
+    const size_t shown = rows.size() < 16 ? rows.size() : 16;
+    for (size_t i = 0; i < shown; ++i) {
+      const Row &r = rows[i];
+      std::printf(
+          "[PERFPCS] n=%zu pc=0x%08X polls=%llu instr=%llu exec_ms=%.1f "
+          "share_pct=%.1f\n",
+          i + 1, r.pc, (unsigned long long)r.polls, (unsigned long long)r.instr,
+          double(r.exec_ns) / 1e6,
+          total_exec ? 100.0 * double(r.exec_ns) / double(total_exec) : 0.0);
+    }
+    const uint64_t dropped = overflow.load(std::memory_order_relaxed);
+    if (dropped) std::printf("[PERFPCS] overflow=%llu slots=%u\n",
+                             (unsigned long long)dropped, kSlots);
+    WriteTable();
+  }
+
+  g_report_last_ns = now;
+  g_report_last_polls = polls;
+  g_report_last_instr = instr;
+}
+
+}  // namespace native_perf_census
diff --git a/nWiiRuntime/include/runtime/native_perf_phase.h b/nWiiRuntime/include/runtime/native_perf_phase.h
new file mode 100644
--- /dev/null
+++ b/nWiiRuntime/include/runtime/native_perf_phase.h
@@ -0,0 +1,343 @@
+#pragma once
+// NATIVE_PERF_PHASE_V1
+//
+// Ported from the Crash of the Titans port's frame_trace.h / native_stutter.h
+// family and adapted to this runtime. Game-independent: it names no guest
+// address, reads no guest RAM and prints nothing unless NWII_PERF_PHASE is
+// set.
+//
+// CotT's frame_trace.h is a Chrome-trace event recorder with per-thread
+// buffers, GPU query fences and a Windows thread-time bridge. None of that
+// exists here, and none of it is needed to answer the questions this port
+// actually asks: how long a frame takes, which part of the frame costs what,
+// and how much of the frame is spent waiting instead of working.
+//
+// This header keeps the part that transfers: a set of named phase scopes
+// around the host's render work, a per-frame record of how long each phase
+// took, and a periodic report.
+//
+// The frame is one iteration of the host render loop. That loop is field-paced
+// (see NATIVE_FIELD_PACING_V1), so the frame period is the display field
+// period and the interesting number is how much of it the host actually
+// spends working.
+//
+// Env:
+//   NWII_PERF_PHASE=1        enable the phase timers
+//   NWII_PERF_PHASE_FILE     append the per-frame timeline as CSV
+//   NWII_PERF_PHASE_PERIOD   seconds between [PERFPHASE] reports (default 5)
+//
+// Output:
+//   [PERFPHASE] t=12.0s window=5.0s frames=300 frame_ms=16.63 p95=17.20
+//               max=25.40 gx_parse=0.42 gx_decode=1.20 gl_render=8.90
+//               xfb_copy=0.55 present=0.20 swap=0.10 host_field=0.90
+//               host_drain_wait=0.85 guest_idle=0.00 host_sum=11.37
+//               budget=16.67 busy=68.2% guest_cpu_ms_s=900.0
+//
+// All the phase numbers are milliseconds per frame over the report window.
+//
+// Caveats, which the report repeats:
+//   * the frame phases are host-thread CPU time; the guest thread runs
+//     concurrently and its execution time is not part of any frame phase, so
+//     "host_sum" is the host's work and "frame_ms - host_sum" is the host's
+//     own overhead plus whatever the guest thread did during the frame;
+//   * guest_idle is the time the guest spent parked on its waitable timer;
+//     it is a stall measure, not a frame phase, and is reported separately;
+//   * the phase timers are wall clock, so a preempted host thread inflates
+//     the phase it was in.
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace native_perf_phase {
+
+enum Phase : unsigned {
+  Phase_GxParse = 0,
+  Phase_GxDecode,
+  Phase_GlRender,
+  Phase_XfbCopy,
+  Phase_Present,
+  Phase_Swap,
+  Phase_HostField,
+  Phase_HostDrainWait,
+  Phase_GuestIdle,
+  Phase_Count
+};
+
+inline const char *phase_name(unsigned phase) {
+  static const char *const names[Phase_Count] = {
+      "gx_parse",  "gx_decode", "gl_render", "xfb_copy", "present",
+      "swap",      "host_field", "host_drain_wait", "guest_idle"};
+  return phase < Phase_Count ? names[phase] : "unknown";
+}
+
+inline const bool enabled = std::getenv("NWII_PERF_PHASE") != nullptr;
+
+inline uint64_t now_ns() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count());
+}
+
+// One counter per cache line. The host thread writes most of them and the
+// guest thread writes guest_idle; on one shared line the two threads would
+// bounce it on every update.
+struct alignas(64) PhaseCounter {
+  std::atomic<uint64_t> ns{0};
+  std::atomic<uint64_t> hits{0};
+  char pad[64 - 2 * sizeof(std::atomic<uint64_t>)];
+};
+
+inline PhaseCounter counters[Phase_Count];
+
+__attribute__((always_inline)) inline void Add(Phase phase, uint64_t ns) {
+  counters[phase].ns.store(
+      counters[phase].ns.load(std::memory_order_relaxed) + ns,
+      std::memory_order_relaxed);
+  counters[phase].hits.store(
+      counters[phase].hits.load(std::memory_order_relaxed) + 1,
+      std::memory_order_relaxed);
+}
+inline uint64_t Total(Phase phase) {
+  return counters[phase].ns.load(std::memory_order_relaxed);
+}
+inline uint64_t Hits(Phase phase) {
+  return counters[phase].hits.load(std::memory_order_relaxed);
+}
+
+// A phase scope. Costs one clock read when the phase is enabled and none
+// when it is not. stop() ends the phase early; the destructor stops it too.
+struct Scope {
+  Phase phase;
+  uint64_t t0;
+  bool active;
+  explicit Scope(Phase p) : phase(p), t0(0), active(false) {
+    if (enabled) {
+      t0 = now_ns();
+      active = true;
+    }
+  }
+  Scope(const Scope &) = delete;
+  Scope &operator=(const Scope &) = delete;
+  void stop() {
+    if (!active) return;
+    Add(phase, now_ns() - t0);
+    active = false;
+  }
+  ~Scope() { stop(); }
+};
+
+// ---------------------------------------------------------------------------
+// Per-frame timeline.
+// ---------------------------------------------------------------------------
+constexpr unsigned kFrameRing = 8192;
+
+struct FrameRecord {
+  uint64_t wall_ns;
+  uint64_t phase_ns[Phase_Count];
+};
+
+inline FrameRecord ring[kFrameRing];
+inline uint64_t frame_index = 0;      // frames recorded so far
+inline uint64_t frame_start_ns = 0;
+inline uint64_t frame_snapshot[Phase_Count];
+inline uint64_t run_wall_ns = 0;
+inline uint64_t run_phase_ns[Phase_Count];
+inline uint64_t run_max_wall_ns = 0;
+
+inline void frame_begin() {
+  if (!enabled) return;
+  frame_start_ns = now_ns();
+  for (unsigned i = 0; i < Phase_Count; ++i)
+    frame_snapshot[i] = counters[i].ns.load(std::memory_order_relaxed);
+}
+
+inline void frame_end() {
+  if (!enabled) return;
+  const uint64_t t = now_ns();
+  FrameRecord &r = ring[frame_index % kFrameRing];
+  r.wall_ns = t - frame_start_ns;
+  for (unsigned i = 0; i < Phase_Count; ++i) {
+    const uint64_t now = counters[i].ns.load(std::memory_order_relaxed);
+    r.phase_ns[i] = now >= frame_snapshot[i] ? now - frame_snapshot[i] : 0;
+    run_phase_ns[i] += r.phase_ns[i];
+  }
+  run_wall_ns += r.wall_ns;
+  if (r.wall_ns > run_max_wall_ns) run_max_wall_ns = r.wall_ns;
+  ++frame_index;
+}
+
+// ---------------------------------------------------------------------------
+// Guest thread CPU time (Windows thread accounting). The guest thread is the
+// one that runs the recompiled code; its CPU time is the port's headline
+// cost, and it is not visible in any host-side phase.
+// ---------------------------------------------------------------------------
+inline std::atomic<uint32_t> g_guest_tid{0};
+
+// Call this from the thread that runs the recompiled guest code.
+inline void set_guest_thread() {
+#ifdef _WIN32
+  g_guest_tid.store(GetCurrentThreadId(), std::memory_order_relaxed);
+#endif
+}
+
+inline uint64_t guest_cpu_us() {
+#ifdef _WIN32
+  const uint32_t tid = g_guest_tid.load(std::memory_order_relaxed);
+  if (!tid) return 0;
+  HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid);
+  if (!h) return 0;
+  FILETIME c, e, k, u;
+  uint64_t us = 0;
+  if (GetThreadTimes(h, &c, &e, &k, &u)) {
+    const auto ticks = [](FILETIME f) {
+      return (uint64_t(f.dwHighDateTime) << 32) | uint64_t(f.dwLowDateTime);
+    };
+    us = (ticks(k) + ticks(u)) / 10;
+  }
+  CloseHandle(h);
+  return us;
+#else
+  return 0;
+#endif
+}
+
+// ---------------------------------------------------------------------------
+// Reporting.
+// ---------------------------------------------------------------------------
+inline double report_period_s() {
+  static const double seconds = [] {
+    const char *e = std::getenv("NWII_PERF_PHASE_PERIOD");
+    const double v = e ? std::strtod(e, nullptr) : 5.0;
+    return v > 0.05 ? v : 5.0;
+  }();
+  return seconds;
+}
+
+inline const char *phase_file() {
+  static const char *path = std::getenv("NWII_PERF_PHASE_FILE");
+  return path;
+}
+
+inline uint64_t g_report_last_ns = 0;
+inline uint64_t g_report_start_ns = 0;
+inline uint64_t g_report_last_frames = 0;
+inline uint64_t g_report_last_guest_cpu_us = 0;
+inline std::FILE *g_csv = nullptr;
+
+inline void csv_header() {
+  if (!phase_file() || !*phase_file()) return;
+  if (g_csv) return;
+  g_csv = std::fopen(phase_file(), "wb");
+  if (!g_csv) return;
+  std::fprintf(g_csv, "frame,wall_ms");
+  for (unsigned i = 0; i < Phase_Count; ++i)
+    std::fprintf(g_csv, ",%s_ms", phase_name(i));
+  std::fprintf(g_csv, "\n");
+  std::fflush(g_csv);
+}
+
+inline void flush_frames(uint64_t first, uint64_t last) {
+  csv_header();
+  if (!g_csv) return;
+  // The ring holds kFrameRing frames; anything older has been overwritten.
+  if (last - first > kFrameRing) {
+    first = last - kFrameRing;
+    std::fprintf(g_csv, "# %llu frame(s) dropped, the ring holds %u\n",
+                 (unsigned long long)(last - first), kFrameRing);
+  }
+  for (uint64_t i = first; i < last; ++i) {
+    const FrameRecord &r = ring[i % kFrameRing];
+    std::fprintf(g_csv, "%llu,%.3f", (unsigned long long)i,
+                 double(r.wall_ns) / 1e6);
+    for (unsigned p = 0; p < Phase_Count; ++p)
+      std::fprintf(g_csv, ",%.3f", double(r.phase_ns[p]) / 1e6);
+    std::fprintf(g_csv, "\n");
+  }
+  std::fflush(g_csv);
+}
+
+inline void maybe_report() {
+  if (!enabled) return;
+  const uint64_t now = now_ns();
+  if (!g_report_last_ns) {
+    g_report_last_ns = now;
+    g_report_start_ns = now;
+    g_report_last_guest_cpu_us = guest_cpu_us();
+    return;
+  }
+  const double elapsed_s = double(now - g_report_last_ns) / 1e9;
+  if (elapsed_s < report_period_s()) return;
+  const double total_s = double(now - g_report_start_ns) / 1e9;
+
+  const uint64_t first = g_report_last_frames;
+  const uint64_t last = frame_index;
+  const uint64_t frames = last > first ? last - first : 0;
+
+  std::vector<uint64_t> walls;
+  walls.reserve(frames < 4096 ? size_t(frames) : 4096);
+  for (uint64_t i = (last > kFrameRing ? last - kFrameRing : 0); i < last; ++i)
+    walls.push_back(ring[i % kFrameRing].wall_ns);
+  std::sort(walls.begin(), walls.end());
+  const auto pct = [&walls](double p) -> double {
+    if (walls.empty()) return 0.0;
+    size_t i = size_t((double(walls.size()) * p + 0.999999) - 1.0);
+    if (i >= walls.size()) i = walls.size() - 1;
+    return double(walls[i]) / 1e6;
+  };
+
+  double mean_wall_ms = 0.0, max_wall_ms = 0.0;
+  for (uint64_t i = first; i < last; ++i) {
+    const uint64_t w = ring[i % kFrameRing].wall_ns;
+    mean_wall_ms += double(w) / 1e6;
+    if (double(w) / 1e6 > max_wall_ms) max_wall_ms = double(w) / 1e6;
+  }
+  if (frames) mean_wall_ms /= double(frames);
+
+  double phase_ms[Phase_Count];
+  double host_sum_ms = 0.0;
+  for (unsigned p = 0; p < Phase_Count; ++p) {
+    uint64_t sum = 0;
+    for (uint64_t i = first; i < last; ++i)
+      sum += ring[i % kFrameRing].phase_ns[p];
+    phase_ms[p] = frames ? double(sum) / 1e6 / double(frames) : 0.0;
+  }
+  // The frame phases are the host's render work; the field wait and the
+  // guest's idle park are stalls and are reported, not summed into the frame.
+  host_sum_ms = phase_ms[Phase_GxParse] + phase_ms[Phase_GxDecode] +
+                phase_ms[Phase_GlRender] + phase_ms[Phase_XfbCopy] +
+                phase_ms[Phase_Present] + phase_ms[Phase_Swap];
+
+  const uint64_t guest_cpu_us_now = guest_cpu_us();
+  const double guest_cpu_ms_s =
+      elapsed_s > 0 ? double(guest_cpu_us_now - g_report_last_guest_cpu_us) / 1000.0 / elapsed_s : 0.0;
+
+  std::printf("[PERFPHASE] t=%.1fs window=%.1fs frames=%llu frame_ms=%.3f p95=%.3f max=%.3f",
+              total_s, elapsed_s, (unsigned long long)frames, mean_wall_ms,
+              pct(0.95), max_wall_ms);
+  for (unsigned p = 0; p < Phase_Count; ++p)
+    std::printf(" %s=%.3f", phase_name(p), phase_ms[p]);
+  std::printf(" host_sum=%.3f guest_cpu_ms_s=%.1f\n", host_sum_ms, guest_cpu_ms_s);
+  std::fflush(stdout);
+
+  flush_frames(first, last);
+
+  g_report_last_ns = now;
+  g_report_last_frames = last;
+  g_report_last_guest_cpu_us = guest_cpu_us_now;
+}
+
+}  // namespace native_perf_phase
diff --git a/nWiiRuntime/include/runtime/native_persistent_upload_mom.h b/nWiiRuntime/include/runtime/native_persistent_upload_mom.h
