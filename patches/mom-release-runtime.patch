+ }
+ void flush(){std::unique_lock<std::mutex> lock(mutex);idle.wait(lock,[&]{return jobs.empty() && !busy;});}
+ ~Writer(){ {std::lock_guard<std::mutex> lock(mutex);stopping=true;}wake.notify_one();if(thread.joinable())thread.join();}
+};
+}
