+bool NativeIndMtxUniforms(); // NATIVE_MOM_SHADER_KEY_UNIFORM_DATA_V1 (tev_shader_gen.cpp)
+static uint64_t NativeTevShaderHashUncached(const GXState &state, uint8_t primitive) {
+  uint64_t hash = state.GetShaderHash(primitive);
+  for(unsigned t=0;t<8;++t)
+    hash=(hash ^ ((state.xf[0x40+t]>>4)&7))*1099511628211ull;
+  if (NativeShaderDataUniformsEnabled()) { // NATIVE_MOM_SHADER_KEY_UNIFORM_DATA_V1: the generated text reads only the fog type and projection bit
+    hash=(hash ^ ((state.bp[0xf1]>>20)&15))*1099511628211ull;
+  } else
+  for(unsigned reg=0xee;reg<=0xf2;++reg)
+    for(unsigned shift=0;shift<32;shift+=8)
+      hash=(hash ^ ((state.bp[reg]>>shift)&255))*1099511628211ull;
+  // NATIVE_MOM_SHADER_LANE_V1: the blanket 0x06..0x27 range also covered bp[0x0F]
+  // (IND_IMASK, which this runtime never decodes) and bp[0x20..0x24] (raster
+  // line/point sizes; 0x22 is read by NativeEmitLinesPoints).  The generator
+  // reads the indirect matrices (0x06..0x0E), the per-TEV-stage indirect
+  // configs (0x10..0x1F) and the indirect scale/command words (0x25..0x27).
+  if (GXState::PruneShaderKey()) {
+    if (!NativeIndMtxUniforms()) // NATIVE_MOM_SHADER_KEY_UNIFORM_DATA_V1: the indirect matrices are uNativeIndMtx, not code
+    for(unsigned reg=0x06;reg<=0x0E;++reg)
+      for(unsigned shift=0;shift<32;shift+=8)
+        hash=(hash ^ ((state.bp[reg]>>shift)&255))*1099511628211ull;
+    for(unsigned reg=0x10;reg<=0x1F;++reg)
+      for(unsigned shift=0;shift<32;shift+=8)
+        hash=(hash ^ ((state.bp[reg]>>shift)&255))*1099511628211ull;
+    for(unsigned reg=0x25;reg<=0x27;++reg)
+      for(unsigned shift=0;shift<32;shift+=8)
+        hash=(hash ^ ((state.bp[reg]>>shift)&255))*1099511628211ull;
+  } else {
+    for(unsigned reg=6;reg<=0x27;++reg)
+      for(unsigned shift=0;shift<32;shift+=8)
+        hash=(hash ^ ((state.bp[reg]>>shift)&255))*1099511628211ull;
+  }
+  for (unsigned reg = 0xf6; reg <= 0xfd; ++reg)
+    for (unsigned shift = 0; shift < 32; shift += 8)
+      hash = (hash ^ ((state.bp[reg] >> shift) & 0xff)) * 1099511628211ull;
+  return hash;
+}
+
+static uint64_t NativeTevShaderHash(const GXState &state, uint8_t primitive) {
+  static const bool memo = std::getenv("NWII_NO_SHADER_KEY_MEMO") == nullptr;
+  if (!memo) return NativeTevShaderHashUncached(state, primitive);
+  // NWII_SHADER_LANE_STATS=1 prints one line at exit, so a run can show that
+  // the memo is hit rather than merely present.
+  struct Stats {
+    uint64_t hits = 0, misses = 0;
+    ~Stats() {
+      if (std::getenv("NWII_SHADER_LANE_STATS") == nullptr) return;
+      std::printf("[SHKEYMEMO] hits=%llu misses=%llu\n",
+                  (unsigned long long)hits, (unsigned long long)misses);
+    }
+  };
+  static Stats stats;
+  static uint32_t previous[kNativeShaderKeyWords];
+  static uint64_t cached = 0;
+  static bool have = false;
+  uint32_t words[kNativeShaderKeyWords];
+  const unsigned n = NativeShaderKeyGather(state, primitive, words);
+  // A gather that no longer fills the array disables the memo instead of
+  // comparing a prefix: the answer stays exact under any future edit here.
+  if (n != kNativeShaderKeyWords) return NativeTevShaderHashUncached(state, primitive);
+  if (have && std::memcmp(previous, words, sizeof words) == 0) {
+    ++stats.hits;
+    return cached;
+  }
+  ++stats.misses;
+  std::memcpy(previous, words, sizeof words);
+  have = true;
+  return cached = NativeTevShaderHashUncached(state, primitive);
+} // NATIVE_MOM_SHADER_LANE_V1
+
+// NATIVE_COARSE_SHADER_KEY_V1: one line per compiled program with a fingerprint per register
+// group of the shader key.  Off by default; NWII_SHKEY_TRACE=1 turns it on.
+// It is how the remaining key churn was attributed to a group.
+static void NativeShaderKeyFingerprint(const GXState &state) {
+  static const bool on = std::getenv("NWII_SHKEY_TRACE") != nullptr;
+  if (!on) return;
+  const uint64_t seed = 14695981039346656037ull;
+  auto fold = [](uint64_t h, uint32_t w) {
+      h = (h ^ (w & 0xFF)) * 1099511628211ull;
+      h = (h ^ ((w >> 8) & 0xFF)) * 1099511628211ull;
+      h = (h ^ ((w >> 16) & 0xFF)) * 1099511628211ull;
+      h = (h ^ ((w >> 24) & 0xFF)) * 1099511628211ull;
+      return h;
+  };
+  auto range = [&](unsigned lo, unsigned hi) {
+      uint64_t h = seed;
+      for (unsigned r = lo; r <= hi; ++r) h = fold(h, state.bp[r]);
+      return h;
+  };
+  uint64_t gen = fold(seed, state.bp[0x00]);
+  uint64_t zb = range(0x40, 0x43);
+  uint64_t at = fold(seed, state.bp[0xF3]);
+  uint64_t tev = range(0xC0, 0xDF);
+  uint64_t map = range(0x28, 0x2F);
+  uint64_t ind = range(0x06, 0x27);
+  uint64_t fog = range(0xEE, 0xF2);
+  uint64_t ksel = range(0xF6, 0xFD);
+  uint64_t vtx = seed;
+  vtx = fold(vtx, state.cp[0x50]);
+  vtx = fold(vtx, state.cp[0x60]);
+  vtx = fold(vtx, state.xf[0x3F]);
+  for (unsigned t = 0; t < 8; ++t) vtx = fold(vtx, state.xf[0x40 + t]);
+  uint64_t fmt = seed;
+  for (unsigned t = 0; t < 8; ++t) {
+      fmt = fold(fmt, state.texStages[t].format);
+      fmt = fold(fmt, state.texStages[t].tlut_format);
+  }
+  printf("[SHKEY] gen=%08llx zb=%08llx at=%08llx tev=%08llx map=%08llx "
+         "ind=%08llx fog=%08llx ksel=%08llx vtx=%08llx fmt=%08llx\n",
+         (unsigned long long)gen, (unsigned long long)zb,
+         (unsigned long long)at, (unsigned long long)tev,
+         (unsigned long long)map, (unsigned long long)ind,
+         (unsigned long long)fog, (unsigned long long)ksel,
+         (unsigned long long)vtx, (unsigned long long)fmt);
+}
