diff --git a/nWiiRuntime/src/hw/hw_exi.cpp b/nWiiRuntime/src/hw/hw_exi.cpp
new file mode 100644
index 0000000..1752a61
--- /dev/null
+++ b/nWiiRuntime/src/hw/hw_exi.cpp
@@ -0,0 +1,102 @@
+// Native EXI (Expansion Interface) register model.
+//
+// Crash: Mind over Mutant addresses EXI through the uncached 0x0D00xxxx alias;
+// logs/boot-before-stbux.log records 0x0D006800 (STATUS), 0x0D006804 (DMA
+// address), 0x0D006808 (DMA length), 0x0D00680C (DMA control) and 0x0D006810
+// (IMM data) for channel 0, 0x0D006814/0x0D006820 for channel 1 and
+// 0x0D006828/0x0D006834 for channel 2 as "[MMIO] Unhandled". The runtime only
+// registered no EXI range at all, and hw_all.cpp's "exi carried nothing" note
+// was measured on a 2006 game (Mario Party 7).
+//
+// Each channel spans 0x14 bytes (Dolphin CEXIChannel):
+//   +0x00 EXI_STATUS  +0x04 EXI_DMA_ADDRESS  +0x08 EXI_DMA_LENGTH
+//   +0x0C EXI_DMA_CONTROL  +0x10 EXI_IMM_DATA
+//
+// With no expansion device fitted, EXT (bit 12) reads 0, and
+// EXIINT/TCINT/EXTINT are never latched. A DMA/immediate transfer is modelled
+// as completing immediately: TSTART is write-one-to-start and reads back 0.
+// No PI line is driven from here -- the runtime has no EXI device behind these
+// registers, so asserting an interrupt would be inventing one. Reads report
+// the idle / no-device state and writes are recorded instead of dropped.
+#include "runtime/hw/hw.h"
+#include <cstdint>
+
+namespace nwii::runtime::hw {
+
+namespace {
+constexpr uint32_t kExiChannels = 3;
+constexpr uint32_t kExiChannelSize = 0x14;
+constexpr uint32_t kExiRegsPerChannel = kExiChannelSize / 4; // STATUS..IMM_DATA
+constexpr uint32_t kExiInvalid = 0xFFFFFFFFu;
+
+// EXI_STATUS bit fields (Dolphin UEXI_STATUS).
+constexpr uint32_t kStatusExiIntMask = 0x00000001u;
+constexpr uint32_t kStatusTcIntMask = 0x00000004u;
+constexpr uint32_t kStatusClk = 0x00000070u;
+constexpr uint32_t kStatusChipSelect = 0x00000380u;
+constexpr uint32_t kStatusExtIntMask = 0x00000400u;
+constexpr uint32_t kStatusExt = 0x00001000u; // read-only: external device present
+constexpr uint32_t kStatusRomDis = 0x00002000u;
+
+constexpr uint32_t kControlTStart = 0x00000001u;
+
+static uint32_t exi_reg[kExiChannels * kExiRegsPerChannel] = {};
+
+// off is the byte offset within the 0x6800 window (0x00..0xFF).
+uint32_t exi_index(uint32_t off) {
+  uint32_t channel = off / kExiChannelSize;
+  uint32_t reg = (off % kExiChannelSize) / 4;
+  if (channel >= kExiChannels || reg >= kExiRegsPerChannel)
+    return kExiInvalid;
+  return channel * kExiRegsPerChannel + reg;
+}
+} // namespace
+
+void register_exi(MMIODispatcher &dispatcher) {
+  auto read = [](uint32_t addr) -> uint32_t {
+    uint32_t off = (addr & 0xFF) & ~3u;
+    uint32_t index = exi_index(off);
+    if (index == kExiInvalid)
+      return 0;
+    if (off % kExiChannelSize == 0)
+      return exi_reg[index] & ~kStatusExt; // EXT: no external device present
+    return exi_reg[index];
+  };
+  auto write = [](uint32_t addr, uint32_t value) {
+    uint32_t off = (addr & 0xFF) & ~3u;
+    uint32_t index = exi_index(off);
+    if (index == kExiInvalid)
+      return;
+    uint32_t channel = off / kExiChannelSize;
+    uint32_t reg = (off % kExiChannelSize) / 4;
+    switch (reg) {
+      case 0: { // EXI_STATUS
+        // Writable: interrupt masks, CLK, CHIP_SELECT, and per-channel
+        // EXTINTMASK (channels 0/1) / ROMDIS (channel 0). EXIINT, TCINT and
+        // EXTINT are write-one-to-clear and are never set here; EXT is
+        // read-only and always 0 (no device).
+        uint32_t status = value & (kStatusExiIntMask | kStatusTcIntMask |
+                                   kStatusClk | kStatusChipSelect);
+        if (channel < 2)
+          status |= value & kStatusExtIntMask;
+        if (channel == 0)
+          status |= value & kStatusRomDis;
+        exi_reg[index] = status;
+        break;
+      }
+      case 3: // EXI_DMA_CONTROL: TSTART self-clears, transfer completes.
+        exi_reg[index] = value & ~kControlTStart;
+        break;
+      default: // DMA address / length / IMM data are plain storage.
+        exi_reg[index] = value;
+        break;
+    }
+  };
+  // EXI_MIRROR_V1: the register file is visible through the cached and uncached
+  // aliases of both the 0xCC00xxxx and 0xCD00xxxx windows; the same four-base
+  // loop hw_ai.cpp uses.
+  for (uint32_t base : {0xCC000000u, 0xCD000000u, 0x0C000000u, 0x0D000000u})
+    dispatcher.register_region(base + 0x6800, base + 0x68FF, read, write);
+}
+
+} // namespace nwii::runtime::hw
diff --git a/nWiiRuntime/src/hw/hw_si.cpp b/nWiiRuntime/src/hw/hw_si.cpp
new file mode 100644
index 0000000..5291df1
--- /dev/null
+++ b/nWiiRuntime/src/hw/hw_si.cpp
@@ -0,0 +1,68 @@
+// Native SI (Serial Interface) register model.
+//
+// Crash: Mind over Mutant addresses SI through the uncached 0x0D00xxxx alias;
+// logs/boot-before-stbux.log records 0x0D006430 (SI_POLL), 0x0D006434
+// (SI_COM_CSR), 0x0D006438 (SI_STATUS) and 0x0D006480 (SI_IO_BUFFER) as
+// "[MMIO] Unhandled", all read back as 0. The runtime only registered the
+// 0xCC00xxxx base, and hw_all.cpp's "si carried nothing" note was measured on
+// a 2006 game (Mario Party 7) that never touched these registers.
+//
+// Offsets follow the hardware block (Dolphin SerialInterface):
+//   0x00..0x2F  four channels of OUT / IN_HI / IN_LO at 0x0C stride
+//   0x30        SI_POLL
+//   0x34        SI_COM_CSR
+//   0x38        SI_STATUS
+//   0x3C        SI_EXI_CLOCK_COUNT
+//   0x80..0xFF  128-byte SI I/O buffer
+//
+// No controller/memory-card device is attached, so a transfer is modelled as
+// completing immediately: TSTART is write-one-to-start and reads back 0.
+// TCINT / RDSTINT are write-one-to-clear storage and are never latched, and no
+// PI line is driven from here -- the runtime has no backing SI device, so
+// asserting an interrupt would be inventing one. Reads therefore report the
+// idle / no-device state, and writes are recorded instead of dropped.
+#include "runtime/hw/hw.h"
+#include <cstdint>
+
+namespace nwii::runtime::hw {
+
+// One word per register covers the whole 0x100 window including the buffer.
+static uint32_t si_reg[0x100 / 4] = {};
+
+void register_si(MMIODispatcher &dispatcher) {
+  auto read = [](uint32_t addr) -> uint32_t {
+    uint32_t off = (addr & 0xFF) & ~3u;
+    switch (off) {
+      case 0x34: // SI_COM_CSR: TSTART is write-only; reads see transfer complete.
+        return si_reg[off / 4] & ~1u;
+      default:
+        return si_reg[off / 4];
+    }
+  };
+  auto write = [](uint32_t addr, uint32_t value) {
+    uint32_t off = (addr & 0xFF) & ~3u;
+    switch (off) {
+      case 0x34: // SI_COM_CSR: TSTART self-clears; TCINT/RDSTINT are W1C.
+        si_reg[off / 4] = value & ~1u;
+        break;
+      case 0x38: { // SI_STATUS: UNRUN/OVRUN/COLL/NOREP are W1C, WR self-clears.
+        uint32_t status = si_reg[off / 4];
+        status &= ~(value & 0x0F0F0F0Fu);
+        status &= ~0x80000000u;
+        si_reg[off / 4] = status;
+        break;
+      }
+      default:
+        si_reg[off / 4] = value;
+        break;
+    }
+  };
+  // SI_MIRROR_V1: the register file is visible through the cached and uncached
+  // aliases of both the 0xCC00xxxx and 0xCD00xxxx windows; the same four-base
+  // loop hw_ai.cpp uses. (Through the MMU the 0x0C/0xCD aliases normalise to
+  // 0xCC/0x0D, but registering all four keeps this independent of that path.)
+  for (uint32_t base : {0xCC000000u, 0xCD000000u, 0x0C000000u, 0x0D000000u})
+    dispatcher.register_region(base + 0x6400, base + 0x64FF, read, write);
+}
+
+} // namespace nwii::runtime::hw
